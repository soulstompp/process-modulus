# Every filed elimination, read at the corners of the quantity it was counted in. One row per
# (composition, composed layer, quantity) that files one: its three values, whether the sum it
# comes off would turn over when taken bound by bound, and so which end of it is in play where that
# quantity is at its low and where it is at its high.
#
# The sum decides which corner an elimination takes
#   An elimination removes part of the figure it is taken from, so it is subtracted bound by bound:
#   at the sum's low, the overlap is at its own low. Where the sum of the converted parts is
#   narrower than the elimination, that subtraction leaves the low above the high, and the only
#   reading in order pairs the most overlap with the least total. `crossed` records which reading
#   holds, from the parts' converted figures and the elimination alone. `at_low` is the elimination
#   where its quantity is at its low, `at_high` where it is at its high.
#
# One test, read by every relation that needs it
#   composition/fused.sqlc takes its sum this way, composition/fused_remainders.sqlc reads the same
#   corners into the composed remainder, and composition/carried_eliminations.sqlc carries them up
#   from the layers a remainder walk passes. Each reads it here, so the three can never pair one
#   elimination two ways.
#
# A typed blank stays a row
#   An elimination filed as `unmeasured` keeps its row with no figure, `crossed` false and both
#   corners NULL; the suspension grounds, not this relation, decide what it lifts.
-- eliminations/filed.sqlc against folds/part_sums.sqlc.
SELECT x.composition, x.composed_layer, x.quantity,
       x.low, x.mode, x.high, x.unit, x.absent, x.derivation, x.reason, x.claim_seq, x.crossed,
       CASE WHEN x.crossed THEN x.high ELSE x.low  END AS at_low,
       CASE WHEN x.crossed THEN x.low  ELSE x.high END AS at_high
FROM (
    SELECT e.composition, e.composed_layer, e.quantity,
           e.low, e.mode, e.high, e.unit, e.absent, e.derivation, e.reason, e.claim_seq,
           coalesce(NOT (s.sum_low  - e.low  <= s.sum_mode - e.mode
                     AND s.sum_mode - e.mode <= s.sum_high - e.high), false) AS crossed
    FROM      (
        :compose(eliminations/filed.sqlc)
    ) e
    LEFT JOIN (
        :compose(folds/part_sums.sqlc)
    ) s ON s.composition = e.composition AND s.composed_layer = e.composed_layer
       AND s.quantity = e.quantity
) x
