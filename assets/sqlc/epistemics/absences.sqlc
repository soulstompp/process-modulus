# EVERY PLACE A DOCUMENT DECLINED TO ANSWER, AND WHY. One row per typed absence anywhere in
# the corpus: the filing, what the absence is about, which question went unanswered, and
# which of the four reasons was given.
#
# ⭐⭐⭐ THIS IS THE RELATION THE WHOLE MODEL IS FOR, AND IT IS UNASKABLE IN ANY OTHER FORM.
#    Scattered across fifteen elements, a typed absence looks like a nullable field with a
#    note attached. Gathered into one relation it becomes a map of what this corpus does not
#    know, readable in one pass -- and the four reasons are four DIFFERENT facts that a
#    NULL would have flattened into one:
#      `none`          -- somebody looked and the answer is nothing.
#      `unmeasured`    -- nobody looked. NOT the same as nothing.
#      `notApplicable` -- the question is malformed here; there is nothing to look for.
#      `derived`       -- the answer is stated elsewhere and would be a restatement here.
#
# ⭐⭐ RUN THIS ALONE AND GROUP BY `reason` FOR THE HONEST SHAPE OF THE EVIDENCE. Group by
#    `question` instead and you get the questions this corpus systematically does not
#    answer, which is where the next instrument is worth building.
#
# ⛔ AN ABSENCE IS A CLAIM AND CARRIES ITS OWN WEIGHT. `unmeasured` on a capacity slack
#   suspends an inequality; `unmeasured` on an elimination search suspends a sum rule. Rows
#   here are not missing data -- they are the data, and several rules read nothing else.
#
# ⭐⭐⭐ THE LABEL IS ADDED AT THE UNION SITE, WHICH IS WHAT LETS THE MEMBERS STAY IGNORANT OF
#    EACH OTHER. Each arm composes a relation that knows nothing about absences and augments it
#    here: `SELECT filing, <how to address it>, '<the question>', <the reason column>`. The
#    member does not carry the question, does not carry its own name, and does not need to spell
#    its key the way its neighbours do -- `eliminations/filed.sqlc` says `composition` where
#    `entries/slacks.sqlc` says `filing`, and the union reconciles them. Thirteen arms compose;
#    they used to read their base tables directly.
#
# ⛔⛔ FIVE ARMS STILL READ `pm.*` RAW, AND THAT IS CORRECT RATHER THAN UNFINISHED. `demand`,
#    `demand narrowsWhen`, `nameplate amount`, `divisibility` and `draw` want the rows their
#    wrapper filters away: layers/demand.sqlc keeps `demand_low IS NOT NULL`, and a demand
#    absence is exactly the complement -- mutually exclusive by CHECK constraint, zero rows in
#    both directions. The wrapper is the POSITIVE side; this relation wants the negative one.
#    Composing them would return nothing. Naming those complements is a separate decision.
-- every pm:Absent/@reason in the schema, from every element that admits one.
SELECT filing, subject, question, reason FROM (
    SELECT filing, layer AS subject, 'demand'              AS question, demand_absent         AS reason FROM pm.layer
    UNION ALL SELECT filing, layer, 'demand narrowsWhen',  demand_narrows_absent FROM pm.layer
    UNION ALL SELECT filing, layer, 'remainder sign',      sign_absent           FROM (
        :compose(layers/filed_remainders.sqlc)
    ) fr
    UNION ALL SELECT filing, layer, 'remainder quantity',  qty_absent            FROM (
        :compose(layers/filed_remainders.sqlc)
    ) fr
    UNION ALL SELECT filing, layer, 'nameplate amount',    amount_absent         FROM pm.nameplate
    UNION ALL SELECT filing, layer, 'divisibility',        divisibility_absent   FROM pm.nameplate
    UNION ALL SELECT filing, layer, 'duty-cycle window',   window_absent         FROM (
        :compose(layers/windows.sqlc)
    ) w
    UNION ALL SELECT filing, layer, 'draw',                draw_absent           FROM pm.nameplate
    UNION ALL SELECT filing, layer || ' / ' || buffer::text, 'buffer slack',      absent    FROM (
        :compose(entries/slacks.sqlc)
    ) s
    UNION ALL SELECT filing, layer || ' / ' || buffer::text, 'who owns the bound', bound_origin_absent FROM (
        :compose(entries/slacks.sqlc)
    ) s
    UNION ALL SELECT filing, layer || ' / ' || kind::text,   'holder share',      share_absent FROM (
        :compose(entries/holders.sqlc)
    ) h
    UNION ALL SELECT filing, operation || ' / ' || layer, 'operation draw',       absent    FROM (
        :compose(entries/draws.sqlc)
    ) d
    UNION ALL SELECT filing, operation || ' / ' || layer, 'operation induction',  absent    FROM (
        :compose(entries/inductions.sqlc)
    ) i
    UNION ALL SELECT filing, owns || ' claim ' || seq::text, 'narrowsWhen',      narrows_absent FROM (
        :compose(epistemics/claims.sqlc)
    ) c
    UNION ALL SELECT filing, owns || ' claim ' || seq::text, 'boundOrigin',      origin_absent  FROM (
        :compose(epistemics/claims.sqlc)
    ) c
    UNION ALL SELECT filing, '(the stack)',   'how much of the system',           absent    FROM (
        :compose(epistemics/scopes.sqlc)
    ) sc
    UNION ALL SELECT filing, '(the stack)',   'did anybody look for couplings',   answer    FROM (
        :compose(epistemics/coupling_searches.sqlc)
    ) cs
    UNION ALL SELECT filing, '(the document)', 'its own notation',                absent    FROM (
        :compose(composition/notations.sqlc)
    ) n
    UNION ALL SELECT composition, composed_layer, 'did anybody look for double counting', answer FROM (
        :compose(eliminations/searched.sqlc)
    ) es
    UNION ALL SELECT composition, composed_layer || ' / ' || quantity, 'eliminated quantity', absent FROM (
        :compose(eliminations/filed.sqlc)
    ) e
) a
WHERE reason IS NOT NULL
