# Every place a document declined to answer, and why. One row per typed absence anywhere in the
# corpus: the filing, what the absence is about, which question went unanswered, and which of the
# three reasons was given.
#
# The relation the whole model is for
#   It is unaskable in any other form. Scattered across the schema's elements, a typed absence
#   looks like a nullable field with a note attached. Gathered into one relation it becomes a map
#   of what this corpus does not know, readable in one pass, and the three reasons are three
#   different facts that a NULL would have flattened into one:
#     `none`           somebody looked and the answer is nothing.
#     `unmeasured`     nobody looked. Not the same as nothing.
#     `notApplicable`  the question is malformed here; there is nothing to look for.
#   A position computed from other elements is not here: it names its identity, and
#   epistemics/derivations.sqlc counts it.
#
# Reading it
#   Run this alone and group by `reason` for the honest shape of the evidence. Group by `question`
#   instead and you get the questions this corpus systematically does not answer, which is where
#   the next instrument is worth building.
#
# An absence is a claim and carries its own weight
#   `unmeasured` on a capacity slack suspends an inequality; `unmeasured` on an elimination search
#   suspends a sum rule. Rows here are not missing data; they are the data, and several rules read
#   nothing else.
#
# The label is added at the union site
#   That is what lets the members stay ignorant of each other. Each arm composes a relation that
#   knows nothing about absences and augments it here: `SELECT filing, <how to address it>, '<the
#   question>', <the reason column>`. The member does not carry the question, does not carry its
#   own name, and does not need to spell its key the way its neighbours do:
#   `eliminations/filed.sqlc` says `composition` where `entries/slacks.sqlc` says `filing`, and the
#   union reconciles them. Most arms compose; reading their base tables directly would answer a
#   different question.
#
# The arms that read an absent figure
#   A value wrapper keeps the stated figures: layers/demand.sqlc keeps `demand_low IS NOT NULL`,
#   and a demand absence is exactly the complement, mutually exclusive by CHECK constraint.
#   Composing it here would return nothing. So `demand`, `nameplate amount` and `draw` read
#   layers/summed_quantities.sqlc, which keeps a row for every layer and quantity whether the figure
#   is stated or typed absent, and `remainder` reads layers/denied_remainders.sqlc, the named
#   complement of layers/filed_remainders.sqlc.
#
# The supply's own answers come from the whole table
#   `divisibility`, `who committed the amount`, `lump size` and `measurement basis` want every
#   facility, and layers/nameplate.sqlc keeps those with a stated amount, while a supply stating
#   none still says how it divides and who could commit it. layers/facilities.sqlc keeps them all.
#
# One arm per question, and one question per absence
#   `narrowsWhen` and `boundOrigin` are asked once, of every claim, through epistemics/claims.sqlc.
#   The demand's narrowing and a slack's edge owner were once asked a second time from copies on
#   `layer` and `slack`, and every absence there was counted twice.
#
# Every `absence_reason` column has an arm
#   That is a contract, not a hope. A column with no arm leaves its absences out of every fold of
#   this relation (state_masks, the absence census) with nothing to say so.
#   `epistemics/absence_questions.sqlc` declares which column each question reads;
#   reports/integrity.sqlc holds that roster against `information_schema` in both directions, so a
#   column added to the schema without an arm fails the build; and `examples/combinatorics/main.rs`
#   counts every question against the column it claims, so an arm reading the wrong column, or
#   misnaming its question, fails too.
-- every pm:absent/reason in the schema, from every element that admits one.
SELECT filing, subject, question, reason FROM (
    SELECT filing, layer AS subject, 'demand'              AS question, absent                AS reason FROM (
        :compose(layers/summed_quantities.sqlc)
    ) sq WHERE sq.quantity = 'demand'
    UNION ALL SELECT filing, layer, 'remainder sign',      sign_absent           FROM (
        :compose(layers/filed_remainders.sqlc)
    ) fr
    UNION ALL SELECT filing, layer, 'remainder quantity',  qty_absent            FROM (
        :compose(layers/filed_remainders.sqlc)
    ) fr
    UNION ALL SELECT filing, layer, 'remainder absorber',  absorber_absent       FROM (
        :compose(layers/filed_remainders.sqlc)
    ) fr
    UNION ALL SELECT filing, layer, 'nameplate amount',    absent                FROM (
        :compose(layers/summed_quantities.sqlc)
    ) sq WHERE sq.quantity = 'nameplate'
    UNION ALL SELECT filing, layer, 'divisibility',        divisibility_absent   FROM (
        :compose(layers/facilities.sqlc)
    ) f
    UNION ALL SELECT filing, layer, 'who committed the amount', amount_origin_absent FROM (
        :compose(layers/facilities.sqlc)
    ) f
    UNION ALL SELECT filing, layer, 'lump size',           quantum_absent        FROM (
        :compose(layers/facilities.sqlc)
    ) f
    UNION ALL SELECT filing, layer, 'measurement basis',   measurement_basis_absent FROM (
        :compose(layers/facilities.sqlc)
    ) f
    UNION ALL SELECT filing, layer, 'duty-cycle window',   window_absent         FROM (
        :compose(layers/windows.sqlc)
    ) w
    UNION ALL SELECT filing, layer, 'duty-cycle period',   window_size_absent    FROM (
        :compose(layers/windows.sqlc)
    ) w
    UNION ALL SELECT filing, layer, 'draw',                absent                FROM (
        :compose(layers/summed_quantities.sqlc)
    ) sq WHERE sq.quantity = 'draw'
    UNION ALL SELECT filing, layer || ' / ' || buffer::text, 'buffer slack',      absent    FROM (
        :compose(entries/slacks.sqlc)
    ) s
    UNION ALL SELECT filing, layer || ' / ' || kind::text,   'holder share',      share_absent FROM (
        :compose(entries/holders.sqlc)
    ) h
    UNION ALL SELECT filing, operation || ' / ' || layer, 'operation draw',       absent    FROM (
        :compose(entries/draws.sqlc)
    ) d
    UNION ALL SELECT filing, operation || ' / ' || layer, 'operation induction',  absent    FROM (
        :compose(entries/inductions.sqlc)
    ) i
    UNION ALL SELECT filing, label, 'where the operation is in a notation',
                     foreign_absent::pm.absence_reason FROM (
        :compose(entries/operations.sqlc)
    ) o
    UNION ALL SELECT filing, owns || ' claim ' || seq::text, 'narrowsWhen',      narrows_absent FROM (
        :compose(epistemics/claims.sqlc)
    ) c
    UNION ALL SELECT filing, owns || ' claim ' || seq::text, 'boundOrigin',      origin_absent  FROM (
        :compose(epistemics/claims.sqlc)
    ) c
    UNION ALL SELECT filing, '(the stack)',   'how much of the system',           absent    FROM (
        :compose(epistemics/scopes.sqlc)
    ) sc
    UNION ALL SELECT filing, '(the stack)',   'did anybody look for couplings',   answer    FROM (
        :compose(epistemics/coupling_searches.sqlc)
    ) cs
    UNION ALL SELECT filing, '(the document)', 'its own notation',                absent    FROM (
        :compose(composition/notations.sqlc)
    ) n
    UNION ALL SELECT composition, composed_layer, 'did anybody look for double counting', answer FROM (
        :compose(eliminations/searched.sqlc)
    ) es
    UNION ALL SELECT composition, composed_layer || ' / ' || quantity, 'eliminated quantity', absent FROM (
        :compose(eliminations/filed.sqlc)
    ) e
    UNION ALL SELECT filing, layer, 'remainder',                        reason           FROM (
        :compose(layers/denied_remainders.sqlc)
    ) dr
    UNION ALL SELECT filing, layer, 'patience',                         patience_absent  FROM (
        :compose(layers/patience.sqlc)
    ) pa
    UNION ALL SELECT filing, owns || ' claim ' || seq::text, 'denominator',         denominator_absent   FROM (
        :compose(epistemics/claims.sqlc)
    ) c
    UNION ALL SELECT filing, owns || ' claim ' || seq::text, 'provenance standing', prov_standing_absent FROM (
        :compose(epistemics/claims.sqlc)
    ) c
    UNION ALL SELECT filing, owns || ' absence ' || seq::text, 'provenance standing, on an absence',
                     prov_standing_absent FROM (
        :compose(epistemics/filed_absences.sqlc)
    ) fa
    UNION ALL SELECT filing, owns || ' derivation ' || seq::text,
                     'provenance standing, on a derivation', prov_standing_absent FROM (
        :compose(epistemics/filed_derivations.sqlc)
    ) fd
    UNION ALL SELECT filing, from_layer || ' -> ' || to_layer, 'coupling strength', strength_absent FROM (
        :compose(entries/couplings.sqlc)
    ) cp
    UNION ALL SELECT composition, composed_layer || ' / ' || part_filing || ' ' || part_layer,
                     'part factor', factor_absent FROM (
        :compose(composition/part_references.sqlc)
    ) pr
    UNION ALL SELECT filing,      'regime ' || id,      'regime framework',      framework_absent FROM (
        :compose(composition/regimes.sqlc)
    ) r
    UNION ALL SELECT filing,      'regime ' || id,      'regime chart',          chart_absent     FROM (
        :compose(composition/regimes.sqlc)
    ) r
    UNION ALL SELECT composition, 'part regime ' || id, 'part regime framework', framework_absent FROM (
        :compose(composition/composer_regimes.sqlc)
    ) cr
    UNION ALL SELECT composition, 'part regime ' || id, 'part regime chart',     chart_absent     FROM (
        :compose(composition/composer_regimes.sqlc)
    ) cr
    UNION ALL SELECT filing,      '(the document)',     'what it is evidence for', evidence_absent FROM (
        :compose(scope/every_filing.sqlc)
    ) f
    UNION ALL SELECT filing,      '(the document)',     'assertion standing',    prov_standing_absent FROM (
        :compose(scope/every_filing.sqlc)
    ) f
) a
WHERE reason IS NOT NULL
