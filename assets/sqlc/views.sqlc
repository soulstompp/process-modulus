-- Every statement composed by two or more others, and every fold, as a view.
#
#   psql -f assets/ddl/schema.ddl -f assets/sql/ingest.sql -f assets/sql/views.sql
#
# A view is its composition
#   Each line below creates a view whose body is the statement's own template, composed. Postgres
#   expands a view into the query that reads it before planning, so a view stores no result and
#   changes no plan: querying it runs the statement, with its law and its probe behind it.
#
# `:define` is where the body goes
#   Every other directive in the tree is `:compose`, which says *this relation here* and writes
#   the name where the relation has one. `:define` says *and here is what it is*, so the body is
#   spliced in even though the name exists. That is the only difference between the two, and it is
#   why this file can name every view in the tree without any of them defining itself.
#   A statement may define a name for its own duration the same way, in a `WITH` clause.
#
# The composed files name the views
#   `cargo sqlc compose --views assets/sqlc/views.sqlc` writes `SELECT * FROM <view>` wherever a
#   template listed here is composed, so a statement many others read is written once rather than
#   once per reader. The templates do not change: every `:compose` is still in them, so the compose
#   DAG, the rule closures and the parsers that read the tree see every edge. Composed without
#   `--views`, every statement inlines whole, which is the form for experiments and for tuning a
#   plan.
#
# Which statements are views
#   Every template composed by two or more others, this file aside, that leaves no slot open, and
#   every file in folds/. Each is named after its file, in the schema named after its directory.
#   tests/views.rs holds the list to the tree in both directions, and holds that each view is
#   created after every view it reads.
#
# Required, and rebuilt on every load
#   The composed files read the views, so this file runs after the ingest and before any query.
#   assets/ddl/schema.ddl drops the schema the views read from, which drops the views with it, so
#   this file drops and recreates its own schemas.

SET search_path TO pm, public;
DROP SCHEMA IF EXISTS algebra CASCADE;
CREATE SCHEMA algebra;
DROP SCHEMA IF EXISTS arithmetic CASCADE;
CREATE SCHEMA arithmetic;
DROP SCHEMA IF EXISTS checks CASCADE;
