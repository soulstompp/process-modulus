# ⭐⭐⭐ THE COMPOSED REMAINDER, COMPUTED TWO WAYS, AND THE TWO THAT DISAGREE ARE EXACTLY THE TWO
#    WITH A SPREAD CONVERSION FACTOR. Every other composed layer converts at one or at a point
#    value, so there is no correlation to remove and the figures must agree exactly; those are
#    the controls, and without them a difference here would prove nothing.
#
# ⛔ WHAT DISAGREEMENT MEANS HERE IS NOT THAT A DOCUMENT IS WRONG. `layers/remainder.sqlc`
#   differences the composed totals, and one conversion factor multiplied both of them, so its
#   figure counts that factor's spread twice. The pivot converts each part's own remainder, so
#   the factor appears once per term. Both are arithmetically correct; only one is the
#   remainder. This section is a REFERRAL, not a violation.
-- composition/fused_remainders.sqlc, with the two figures set against each other.
SELECT f.composition                                             AS "composition!",
       f.composed_layer                                          AS "composed_layer!",
       f.parts                                                   AS "parts!",
       f.unit                                                    AS "unit!",
       f.pivoted_low::float8                                     AS "pivoted_low!",
       f.pivoted_mode::float8                                    AS "pivoted_mode!",
       f.pivoted_high::float8                                    AS "pivoted_high!",
       f.derived_low::float8                                     AS "derived_low!",
       f.derived_mode::float8                                    AS "derived_mode!",
       f.derived_high::float8                                    AS "derived_high!",
       (f.pivoted_low = f.derived_low
    AND f.pivoted_mode = f.derived_mode
    AND f.pivoted_high = f.derived_high)                         AS "agrees!"
FROM (
    :compose(composition/fused_remainders.sqlc)
) f
ORDER BY "agrees!", f.composition, f.composed_layer
