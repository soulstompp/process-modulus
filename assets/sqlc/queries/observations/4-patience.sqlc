-- §4  How long each layer's demand survives going unanswered.
# One row per layer: whether its patience is filed, its most likely value and unit, and the unit
# of the demand it qualifies.
#
# The demand's side of time
#   Few layers fill it. `pm:Divisibility/window` is when the supply is there; a patience is how
#   long the demand lasts, and without the element there would be nowhere to file it but a slack's
#   blank.
#
# A patience is not a time slack
#   The units tell them apart. A slack is quoted in the unit of the shares it bounds; a patience is
#   a span of time that bounds no shares. Nothing compares the two columns, and this is where a
#   reader can.
-- layers/patience.sqlc, beside the demand each patience qualifies.
SELECT p.filing                            AS "filing!",
       p.layer                             AS "layer!",
       coalesce(p.patience_absent::text, 'filed') AS "state!",
       p.patience_mode::float8             AS "mode",
       coalesce(p.patience_unit, '')       AS "unit!",
       coalesce(p.demand_unit, '')         AS "demand_unit!"
FROM (
    :compose(layers/patience.sqlc)
) p
ORDER BY p.patience_absent NULLS FIRST, p.filing, p.layer
