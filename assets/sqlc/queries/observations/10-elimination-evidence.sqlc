-- §10  What each filed elimination says it is between, which is the evidence for the number.
# One row per filed elimination, with the layers it names as double counted folded beside it. An
# elimination without its `between` is a number with no subject: the composer removed 90
# GPU-hours and nothing says from what.
#
# Kept by asking whether the document can be written back
#   `asrt:Elimination/between` repeats and no rule reads it, so no rule forces it to have a column,
#   a table or an ingest; a rule reads what it needs, so a field nothing reads is under no pressure
#   to exist. The question that keeps it is "can this document be written back out from the
#   database".
#
# An elimination with no `between` is not malformed
#   The element is `minOccurs="0"`, and a composer who eliminates against a member that files
#   nothing has nothing to name. The count is reported rather than asserted.
-- eliminations/filed.sqlc with eliminations/between.sqlc folded per elimination.
SELECT e.composition                              AS "composition!",
       e.composed_layer                           AS "composed_layer!",
       e.quantity::text                           AS "quantity!",
       -- Three arms: `pm:StatedEliminatedQuantity` admits a figure, a typed absence or a
       -- derivation, and the column is declared NOT NULL, so all three are read.
       -- `every-derived-elimination` files the third.
       coalesce(e.mode::text,
                '(' || e.absent || ')',
                '(computed: ' || e.derivation || ')')  AS "size!",
       count(b.seq)                               AS "named!",
       coalesce(string_agg(b.party || '/' || b.layer, ', ' ORDER BY b.seq), '(none named)')
                                                  AS "between!"
FROM (
    :compose(eliminations/filed.sqlc)
) e
LEFT JOIN (
    :compose(eliminations/between.sqlc)
) b USING (composition, composed_layer, quantity)
GROUP BY e.composition, e.composed_layer, e.quantity, e.mode, e.absent, e.derivation
ORDER BY count(b.seq) DESC, 1, 2, 3
