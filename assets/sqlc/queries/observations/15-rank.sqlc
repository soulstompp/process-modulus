-- §15  What the layer dimension actually carries, and the order a fusion may be evaluated in.
#
# ⭐⭐⭐ THE MEASUREMENT THAT SAYS WHY A DIAGRAM OF THIS CORPUS LOOKS EMPTY. The three relations a
# process notation would have drawn as arrows reach a handful of layers each; `nameplate` and
# `slack` reach nearly all of them. The incidence side is sparse and the magnitude side is total,
# and a notation can carry only the first. That is not a defect in either.
#
# ⭐⭐ AND IT IS A `WHERE` ON A RELATION THAT ALREADY EXISTS, which is what most observations here
# should be: rank/incidence_cover.sqlc is the object, and this restricts it to the two kinds and
# puts them beside each other, which is what an observation is for.
-- rank/incidence_cover.sqlc, ordered so the two kinds sit beside each other.
SELECT c.relation  AS "relation!",
       c.kind      AS "kind!",
       c.reaches   AS "reaches!",
       (SELECT count(*) FROM ( :compose(layers/every_layer.sqlc) ) l) AS "of!"
FROM (
    :compose(rank/incidence_cover.sqlc)
) c
ORDER BY c.kind, c.reaches DESC, c.relation
