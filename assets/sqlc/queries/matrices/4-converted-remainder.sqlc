-- §4  The one layer where a conversion factor is correlated with itself.
# One row: the filed remainder of `merge-holding-composition/compute` beside the demand and
# nameplate it would have been re-derived from. The example differences the second pair in Rust
# and compares.
#
# One factor multiplies both sides
#   That layer converts a US part metered per reserved card into GPU-hour, and one factor
#   multiplies both sides. The nameplate and the demand therefore move together, so the two
#   converted intervals are correlated, and differencing them as though they were independent
#   counts the factor's spread twice.
#
# They agree at the mode and nowhere else
#   The mode is the one point where the factor is a single number with no spread to double. Both
#   figures are arithmetically correct; only the filed one is the remainder.
-- layers/filed_against_derived.sqlc at the one layer with a spread conversion factor.
SELECT r.qty_low::float8      AS "q_low!",
       r.qty_mode::float8     AS "q_mode!",
       r.qty_high::float8     AS "q_high!",
       r.d_low::float8        AS "d_low!",
       r.d_mode::float8       AS "d_mode!",
       r.d_high::float8       AS "d_high!",
       r.n_low::float8        AS "n_low!",
       r.n_mode::float8       AS "n_mode!",
       r.n_high::float8       AS "n_high!"
FROM (
    :compose(layers/filed_against_derived.sqlc)
) r
WHERE r.filing = 'merge-holding-composition'
  AND r.layer  = 'compute'
