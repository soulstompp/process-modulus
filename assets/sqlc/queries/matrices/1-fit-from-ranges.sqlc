-- §1  The remainder and its fit, read off the ranges rather than off a point.
#
# EVERY LAYER THAT FILES BOTH A DEMAND RANGE AND A NAMEPLATE RANGE AND CLASSIFIES ITSELF.
# One row per layer, carrying both ranges and the sign the document filed -- so the example
# can recompute `r = n - d` in Rust and assert the two agree.
#
# ⭐ RUN IT ALONE AND THE INTERESTING COLUMN IS `sign!`: one layer in the whole corpus is a
#   `transition`, the case a two-member enumeration could not have named.
#
# ⛔ `evidence!` SEPARATES THE CORPUS FROM THE FIXTURES AND THE SPLIT IS THE POINT. Every
#   fixture layer reaching this query is a `transition` -- they were written to exercise the
#   state the corpus almost never reaches -- so a census pooling them would report the rare
#   case as common and the note would quote it.
#
# ⛔ THE SHARED RELATION IS layers/signed.sqlc, WHICH IS ALSO WHAT THE SIGN RULE EXAMINES. The
#   example and the checker therefore range over the same rows by construction rather than by
#   two authors agreeing.
-- layers/signed.sqlc, with the evidence axis from pm.filing.
SELECT s.filing              AS "filing!",
       s.layer               AS "layer!",
       s.d_low::float8       AS "d_low!",
       s.d_mode::float8      AS "d_mode!",
       s.d_high::float8      AS "d_high!",
       s.n_low::float8       AS "n_low!",
       s.n_mode::float8      AS "n_mode!",
       s.n_high::float8      AS "n_high!",
       s.sign::text          AS "sign!",
       f.evidence            AS "evidence!"
FROM (
    :compose(layers/signed.sqlc)
) s
JOIN (
    :compose(scope/every_filing.sqlc)
) f USING (filing)
ORDER BY s.filing, s.layer
