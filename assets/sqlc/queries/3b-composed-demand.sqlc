-- §3  What each composed layer actually filed, and the elimination to subtract from it.
#
# THE RIGHT-HAND SIDE OF `x_composed = F Φ x_parts − e`. One row per layer with a stated
# demand that is NOT suspended, carrying the filed figure and the elimination to remove from
# it. The example compares this against the matrix product built from 3a.
#
# ⛔⛔⛔ THE FUSIONS THAT OWE NO EQUALITY ARE EXCLUDED, AND THAT EXCLUSION IS THE WHOLE OF IT.
# A composer who states they never looked for double counting has not claimed their figure
# equals the sum of its parts, and asserting it anyway is the exact defect `StatedEliminations`
# was added to prevent — arriving in the CHECKER instead of in the document.
# ⭐ `none` and `notApplicable` still owe the sum exactly. Only `unmeasured` suspends it.
# ⛔⛔ AND IT SUSPENDS AT BOTH LEVELS. A fusion may file an elimination and declare its
# QUANTITY `unmeasured` — "we know these hours are double counted and cannot say by how much" —
# which is a different filing from an unsearched list and owes no equality either.
# `coalesce(e.low, 0)` reads that as a zero and asserts a sum the composer declined, and
# `tests/composition.rs::expected` returns `None` for exactly that case. Two witnesses, one
# rule — and one relation, composition/suspended_fusions.sqlc, which this anti-joins.
-- layers/demand.sqlc minus composition/suspended_fusions.sqlc, with pm.elimination.
SELECT d.filing                     AS "filing!",
       d.layer                      AS "layer!",
       d.d_low::float8              AS "d_low!",
       d.d_mode::float8             AS "d_mode!",
       d.d_high::float8             AS "d_high!",
       coalesce(e.low, 0)::float8   AS "e_low!",
       coalesce(e.mode, 0)::float8  AS "e_mode!",
       coalesce(e.high, 0)::float8  AS "e_high!"
FROM      (
    :compose(layers/demand.sqlc)
) d
LEFT JOIN (
    :compose(composition/suspended_fusions.sqlc)
) s
       ON s.composition = d.filing AND s.composed_layer = d.layer
LEFT JOIN pm.elimination e
       ON e.composition = d.filing AND e.composed_layer = d.layer
      AND e.quantity = 'demand'
WHERE s.composition IS NULL
