# Every graph the filings make, measured at two scopes. One row per (graph, filing): a NULL filing
# is the graph taken whole, and a filing is that filing's cut of it. Each row counts the graph's
# nodes, edges and components, and the two figures those counts give, `rank_of_incidence` and
# `cycle_space_dim`.
#
# The walk that finds components lives here once
#   `rank/cycle_space.sqlc` reads this relation across the whole corpus, and
#   `rank/decomposition.sqlc` compares the two scopes, so neither keeps `nodes`, `sym`, `reach` or
#   `comp` of its own: the recursion that finds connected components is one relation, and the two
#   readings count over it. A copy of the walk that differed by a column on each line would pass any
#   check that compares lines, so the walk lives in one place.
#
# The two figures, worked out once
#   Both come from the node, edge and component counts, and they are written here and nowhere else,
#   so a sign cannot differ between two files.
#
# `m_edges` counts distinct edges
#   An edge filed under two filings counts once in the whole graph. Counting (filing, edge) pairs
#   would raise `m_edges` without moving the nodes or the components, and add one to
#   `cycle_space_dim` for each repeat. No edge is filed twice in this corpus, so the two counts
#   agree here, and distinct edges are the ones that are right.
#
# The per-filing scope is a cut
#   Cutting a graph by filing can break a loop that runs through two filings. The unit graph's one
#   loop runs through the whole corpus and disappears under the cut, which is why
#   `examples/diagramming` draws the layer graph per filing and not the unit graph.
-- rank/graph_edges.sqlc, symmetrised and walked for components, counted at both scopes.
WITH RECURSIVE
edges AS (
    SELECT DISTINCT g.graph, g.filing, g.from_node AS a, g.to_node AS b
    FROM ( :compose(rank/graph_edges.sqlc) ) g
),
scoped AS (
    SELECT DISTINCT graph, NULL::text AS filing, a, b FROM edges
  UNION ALL
    SELECT graph, filing, a, b FROM edges
),
nodes AS (SELECT graph, filing, a AS u FROM scoped UNION SELECT graph, filing, b FROM scoped),
sym   AS (SELECT graph, filing, a, b FROM scoped UNION SELECT graph, filing, b, a FROM scoped),
reach(graph, filing, root, at) AS (
      SELECT graph, filing, u, u FROM nodes
    UNION
      SELECT r.graph, r.filing, r.root, s.b
      FROM reach r JOIN sym s ON s.graph = r.graph AND s.filing IS NOT DISTINCT FROM r.filing
                              AND s.a = r.at
),
comp AS (SELECT graph, filing, root, min(at) AS component FROM reach GROUP BY graph, filing, root)
SELECT n.graph, n.filing,
       count(DISTINCT n.u)                                         AS n_nodes,
       (SELECT count(*) FROM scoped w
         WHERE w.graph = n.graph AND w.filing IS NOT DISTINCT FROM n.filing) AS m_edges,
       count(DISTINCT c.component)                                 AS c_components,
       (SELECT count(*) FROM scoped w
         WHERE w.graph = n.graph AND w.filing IS NOT DISTINCT FROM n.filing)
         - count(DISTINCT n.u) + count(DISTINCT c.component)       AS cycle_space_dim,
       count(DISTINCT n.u) - count(DISTINCT c.component)           AS rank_of_incidence
FROM nodes n
JOIN comp c ON c.graph = n.graph AND c.filing IS NOT DISTINCT FROM n.filing AND c.root = n.u
GROUP BY n.graph, n.filing
