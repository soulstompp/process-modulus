# THE DOCUMENTS THAT STIPULATE A STATE. One row per filing written to reach a combination
# the corpus does not contain -- a `derived` sign, a partial elimination, an asserted
# independence.
#
# ⭐ RUN THIS ONE ALONE TO SEE WHAT THE CORPUS IS MISSING. Every row here is a state
#   somebody had to invent because no real filing produced it, so this relation is a
#   readable list of the model's untested edges.
-- from pm.filing where evidence = 'fixture'; see assets/fixtures/README.md.
SELECT f.name AS filing, f.kind, f.evidence
FROM pm.filing f
WHERE f.evidence = 'fixture'
