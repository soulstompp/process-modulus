# EVERY CROSS-DOCUMENT PART WHOSE FRAMEWORK DIFFERS FROM THE ONE IT IS COMPOSED INTO. One row per
# crossing, with both frameworks and whether the composition cites an instrument.
#
# ⭐⭐⭐ IT NEEDS NO SCHEMA CHANGE: PAIR `regime` WITH `part` AND THE CROSSING IS ALREADY THERE.
#    `pm.regime` is a tall table because a `filing.jurisdiction` column cannot hold `refutation`,
#    which reports under two regimes at once. `merge-group-composition` composes under IFRS-2026
#    from parts under `NCRF-PE` and `us-gaap`, which is what consolidation IS, and this is the
#    relation that says so.
#
# ⭐⭐ AND IT IS THE EXACT ANALOGUE OF THE UNIT CROSSING. `checks/unit_crossing_without_a_factor`
#    says: cross a unit boundary and you must file what converts, because somebody is asserting
#    two units are interchangeable and an assertion needs a filer. Cross a REGIME boundary and
#    somebody is asserting two frameworks' figures may be added. `asrt:Composition/citation`
#    carries the instrument and the clause, and that is what reconciles it.
#
# ⛔⛔ A FILING THAT STATES NO FRAMEWORK IS NOT A FILING IN THE SAME FRAMEWORK, AND SQL WILL SAY
#    IT IS. `IS DISTINCT FROM` returns false for two NULLs, so a pair of documents that never
#    named a regime reads as "no crossing" and vanishes from the population. `crossing_known`
#    carries that apart, and it is the §9 pattern arriving where nobody had looked for it: the
#    matrix needs the search beside it. ⚠️ `pm.regime` has no typed absence column, alone among
#    the fact tables, so `unmeasured` and `notApplicable` are stored identically here.
# ⭐⭐⭐ IT JOINS TWO SELF-DECLARATIONS AND NEVER THE COMPOSER'S ASSIGNMENT. The composition's
#    own framework against the PART FILING'S own framework is a real fact and a checkable one.
#    What the composer says a part reports under is a DIFFERENT claim with a different author,
#    filed as `asrt:part/asrt:layer/asrt:regime`, and keeping the two apart is what this whole
#    model exists for: what a filing says about itself and what somebody says about it are never
#    the same claim.
#
#    ⭐ The composer's side is `checks/part_regime_disagrees`, over
#    `composition/part_regimes.sqlc`, which holds both claims side by side.
--
-- composition/part_regimes.sqlc: the composer's framework for each part against the framework
-- the composition itself reports under.
SELECT x.composition, x.composed_layer, x.part_filing, x.part_layer,
       own.framework_taxonomy AS composed_taxonomy,
       own.framework_value    AS composed_framework,
       x.composer_taxonomy    AS part_taxonomy,
       x.composer_value       AS part_framework,
       (own.states = 1 AND x.composer_value IS NOT NULL)                  AS crossing_known,
       (own.states = 1 AND x.composer_value IS NOT NULL
        AND (own.framework_taxonomy, own.framework_value)
            IS DISTINCT FROM (x.composer_taxonomy, x.composer_value))     AS crosses,
       c.instrument, c.clause
FROM      (
    :compose(composition/part_regimes.sqlc)
) x
-- ⛔⛔ `seq = 1` WOULD BE A GUESS THAT COULD NOT ANNOUNCE ITSELF. A filing may
--   declare more than one regime, which is the whole reason `regime` is tall, and taking the
--   first silently picks one of them. Probed by giving the composition a second declaration: the
--   crossing count did not move, which is the danger rather than the reassurance. `states`
--   counts them, and a composition reporting under two frameworks makes "the framework it
--   composes INTO" a question with two answers, so the crossing is not KNOWN rather than absent.
LEFT JOIN (
    SELECT r.filing,
           count(*) FILTER (WHERE r.framework_value IS NOT NULL) AS states,
           min(r.framework_taxonomy) AS framework_taxonomy,
           min(r.framework_value)    AS framework_value
    FROM pm.regime r GROUP BY r.filing
) own ON own.filing = x.composition
LEFT JOIN (
    :compose(composition/citations.sqlc)
) c ON c.composition = x.composition
