# THE PARTS THAT FILE A DUTY CYCLE, BESIDE THE WINDOW THE COMPOSED LAYER FILES. One row per
# resolved part whose own nameplate states a window.
#
# ⭐⭐⭐ A WINDOW IS CARRIED THROUGH A FUSION AND NEVER SUMMED, and the schema says why in one
#    sentence: "two members naming one machine file one calendar between them; summing gives
#    ten days a week." Amounts add. Calendars do not -- they are the same calendar seen twice.
#
# ⛔⛔ BOTH HALVES OF THAT WERE UNENFORCEABLE WHILE A DROPPED WINDOW AND A SUPPLY THAT RUNS
#    CONTINUOUSLY WERE THE SAME DOCUMENT. Once the absence is typed, a composed layer that
#    silently loses its parts' calendar is distinguishable from one that states it runs
#    without interruption -- and the holding level in this corpus HAD dropped one.
-- pm:Part's own pm:Divisibility/window against the composed pm:Layer's.
SELECT p.composition, p.composed_layer, p.part_filing, p.part_layer,
       pw.window_low, pw.window_unit,
       cw.window_low    AS composed_window_low,
       cw.window_absent AS composed_window_absent
FROM      (
    :compose(composition/parts.sqlc)
) p
JOIN      (
    :compose(layers/windows.sqlc)
) pw
       ON pw.filing = p.part_filing  AND pw.layer = p.part_layer
JOIN      (
    :compose(layers/windows.sqlc)
) cw
       ON cw.filing = p.composition  AND cw.layer = p.composed_layer
WHERE pw.window_low IS NOT NULL
