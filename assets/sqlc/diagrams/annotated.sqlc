# Everything a BPMN emission owes a `documentation` element. One row per document, one per lane,
# one per category, one per lane set, and one per dependence.
#
# `documentation` is not a container
#   `definitions`, `collaboration`, `process` and `laneSet` frame a document and must appear
#   exactly once in it. `documentation` is an annotation: BPMN admits it on any base element, so
#   counting it as one per document is a law that happens to be true and is wrong about the kind
#   of thing it governs. It fires the instant a lane is annotated.
#
# Provenance is owed by both
#   For the same reason the `--` line is owed by generated SQL. A document says which filing it
#   came from; a lane says its rank, which is not recoverable from anything else in the artifact
#   because `calledElement` names a process and `F` links layers. A lane with no documentation is
#   a lane whose evaluation order nobody can read.
#
# A category owes one
#   For the reason this whole file tree exists. The only visual difference between a `group` and
#   a `lane` is a dashed border, and the reader of a diagram is the brilliant analyst who reads a
#   box as a container. BPMN's semantics do say a group implies no containment, and semantics are
#   not what somebody reads off a picture in a deck. A category with no documentation is a cover
#   that will be read as a partition, which is the falsifier of pm:Layer drawn by accident.
#
# The `laneSet` row carries the search
#   It carries a fact nothing else could. A matrix and the search beside it are filed as a pair,
#   and most filings here state no coupling, so a diagram drawing only the matrix is silent about
#   them in a way a reader resolves as independence. The laneSet is the partition the search is
#   about, `tLaneSet` extends `tBaseElement`, and so the answer fits an element already spent. An
#   absent line is not independence, and this is the only place the artifact can say so.
#
# `states` is the `--` line
#   Carried into the artifact. A generated `.sql` file names the template it came from on one
#   line, because a reader of thousands of generated lines otherwise cannot get back to the
#   argument. A `documentation` element is in exactly that position: without `states` the sentence
#   is on the page, the relation that states it is not, and no reader of a `.bpmn` has a route
#   back. A sentence about a filing with nothing naming its source is a claim the emitter made,
#   which is the `invents` state this roster already caught once in a hardcoded scope.
#
# The `lane` row cites another relation
#   It points somewhere else than its own arm, which makes it the interesting one.
#   `layers/every_layer.sqlc` says a lane is owed one; the sentence it carries states a rank, and
#   that comes from `rank/evaluation_order.sqlc`. Owed by and stated by are two different
#   questions, and only one of them is what a reader chasing a number needs. Every other row here
#   answers both with the same relation, which is why writing it down was easy to skip.
#
# A task naming a position owes one
#   That is the one sentence in these documents that points out of the notation rather than into
#   the model. `pm:Operation/foreignId` names a node in a BPMN document that travels beside the
#   filing and is not this one: this document is a rendering of the model, and that id belongs to
#   the process notation the filer was actually reading. So it must not become the task's own
#   `id`, which would claim the two documents are one, and it cannot be a `relationship`, whose
#   `source` and `target` are QNames and need an `import` that needs a location nobody filed. A
#   `documentation` is what is left, and `demoted` is the honest word for it: a person can read the
#   id and a tool cannot resolve it, which is the state `pm:ForeignId` intends, because no
#   authority publishes the list a tool would resolve against.
#
# A task naming no position owes one too
#   This is the `coupling_search` argument at a second address. A lane set carries whether anybody
#   looked for a dependence, because an absent line reads as independence. A task with no position
#   reads as *this model does not reach the notation*, and `notationPosition` is required precisely
#   so the filing can say which of three things it means: in no notation and somebody looked, in a
#   notation nobody has located it in, or no notation to point into at all. Emitting the stated arm
#   alone would put the answer on the page for the operations that cross and leave the far more
#   common case looking like a gap in the model rather than an answer in the document.
#
# Defined, not read
#   A program reads these columns, so this statement defines its vocabulary in its own
#   WITH clause: a view keeps the rows and loses the column's origin, which is where
#   NOT NULL lives. assets/sqlc/views.sqlc says what a definition is.
#
-- the pools, the lanes and the categories, which are the three places provenance is owed.
WITH
composition_citations AS NOT MATERIALIZED (
    :define(composition/citations.sqlc)
),
notations AS NOT MATERIALIZED (
    :define(composition/notations.sqlc)
),
part_references AS NOT MATERIALIZED (
    :define(composition/part_references.sqlc)
),
parts AS NOT MATERIALIZED (
    :define(composition/parts.sqlc)
),
calls AS NOT MATERIALIZED (
    :define(diagrams/calls.sqlc)
),
inductions AS NOT MATERIALIZED (
    :define(entries/inductions.sqlc)
),
categories AS NOT MATERIALIZED (
    :define(diagrams/categories.sqlc)
),
diagrams_citations AS NOT MATERIALIZED (
    :define(diagrams/citations.sqlc)
),
couplings AS NOT MATERIALIZED (
    :define(entries/couplings.sqlc)
),
dependences AS NOT MATERIALIZED (
    :define(diagrams/dependences.sqlc)
),
descents AS NOT MATERIALIZED (
    :define(diagrams/descents.sqlc)
),
every_filing AS NOT MATERIALIZED (
    :define(scope/every_filing.sqlc)
),
documents AS NOT MATERIALIZED (
    :define(epistemics/documents.sqlc)
),
pools AS NOT MATERIALIZED (
    :define(diagrams/pools.sqlc)
),
epistemics_scopes AS NOT MATERIALIZED (
    :define(epistemics/scopes.sqlc)
),
diagrams_scopes AS NOT MATERIALIZED (
    :define(diagrams/scopes.sqlc)
),
coupling_searches AS NOT MATERIALIZED (
    :define(epistemics/coupling_searches.sqlc)
),
searches AS NOT MATERIALIZED (
    :define(diagrams/searches.sqlc)
),
eliminations_between AS NOT MATERIALIZED (
    :define(eliminations/between.sqlc)
),
eliminations_references AS NOT MATERIALIZED (
    :define(eliminations/references.sqlc)
),
resolved AS NOT MATERIALIZED (
    :define(eliminations/resolved.sqlc)
),
operations AS NOT MATERIALIZED (
    :define(entries/operations.sqlc)
),
notation_references AS NOT MATERIALIZED (
    :define(entries/notation_references.sqlc)
),
every_layer AS NOT MATERIALIZED (
    :define(layers/every_layer.sqlc)
)
SELECT 'document' AS annotated, d.filing AS subject,
       'diagrams/pools.sqlc' AS states
FROM ( :compose(diagrams/pools.sqlc) ) d
UNION ALL
SELECT 'lane', l.filing || '/' || l.layer, 'rank/evaluation_order.sqlc'
FROM ( :compose(layers/every_layer.sqlc) ) l
UNION ALL
SELECT 'category', c.filing, 'diagrams/categories.sqlc'
FROM ( SELECT DISTINCT k.filing FROM ( :compose(diagrams/categories.sqlc) ) k ) c
UNION ALL
SELECT 'lane set, the coupling search', s.filing, 'diagrams/searches.sqlc'
FROM ( :compose(diagrams/searches.sqlc) ) s
UNION ALL
SELECT 'lane set, the scope', s.filing, 'diagrams/scopes.sqlc'
FROM ( :compose(diagrams/scopes.sqlc) ) s
UNION ALL
SELECT 'process, the citation', c.composition, 'diagrams/citations.sqlc'
FROM ( :compose(diagrams/citations.sqlc) ) c
UNION ALL
SELECT 'relationship', d.composition || '/' || d.composed_layer || '<-' || d.part_filing || '/' || d.part_layer,
       'diagrams/descents.sqlc'
FROM ( :compose(diagrams/descents.sqlc) ) d
UNION ALL
SELECT 'relationship, an attribution',
       b.composition || '/' || b.composed_layer || '<>' || b.resolved_filing || '/' || b.layer,
       'diagrams/attributions.sqlc'
FROM ( :compose(diagrams/attributions.sqlc) ) b
UNION ALL
SELECT 'dependence', d.filing || '/' || d.from_layer || '->' || d.to_layer,
       'diagrams/dependences.sqlc'
FROM ( :compose(diagrams/dependences.sqlc) ) d
UNION ALL
SELECT 'task, the notation position', n.filing || '/' || n.label,
       'entries/notation_references.sqlc'
FROM ( :compose(entries/notation_references.sqlc) ) n
UNION ALL
SELECT 'task, no notation position', o.filing || '/' || o.label,
       'entries/operations.sqlc'
FROM ( :compose(entries/operations.sqlc) ) o
WHERE o.foreign_absent IS NOT NULL
