# EVERY EDGE OF EVERY GRAPH THIS MODEL COMPOSES, LABELLED BY WHICH GRAPH IT BELONGS TO. One row
# per (graph, from, to).
#
# ⭐⭐ THE CALLER SUPPLIES THE LABEL, because the caller is the thing holding both. Neither arm knows which graph it serves,
#    and a member that carried its own would be answering a question about the set it happens to
#    be in. It is the same union `rank/cycle_space.sqlc` folds to count nodes and components.
#
# ⛔⛔ THE CLAIMANT GRAPH CONTRIBUTES NO ARM, AND THAT IS THE POINT RATHER THAN AN OMISSION.
#    `diagrams/graphs.sqlc` declares three graphs and this relation supplies edges for two.
#    Delegation is filed nowhere: `pm.claim` has `prov_entered_by` and `prov_approved_by` as bare
#    tokens with no identity to join on, which `pm:Provenance`'s own annotation names as the defect
#    it did not fix. An emitter asked for the claimant graph draws a pool with no edges in it, and
#    that empty pool is the honest rendering of an unfiled relation.
-- composition/parts.sqlc and units/conversions.sqlc, each labelled with the graph it is an edge of.
SELECT 'layers' AS graph,
       p.composition || '/' || p.composed_layer AS from_node,
       p.part_filing || '/' || p.part_layer     AS to_node
FROM (
    :compose(composition/parts.sqlc)
) p
UNION ALL
SELECT 'units', c.from_unit, c.to_unit
FROM (
    :compose(units/conversions.sqlc)
) c
