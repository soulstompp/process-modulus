# What an operation takes from a layer, now. One row per (filing, operation, layer); no row means
# that operation draws nothing from that layer.
#
# A draw is consumption that happened
#   entries/inductions.sqlc has the same shape and holds a different fact, which is why it is a
#   second table.
-- pm:Operation/pm:Draw.
SELECT d.filing, d.operation, d.layer,
       d.low, d.mode, d.high, d.unit, d.absent
FROM pm.draw d
