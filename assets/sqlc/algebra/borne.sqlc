# What every holder holds, split into what a buffer absorbed and what went unserved. One row per
# layer: whether the two sum back to the whole.
#
# Additive, not cardinal
#   The anti-join is inside a `GROUP BY`, so the law is additive rather than cardinal.
#   entries/borne.sqlc removes unserved holders and then sums per (filing, layer, buffer):
#   removing some leaves the group standing with a smaller total, removing all drops the group.
#   So counting rows says nothing here, and a row count can report a confident false finding. Σ
#   is what must balance: Σall = Σkept + Σremoved.
#
# The law behind a vacuous verdict
#   Every interference layer in this corpus that sizes its absorbing buffer has all of its
#   holders unserved, so Σkept is zero and share_exceeds_slack examines nothing. The law still
#   holds, because the sum balances at zero, and that is the point: the vacuum is a finding about
#   the evidence, not a broken operator.
#
# Both sides composed, never re-derived
#   The law composes both sides rather than re-deriving the split, which is what makes it a law
#   about them. Compute `absorbed` as `FILTER (WHERE u.kind IS NULL)` over an anti-join written
#   here and the law asserts that its own copy of the split is exhaustive, and goes on passing
#   when entries/served_holders.sqlc changes underneath it. A law that re-derives its subject is
#   the one failure a soundness contract cannot afford, because it is invisible.
-- entries/served_holders.sqlc and entries/unserved_holders.sqlc against pm:Remainder/pm:holder.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT x.filing || ' / ' || x.layer AS subject,
           abs(x.held - x.served - x.unserved) < 1e-9 AS holds,
           format('%s held = %s absorbed + %s unserved', x.held, x.served, x.unserved) AS detail
    FROM (
        SELECT h.filing, h.layer,
               sum(h.share_mode)                                            AS held,
               coalesce((SELECT sum(v.share_mode) FROM (
                   :compose(entries/served_holders.sqlc)
               ) v WHERE v.filing = h.filing AND v.layer = h.layer), 0)      AS served,
               coalesce((SELECT sum(u.share_mode) FROM (
                   :compose(entries/unserved_holders.sqlc)
               ) u WHERE u.filing = h.filing AND u.layer = h.layer), 0)      AS unserved
        FROM (
            :compose(entries/holders.sqlc)
        ) h
        WHERE h.share_mode IS NOT NULL
        GROUP BY h.filing, h.layer
    ) x
) p ON true
WHERE a.slug = 'borne'
