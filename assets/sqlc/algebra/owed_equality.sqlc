# The (fusion, quantity) pairs that owe a sum, against the ones that do not. One row: whether every
# pair of a fusion and a quantity either owes its sum or is suspended or derived, counted row for
# row, where derived is the composed figures filed `derived`.
#
# One `EXISTS`, over the union
#   The two sets removed are united first and tested with a single `EXISTS`. Two `EXISTS` joined by
#   `OR` would each run once per (fusion, quantity) pair, and one of the suspension grounds walks
#   the whole derived composition.
#
# An `EXCEPT` over rows that never repeat
#   composition/fusions.sqlc is `SELECT DISTINCT` over the bare key, and the quantities are
#   distinct, so every pair of them is distinct too, counting with or without repeats gives the same
#   answer, and the law is exact. Let the fusions repeat and this law fails before anything goes
#   quiet.
#
# Probe
#   examples/probes runs it as `owed_equality`: leave a composed figure filed `derived` owing its
#   equality, and the law must fail.
-- composition/fusions.sqlc for every quantity, split by composition/suspended_quantities.sqlc and
-- composition/derived_fusions.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'composition/owed_equality' AS subject,
           x.total = x.kept + x.removed AS holds,
           format('%s fusion quantities: %s owing, %s suspended or derived', x.total, x.kept,
                  x.removed)
               AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(composition/fusions.sqlc) ) f
               CROSS JOIN unnest(enum_range(NULL::pm.summed_quantity)) AS q(quantity)) AS total,
             (SELECT count(*) FROM ( :compose(composition/owed_equality.sqlc) ) o)   AS kept,
             (SELECT count(*) FROM ( :compose(composition/fusions.sqlc) ) f
               CROSS JOIN unnest(enum_range(NULL::pm.summed_quantity)) AS q(quantity)
               WHERE EXISTS (SELECT 1
                             FROM ( SELECT s.composition AS filing, s.composed_layer AS layer,
                                           s.quantity
                                    FROM ( :compose(composition/suspended_quantities.sqlc) ) s
                                    UNION ALL
                                    SELECT d.filing, d.layer, d.quantity
                                    FROM ( :compose(composition/derived_fusions.sqlc) ) d ) b
                             WHERE b.filing = f.filing AND b.layer = f.layer
                               AND b.quantity = q.quantity)) AS removed
         ) x
) p ON true
WHERE a.slug = 'owed_equality'
