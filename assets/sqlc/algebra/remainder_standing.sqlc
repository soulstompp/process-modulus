# Every computable remainder, and whether it was classified exactly once. One row.
#
# The closure question, as algebra
#   examples/observations/main.rs asserts that the closure question was put to every remainder,
#   and this is that assertion as algebra. layers/remainder_scope.sqlc must be a partition of
#   layers/remainder.sqlc: exhaustive, so no remainder reaches the arithmetic unasked, and
#   disjoint, so no remainder is counted under two standings.
#
# Fan-out from the left joins
#   The left joins inside remainder_scope are one risk. A layer whose filing declared two stack
#   scopes, or two coupling searches, would fan out and be classified twice, and the standing
#   counts would still look reasonable. Cardinality on both sides is what catches that one.
#
# A remainder matching no arm
#   The arms are the other risk, and cardinality cannot see it. The `CASE` is in the SELECT list,
#   so a remainder matching no arm keeps its row and takes `standing = NULL` rather than
#   vanishing. `unclassified` is the term that sees it.
#
# Which standings exist is the type's job
#   The type is `public.remainder_standing`, because a count of rows per standing cannot see a
#   standing renamed. Every arm casts to it.
#
# Probe
#   examples/probes runs it as `remainder_standing`.
#   Remove the `ELSE` from layers/remainder_scope.sqlc. Computable, classified and doubled still
#   agree; `unclassified` must count the remainders that fall through, and the law must fail.
-- layers/remainder.sqlc against layers/remainder_scope.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'layers/remainder_scope' AS subject,
           x.computable = x.classified AND x.doubled = 0 AND x.unclassified = 0 AS holds,
           format('%s computable remainders, %s classified, %s classified twice, %s with no standing',
                  x.computable, x.classified, x.doubled, x.unclassified) AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(layers/remainder.sqlc) ) r)       AS computable,
             (SELECT count(*) FROM ( :compose(layers/remainder_scope.sqlc) ) z) AS classified,
             (SELECT count(*) FROM ( SELECT filing, layer FROM ( :compose(layers/remainder_scope.sqlc) ) z
                                     GROUP BY filing, layer HAVING count(*) > 1 ) d) AS doubled,
             (SELECT count(*) FROM ( :compose(layers/remainder_scope.sqlc) ) z
               WHERE z.standing IS NULL)                                             AS unclassified
         ) x
) p ON true
WHERE a.slug = 'remainder_standing'
