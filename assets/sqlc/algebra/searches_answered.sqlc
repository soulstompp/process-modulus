# Every search either filed what it found or typed why it filed nothing, and never both. One row
# per search: for couplings and for double counting, how many filings answered each way.
#
# A stated-or-absent wrapper whose stated arm is a table
#   `pm:StatedCouplings` and `asrt:StatedEliminations` are a choice like every `Stated*` wrapper,
#   but the stated arm repeats, so it lives in `coupling` and `elimination` and the search row keeps
#   only the absent arm. The `<>` CHECK every other wrapper carries cannot reach across two tables,
#   so this law is that CHECK: a search row typed absent has no entries, and one that is not has at
#   least one.
#
# Probe
#   examples/probes runs it as `searches_answered`.
#   In a rolled-back transaction, delete one fusion's eliminations while its search row says it
#   filed some: this law must fail for `double counting` alone.
-- epistemics/coupling_searches.sqlc against entries/couplings.sqlc, eliminations/searched.sqlc against eliminations/filed.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT s.subject,
           count(*) FILTER (WHERE (s.answer IS NULL) <> (s.entries > 0)) = 0 AS holds,
           format('%s searched: %s filed entries, %s typed why not, %s both or neither',
                  count(*), count(*) FILTER (WHERE s.entries > 0 AND s.answer IS NULL),
                  count(*) FILTER (WHERE s.entries = 0 AND s.answer IS NOT NULL),
                  count(*) FILTER (WHERE (s.answer IS NULL) <> (s.entries > 0))) AS detail
    FROM (
        SELECT 'couplings' AS subject, cs.answer,
               (SELECT count(*) FROM (
                    :compose(entries/couplings.sqlc)
                ) c WHERE c.filing = cs.filing) AS entries
        FROM (
            :compose(epistemics/coupling_searches.sqlc)
        ) cs
        UNION ALL
        SELECT 'double counting', es.answer,
               (SELECT count(*) FROM (
                    :compose(eliminations/filed.sqlc)
                ) e WHERE e.composition = es.composition AND e.composed_layer = es.composed_layer)
        FROM (
            :compose(eliminations/searched.sqlc)
        ) es
    ) s
    GROUP BY s.subject
) p ON true
WHERE a.slug = 'searches_answered'
