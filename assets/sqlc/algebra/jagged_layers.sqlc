# The fusions whose parts overlap, split by whether anybody filed an elimination. One row: whether
# every overlap is either unadmitted or covered by a filed elimination, counted row for row.
#
# The difference is the finding
#   queries/observations/14-jagged-layers.sqlc reports the overlap nobody admitted, which is
#   composition/jagged_layers.sqlc less the fusions that filed an elimination. Get the anti-join
#   backwards and it reports the filings that did their own cleaning up as though they had not,
#   which is the opposite accusation with the same column names and a believable count.
#
# The left operand repeats rows on the compared columns
#   One fusion can double count more than one layer, and each is its own row and its own repair, so
#   `EXCEPT` would collapse a fusion with three overlaps into one, and the observation would report
#   two fewer repairs than there are. The anti-join keeps the repeats; this law is what says so.
#
# Examining nothing on a clean corpus, correctly
#   No fusion here has overlapping parts, so all three counts are zero. The law binds the moment one
#   does, and examples/soundness runs it either way.
#
# Probe
#   File a part that a sibling already reaches; this law must still hold.
-- composition/jagged_layers.sqlc split by eliminations/filed.sqlc, repeats kept.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'composition/jagged_layers' AS subject,
           x.total = x.kept + x.removed AS holds,
           format('%s jagged rows: %s nobody admitted, %s on a fusion that filed one', 
                  x.total, x.kept, x.removed) AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(composition/jagged_layers.sqlc) ) j) AS total,
             (SELECT count(*) FROM ( :compose(composition/jagged_layers.sqlc) ) j
               WHERE NOT EXISTS (SELECT 1 FROM ( :compose(eliminations/filed.sqlc) ) e
                                  WHERE e.composition = j.filing
                                    AND e.composed_layer = j.layer))            AS kept,
             (SELECT count(*) FROM ( :compose(composition/jagged_layers.sqlc) ) j
               WHERE EXISTS (SELECT 1 FROM ( :compose(eliminations/filed.sqlc) ) e
                              WHERE e.composition = j.filing
                                AND e.composed_layer = j.layer))                AS removed
         ) x
) p ON true
WHERE a.slug = 'jagged_layers'
