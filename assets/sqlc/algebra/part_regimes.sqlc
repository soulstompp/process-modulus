# The parts whose regimes can be compared, against the ones that cannot. One row: whether every
# row of composition/part_regimes.sqlc either can be asked or cannot, counted row for row.
#
# Backwards turns the verdict over
#   The difference is the population of a rule, and getting it backwards turns the verdict over.
#   `checks/part_regime_disagrees` asks only where both sides stated a framework. The fixtures
#   declare a `stipulated` regime whose framework is `notApplicable`, because a fixture reports
#   under no framework, and their parts point at it. Those have neither agreed nor disagreed; the
#   question does not arise. Read the other way, every one of them becomes a quiet pass, and the
#   rule's count fills with rows it never asked about.
#
# The left operand has no repeated rows on the compared columns
#   `composition/part_regimes.sqlc` is one row per resolved part carrying a handle, and
#   `pm.part`'s primary key makes that a key.
-- composition/part_regimes.sqlc split by whether both sides state a framework.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'composition/part_regimes' AS subject,
           x.total = x.askable + x.unaskable AS holds,
           format('%s parts with a regime handle: %s askable, %s where a typed absence or an '
                  'unstated filing makes the question not arise',
                  x.total, x.askable, x.unaskable) AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(composition/part_regimes.sqlc) ) r) AS total,
             (SELECT count(*) FROM ( :compose(composition/part_regimes.sqlc) ) r
               WHERE r.composer_absent IS NULL AND r.frameworks_the_filing_states > 0) AS askable,
             (SELECT count(*) FROM ( :compose(composition/part_regimes.sqlc) ) r
               WHERE r.composer_absent IS NOT NULL OR r.frameworks_the_filing_states = 0) AS unaskable
         ) x
) p ON true
WHERE a.slug = 'part_regimes'
