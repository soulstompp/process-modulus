# Every remainder, worked out again from the two totals it came from. One row per layer in
# layers/remainder.sqlc: whether its remainder, its fit and its magnitude are what the definitions
# give.
#
# A law about values
#   The other laws on the roster count rows. This one compares numbers. It reads demand and
#   nameplate from layers/demand.sqlc and layers/nameplate.sqlc rather than from
#   layers/differenced_remainder.sqlc, so a pairing changed there, the lowest remainder taken
#   against the lowest demand rather than the highest, fails here instead of quietly narrowing
#   every range.
#
# What it asserts
#   - where the remainder is not worked out from parts, its lowest value is the lowest nameplate
#     less the highest demand, its most likely value the most likely nameplate less the most
#     likely demand, and its highest value the highest nameplate less the lowest demand;
#   - the remainder is in order, which pairing opposite ends owes from two claims in order;
#   - `derived_fit` is `clearance` exactly where the lowest remainder is not below zero,
#     `interference` exactly where the highest is not above zero and the lowest is below it, and
#     `transition` everywhere else;
#   - the magnitude is the remainder's size whichever way it points, at all three values, with a
#     smallest value of zero where the remainder runs from short to spare.
#
# The magnitude is written differently on purpose
#   layers/remainder.sqlc works out the magnitude's ends case by case, on whether the remainder runs
#   from short to spare. Here they are the smallest and largest size over the whole range, in one
#   expression. The two agree whenever the remainder is in order, so each checks the other, and a
#   copy of one would check nothing.
#
# A remainder worked out from parts is not the totals' difference
#   On a composed layer whose remainder composition/fused_remainders.sqlc works out, the remainder
#   comes from the parts and not from the totals, so the first clause does not apply there. The
#   other three do: they hold of any remainder, wherever it came from.
#
# Probe
#   examples/probes runs it as `crossed_remainder`. Pair `n.n_low - d.d_low` in
#   layers/differenced_remainder.sqlc. Every remainder taken from a demand that is a range, its own
#   or a part's, must fail here.
-- layers/remainder.sqlc against layers/demand.sqlc and layers/nameplate.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT r.filing || ' / ' || r.layer AS subject,
           (r.pivoted OR (r.r_low  = n.n_low  - d.d_high
                      AND r.r_mode = n.n_mode - d.d_mode
                      AND r.r_high = n.n_high - d.d_low))
           AND r.r_low <= r.r_mode AND r.r_mode <= r.r_high
           AND (r.derived_fit = 'clearance')    = (r.r_low >= 0)
           AND (r.derived_fit = 'interference') = (r.r_high <= 0 AND r.r_low < 0)
           AND (r.derived_fit = 'transition')   = (r.r_low < 0 AND r.r_high > 0)
           AND r.m_low  = greatest(r.r_low, -r.r_high, 0)
           AND r.m_mode = abs(r.r_mode)
           AND r.m_high = greatest(r.r_high, -r.r_low) AS holds,
           format('%s [%s, %s, %s] from the nameplate [%s, %s, %s] and the demand [%s, %s, %s]; '
                  '%s; its size [%s, %s, %s]',
                  CASE WHEN r.pivoted THEN 'the remainder worked out through the parts'
                       ELSE 'the remainder' END,
                  r.r_low, r.r_mode, r.r_high, n.n_low, n.n_mode, n.n_high,
                  d.d_low, d.d_mode, d.d_high, r.derived_fit, r.m_low, r.m_mode, r.m_high) AS detail
    FROM      (
        :compose(layers/remainder.sqlc)
    ) r
    JOIN      (
        :compose(layers/demand.sqlc)
    ) d ON d.filing = r.filing AND d.layer = r.layer
    JOIN      (
        :compose(layers/nameplate.sqlc)
    ) n ON n.filing = r.filing AND n.layer = r.layer
) p ON true
WHERE a.slug = 'crossed_remainder'
