# The two kinds of diligence search against the union that holds both. One row: whether the union
# has as many rows as the two added together.
#
# A check against drift
#   A `UNION ALL` of two composed relations always adds up, so this law cannot fail on the
#   operator; it fails when somebody adds a condition to the union file, drops a branch, or writes
#   a bare `UNION` and quietly removes repeats. Those are the ways a hand-written union goes wrong,
#   and none of them raises an error.
#
# Only hand-written unions get a row
#   A union the composer generates from its `ALL` directive gets no row here: the branches are
#   spliced in as written, and there is no call site to drift.
-- epistemics/searches.sqlc against the two relations it unions.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'epistemics/searches' AS subject,
           x.whole = x.couplings + x.eliminations AS holds,
           format('%s searches: %s for couplings, %s for double counting',
                  x.whole, x.couplings, x.eliminations) AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(epistemics/searches.sqlc) ) s)              AS whole,
             (SELECT count(*) FROM ( :compose(epistemics/coupling_searches.sqlc) ) c)     AS couplings,
             (SELECT count(*) FROM ( :compose(eliminations/searched.sqlc) ) e)  AS eliminations
         ) x
) p ON true
WHERE a.slug = 'searches'
