# Every quantity a part files is set beside its composed layer's or has nothing to be set beside.
# One row: whether |each part's quantities| = |those its composed layer does not file| +
# |composition/part_quantities|.
#
# The join must neither drop nor double
#   composition/part_quantities.sqlc joins each part's quantities to the composed layer's on the
#   quantity. Keyed on less than the quantity, one part quantity would pair with every quantity of
#   the composed layer and the count would pass the total; keyed on more, a pair would be lost. The
#   complement is taken by `NOT EXISTS`, a different operator from the join.
#
# Probe
#   examples/probes runs it as `part_quantities`: in the composed text the join forgets the
#   quantity, and the law must fail.
-- composition/parts.sqlc with layers/quantities.sqlc, against composition/part_quantities.sqlc and its complement.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'composition/part_quantities' AS subject,
           x.total = x.alone + x.paired AS holds,
           format('%s part quantities = %s the composed layer does not file + %s set beside it',
                  x.total, x.alone, x.paired) AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(composition/parts.sqlc) ) p
               JOIN ( :compose(layers/quantities.sqlc) ) q
                 ON q.filing = p.part_filing AND q.layer = p.part_layer)                  AS total,
             (SELECT count(*) FROM ( :compose(composition/parts.sqlc) ) p
               JOIN ( :compose(layers/quantities.sqlc) ) q
                 ON q.filing = p.part_filing AND q.layer = p.part_layer
               WHERE NOT EXISTS (SELECT 1 FROM ( :compose(layers/quantities.sqlc) ) c
                                  WHERE c.filing = p.composition AND c.layer = p.composed_layer
                                    AND c.quantity = q.quantity))                        AS alone,
             (SELECT count(*) FROM ( :compose(composition/part_quantities.sqlc) ) x)       AS paired
         ) x
) p ON true
WHERE a.slug = 'part_quantities'
