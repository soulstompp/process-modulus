# The layers whose own totals can be differenced, against the ones that keep a remainder. One row:
# whether |differenced| = |remainder| + |differenced ⋉ figureless|.
#
# Dropped only where the difference is not the remainder
#   layers/remainder.sqlc keeps every layer layers/differenced_remainder.sqlc gives it, except the
#   layers composition/figureless_remainders.sqlc names, whose crossed difference is not their
#   remainder and whose pivot is lifted. A row lost for any other reason breaks the count.
#
# Probe
#   examples/probes runs it as `remainder_in_force`: let a figureless remainder take every other
#   layer of its filing out of layers/remainder.sqlc, and the law must fail.
-- layers/differenced_remainder.sqlc partitioned by composition/figureless_remainders.sqlc into layers/remainder.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'layers/remainder' AS subject,
           x.total = x.kept + x.removed AS holds,
           format('%s differenced = %s in force + %s with no legitimate figure', x.total, x.kept,
                  x.removed) AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(layers/differenced_remainder.sqlc) ) b) AS total,
             (SELECT count(*) FROM ( :compose(layers/remainder.sqlc) ) r)             AS kept,
             (SELECT count(*) FROM ( :compose(layers/differenced_remainder.sqlc) ) b
               WHERE EXISTS (SELECT 1 FROM ( :compose(composition/figureless_remainders.sqlc) ) g
                             WHERE g.filing = b.filing AND g.layer = b.layer))  AS removed
         ) x
) p ON true
WHERE a.slug = 'remainder_in_force'
