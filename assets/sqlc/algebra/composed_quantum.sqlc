# Every composed layer with a quantum, beside whether that quantum divides what was filed. One row
# per composed layer where composition/composed_quantum.sqlc gives a number.
#
# What it asserts
#   - the composed layer's filed nameplate, at each of its three points, is a whole multiple of the
#     composed quantum at the same point;
#   - so is every nameplate elimination filed against it, at the corner it takes where the
#     nameplate is at that point.
#
# Why these two
#   The composed nameplate is the sum of the converted parts less the nameplate elimination. The
#   parts are multiples of the composed quantum by construction, so the filed total is one exactly
#   when the elimination is, and a quantum that divides neither was worked out from the wrong
#   quanta: unconverted, or in the wrong unit. Both sides are read from the filing, never from
#   composition/composed_quantum.sqlc.
#
# At each point, the elimination at its corner
#   composition/composed_quantum.sqlc works the quantum out at the low, the most likely value and
#   the high, and the law reads each point of the nameplate against the quantum at that point. The
#   elimination is read where eliminations/paired.sqlc puts it: at the nameplate's low it is at its
#   own low, unless the sum would turn over and it is read crossed, as composition/fused.sqlc
#   subtracts it. Read any other way, the law would pair one elimination a second way.
#
# What it cannot see
#   A quantum left unconverted that still divides the filed nameplate: `merge-holding-composition /
#   compute` comes to 8 without its factor, and 8 divides every point of its nameplate as well as
#   the converted quanta do.
#
# Probe
#   examples/probes runs it as `composed_quantum`. Take the largest quantum in place of `gcd` in the
#   most likely value's fold in composition/composed_quantum.sqlc. `merge-holding-composition /
#   compute` then gets 5760, which does not divide its filed 6480, and must fail.
-- composition/composed_quantum.sqlc against layers/nameplate.sqlc and eliminations/paired.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT x.composition || ' / ' || x.composed_layer AS subject,
           abs(x.n_low  - x.q_low  * round(x.n_low  / x.q_low))  < 1e-9
           AND abs(x.n_mode - x.q      * round(x.n_mode / x.q))      < 1e-9
           AND abs(x.n_high - x.q_high * round(x.n_high / x.q_high)) < 1e-9
           AND (x.e_mode IS NULL
                OR (    abs(x.e_at_low  - x.q_low  * round(x.e_at_low  / x.q_low))  < 1e-9
                    AND abs(x.e_mode    - x.q      * round(x.e_mode    / x.q))      < 1e-9
                    AND abs(x.e_at_high - x.q_high * round(x.e_at_high / x.q_high)) < 1e-9))
           AS holds,
           format('quantum %s %s against a nameplate of [%s, %s, %s]%s',
                  CASE WHEN x.spread THEN format('[%s, %s, %s]', x.q_low, x.q, x.q_high)
                       ELSE x.q::text END,
                  x.unit, x.n_low, x.n_mode, x.n_high,
                  CASE WHEN x.e_mode IS NULL THEN ''
                       ELSE format(' and an elimination of [%s, %s, %s]%s',
                                   x.e_low, x.e_mode, x.e_high,
                                   CASE WHEN x.crossed THEN ', read crossed' ELSE '' END)
                  END) AS detail
    FROM (
        SELECT c.composition, c.composed_layer, c.unit, c.spread,
               c.composed_quantum_low  AS q_low,
               c.composed_quantum      AS q,
               c.composed_quantum_high AS q_high,
               n.n_low, n.n_mode, n.n_high,
               e.low  AS e_low,
               e.mode AS e_mode,
               e.high AS e_high,
               e.at_low  AS e_at_low,
               e.at_high AS e_at_high,
               e.crossed
        FROM      (
            :compose(composition/composed_quantum.sqlc)
        ) c
        JOIN      (
            :compose(layers/nameplate.sqlc)
        ) n ON n.filing = c.composition AND n.layer = c.composed_layer
        LEFT JOIN (
            :compose(eliminations/paired.sqlc)
        ) e ON e.composition = c.composition AND e.composed_layer = c.composed_layer
           AND e.quantity = 'nameplate'
        WHERE c.composed_quantum IS NOT NULL
    ) x
) p ON true
WHERE a.slug = 'composed_quantum'
