# Every composed layer with a quantum, beside whether that quantum divides what was filed. One row
# per composed layer where composition/composed_quantum.sqlc gives a number.
#
# What it asserts
#   - the composed layer's filed nameplate is a whole multiple of `g` at its mode;
#   - so is every nameplate elimination filed against it, at its mode.
#   Proof: `src/proofs/README.md`, entry `composed_quantum`.
#
# Why these two
#   The composed nameplate is the sum of the converted parts less the nameplate elimination. The
#   parts are multiples of `g` by construction, so the filed total is one exactly when the
#   elimination is, and a `g` that divides neither was folded from the wrong quanta: unconverted,
#   or in the wrong unit. Both sides are read from the filing, never from the fold.
#
# At the mode
#   The fold reads a factor with width at its mode, so the law does too; `spread` in the relation
#   says where that reading carries the answer.
#
# What it cannot see
#   A quantum left unconverted that still divides the filed nameplate: `merge-holding-composition /
#   compute` folds to 8 without its factor, and 8 divides 6480 as well as 720 does. The page entry
#   `composed_quantum` asserts the converted fold on that layer by value.
#
# Probe
#   examples/probes runs it as `composed_quantum`.
#   Fold with `greatest` in place of `gcd` in composition/composed_quantum.sqlc.
#   `merge-holding-composition / compute` then gets 5760, which does not divide its filed 6480,
#   and must fail.
-- composition/composed_quantum.sqlc against layers/nameplate.sqlc and eliminations/filed.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT c.composition || ' / ' || c.composed_layer AS subject,
           abs(n.n_mode - c.composed_quantum * round(n.n_mode / c.composed_quantum)) < 1e-9
           AND (e.mode IS NULL
                OR abs(e.mode - c.composed_quantum * round(e.mode / c.composed_quantum)) < 1e-9)
           AS holds,
           format('quantum %s %s%s against a nameplate of %s%s',
                  c.composed_quantum, c.unit,
                  CASE WHEN c.spread THEN ', read at a factor''s mode' ELSE '' END,
                  n.n_mode,
                  CASE WHEN e.mode IS NULL THEN ''
                       ELSE format(' and an elimination of %s', e.mode) END) AS detail
    FROM      (
        :compose(composition/composed_quantum.sqlc)
    ) c
    JOIN      (
        :compose(layers/nameplate.sqlc)
    ) n ON n.filing = c.composition AND n.layer = c.composed_layer
    LEFT JOIN (
        :compose(eliminations/filed.sqlc)
    ) e ON e.composition = c.composition AND e.composed_layer = c.composed_layer
       AND e.quantity = 'nameplate'
    WHERE c.composed_quantum IS NOT NULL
) p ON true
WHERE a.slug = 'composed_quantum'
