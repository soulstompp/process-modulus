# The filed figures of every composed layer, against the sums that are not owed, checked against
# every stated demand, nameplate and draw. One row: whether every stated figure is either in
# composition/composed_quantities.sqlc or suspended, counted row for row.
#
# `kept` composes the subject
#   `kept` composes the subject rather than working it out again, and that is the point of the
#   law. Spell the anti-join out here and it governs a copy of
#   composition/composed_quantities.sqlc: change that file's WHERE and this law still
#   passes, a failure nobody would see. algebra/owed_equality.sqlc composes
#   composition/owed_equality.sqlc for the same reason.
#
# Why not `EXCEPT`
#   The left operand has no repeated rows here, so this one could be written with `EXCEPT`, and
#   must not be. The query carries the figure's three values and the eliminations beside them, and
#   `EXCEPT` returns only the columns both sides share: taking the columns first would subtract on
#   fewer of them. The anti-join is right for the columns it carries.
-- layers/summed_quantities.sqlc split by the query the roster names as this law's subject.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT 'composition/composed_quantities' AS subject,
           x.total = x.kept + x.removed AS holds,
           format('%s stated figures: %s carried, %s suspended', x.total, x.kept, x.removed)
               AS detail
    FROM ( SELECT
             (SELECT count(*) FROM ( :compose(layers/summed_quantities.sqlc) ) d
               WHERE d.low IS NOT NULL)                                              AS total,
             (SELECT count(*) FROM ( :compose(composition/composed_quantities.sqlc) ) k)
                                                                                     AS kept,
             (SELECT count(*) FROM ( :compose(layers/summed_quantities.sqlc) ) d
               WHERE d.low IS NOT NULL
                 AND EXISTS (SELECT 1 FROM ( :compose(composition/suspended_quantities.sqlc) ) s
                              WHERE s.composition = d.filing AND s.composed_layer = d.layer
                                AND s.quantity = d.quantity)) AS removed
         ) x
) p ON true
WHERE a.slug = 'composed_quantities'
