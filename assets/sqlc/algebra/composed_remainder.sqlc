# Every composed remainder worked out from the parts, against the one the composed totals give.
# One row per layer in composition/fused_remainders.sqlc: whether it is in order, equal to the
# totals' remainder at the most likely value, inside it at both ends, and equal to it at both ends
# wherever no factor on the walk is a range.
#
# What it asserts
#   With the composed layer's filed totals, the nameplate less the demand, each end against the
#   opposite end:
#   - the remainder worked out from the parts is in order;
#   - its most likely value is the most likely nameplate less the most likely demand;
#   - its lowest value is no lower, and its highest no higher, than the totals give;
#   - where no factor on the walk is a range, it equals the totals' remainder at both ends.
#   The three equalities hold only where the composed totals are their own sums, so a layer whose
#   demand or nameplate sum disagrees with its filing is held to the order and to lying inside
#   alone; checks/fusion_sum_disagrees reports the filing.
#
# Why the ends differ only when a factor is a range
#   A factor multiplies a part's nameplate and its demand together, so subtracting the converted
#   totals takes its range in twice, and working from the parts takes it once. With no range there
#   is nothing to take twice, and the two are one number. Whether a factor is a range is worked out
#   again here from composition/remainder_frontier.sqlc, not read from the relation under test.
#
# Probe
#   examples/probes runs it as `composed_remainder`. In composition/fused_remainders.sqlc read the
#   nameplate elimination at its low regardless of `crossed`.
#   `every-inverting-elimination / shift-capacity` then gives a low of 3 against the totals' 0 with
#   no factor anywhere, and must fail.
-- composition/fused_remainders.sqlc against layers/demand.sqlc, layers/nameplate.sqlc and
-- composition/remainder_frontier.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT x.subject,
           x.pivoted_low <= x.pivoted_mode AND x.pivoted_mode <= x.pivoted_high
           AND x.pivoted_low >= x.cross_low - 1e-9 AND x.pivoted_high <= x.cross_high + 1e-9
           AND (NOT x.sums_agree OR abs(x.pivoted_mode - x.cross_mode) < 1e-9)
           AND (NOT x.sums_agree OR x.spread
                OR (abs(x.pivoted_low - x.cross_low) < 1e-9
                    AND abs(x.pivoted_high - x.cross_high) < 1e-9)) AS holds,
           format('through the parts [%s, %s, %s] against the totals'' remainder [%s, %s, %s]; %s',
                  x.pivoted_low, x.pivoted_mode, x.pivoted_high,
                  x.cross_low, x.cross_mode, x.cross_high,
                  CASE WHEN NOT x.sums_agree THEN 'a composed sum disagrees with its filing'
                       WHEN x.spread THEN 'a factor on the walk has width'
                       ELSE 'no factor on the walk has width' END) AS detail
    FROM (
        SELECT r.composition || ' / ' || r.composed_layer AS subject,
               r.pivoted_low, r.pivoted_mode, r.pivoted_high,
               n.n_low  - d.d_high AS cross_low,
               n.n_mode - d.d_mode AS cross_mode,
               n.n_high - d.d_low  AS cross_high,
               EXISTS (SELECT 1 FROM ( :compose(composition/remainder_frontier.sqlc) ) w
                        WHERE w.root_filing = r.composition AND w.root_layer = r.composed_layer
                          AND w.factor_low IS DISTINCT FROM w.factor_high) AS spread,
               NOT EXISTS (SELECT 1 FROM ( :compose(composition/fused.sqlc) ) f
                            WHERE f.composition = r.composition
                              AND f.composed_layer = r.composed_layer
                              AND f.quantity IN ('demand', 'nameplate')
                              AND NOT f.agrees) AS sums_agree
        FROM      (
            :compose(composition/fused_remainders.sqlc)
        ) r
        JOIN      (
            :compose(layers/demand.sqlc)
        ) d ON d.filing = r.composition AND d.layer = r.composed_layer
        JOIN      (
            :compose(layers/nameplate.sqlc)
        ) n ON n.filing = r.composition AND n.layer = r.composed_layer
    ) x
) p ON true
WHERE a.slug = 'composed_remainder'
