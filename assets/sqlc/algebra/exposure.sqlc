# Every remainder's exposure, worked out again. One row per layer in layers/remainder.sqlc: whether
# `exposure` is the largest demand against the smallest supply, never below zero.
#
# What it asserts
#   - where the remainder is taken from the totals, the exposure is the highest demand less the
#     lowest nameplate, never below zero, from the two totals in layers/demand.sqlc and
#     layers/nameplate.sqlc;
#   - where the remainder is worked out from the parts, the exposure is how far its lowest value
#     falls below zero, from composition/fused_remainders.sqlc, so that figure is the one in force;
#   - the exposure is zero exactly where `derived_fit` is `clearance`;
#   - the exposure is no more than `m_high`: nothing can go unserved beyond the largest magnitude
#     the claims allow.
#
# Why it is a law of its own
#   layers/remainder.sqlc works out `exposure` from the lowest remainder, and
#   layers/differenced_remainder.sqlc works it out from the highest demand and the lowest
#   nameplate. The first is the figure every rule reads; the second is the definition a filer can
#   check by hand. This law is where the two are held equal, and where the figure worked out from
#   the parts is held to that.
#
# Probe
#   examples/probes runs it as `exposure`. Write `exposure` as `greatest(x.d_high - x.n_low, 0)` in
#   layers/remainder.sqlc. Every composed layer whose parts moved the lowest remainder must fail.
-- layers/remainder.sqlc against layers/demand.sqlc, layers/nameplate.sqlc and
-- composition/fused_remainders.sqlc.
SELECT a.slug AS law, p.subject, p.holds, p.detail
FROM      (
    :compose(algebra/roster.sqlc)
) a
LEFT JOIN (
    SELECT r.filing || ' / ' || r.layer AS subject,
           r.exposure = CASE WHEN r.pivoted THEN greatest(-f.pivoted_low, 0)
                             ELSE greatest(d.d_high - n.n_low, 0) END
           AND (r.exposure = 0) = (r.derived_fit = 'clearance')
           AND r.exposure <= r.m_high AS holds,
           format('exposure %s from %s; %s; the remainder''s size at most %s',
                  r.exposure,
                  CASE WHEN r.pivoted
                       THEN format('the low worked out through the parts, %s', f.pivoted_low)
                       ELSE format('the demand''s high %s against the nameplate''s low %s',
                                   d.d_high, n.n_low) END,
                  r.derived_fit, r.m_high) AS detail
    FROM      (
        :compose(layers/remainder.sqlc)
    ) r
    JOIN      (
        :compose(layers/demand.sqlc)
    ) d ON d.filing = r.filing AND d.layer = r.layer
    JOIN      (
        :compose(layers/nameplate.sqlc)
    ) n ON n.filing = r.filing AND n.layer = r.layer
    LEFT JOIN (
        :compose(composition/fused_remainders.sqlc)
    ) f ON f.composition = r.filing AND f.composed_layer = r.layer
) p ON true
WHERE a.slug = 'exposure'
