# EVERY RELATION WHOSE CORRECTNESS RESTS ON A SET-ALGEBRAIC LAW SQL WILL NOT ENFORCE. One row
# per law: a slug, the law as algebra, the relation it governs, the form it takes, and whether
# the left operand is a set or a bag on the compared attributes.
#
# ⭐⭐⭐ A DIFFERENCE FAILS TO A PLAUSIBLE TABLE, NEVER TO AN ERROR. `EXCEPT` and
#    `LEFT JOIN … IS NULL` return the right shape, the right column names and a believable count
#    when they are wrong. Written once with the parentheses misplaced, reports/integrity.sqlc
#    returned 227 rows where 0 was correct -- and 227 well-formed rows is not a thing anybody
#    reads twice. These laws are what turn "it looked fine" into an assertion.
#
# ⭐⭐ AND THE LAW IS CHECKABLE WITHOUT TOUCHING A FILE. |A ∖ B| = |A| − |A ⋉ B|, so the
#    difference and the semijoin must partition the left operand. As a manual probe that is
#    edit the template, recompose, observe, revert -- a procedure nothing repeats, and one where
#    a `sed` silently matching nothing reports a false finding. Every law below is a query
#    instead.
#
# ⛔⛔ `multiplicity` IS NOT DECORATION, AND IT IS THE COLUMN THAT COST THE MOST TO LEARN.
#    |A| = |A∖B| + |A⋉B| is a SET identity. `EXCEPT` deduplicates; the anti-join preserves the
#    left side's multiplicity. So the law's FORM depends on whether the left operand is a set on
#    the compared attributes -- and two of the differences here have a bag on the left:
#      composition/descent   more rows than keys. Its duplicates ARE the subject of
#                            checks/jagged_layer -- a layer reachable by two paths appears
#                            twice -- so rewriting leaves.sqlc as EXCEPT would erase exactly what
#                            that rule detects. ⛔ dedup would be a defect.
#      checks/all            more rows than keys on `rule`. Here the collapse is the POINT: the
#                            question is which rule NAMES appear undeclared. ✅ dedup intended.
#    ⛔ Counts are not written here; `cargo run --example soundness` prints both pairs live, and
#    the pair that stood in this block was stale by five rows and four keys when checked.
#    The SQL looks identical in both cases. Only this column tells them apart.
#
# ⛔ A ROW HERE WITH NO RELATION BEHIND IT IS A LAW NOBODY CHECKS, and a difference in the tree
#   with no row here is a guard nobody declared -- `asrt:Verdict`'s `unclaimed`. Both directions
#   are caught: the first by reports/integrity.sqlc, the second by examples/soundness.rs, which
#   walks the tree for set-difference syntax and requires every one to appear below.
-- the set-algebraic laws this tree's relations claim to obey.
SELECT * FROM (VALUES
  ('decomposition',    '|E| = Σ_filing |E_filing|',  'rank/decomposition',               'partition',  'bag: one edge counted in both scopes'),
  ('owed_equality',    '|A| = |A∖B| + |A⋉B|',        'composition/owed_equality',        'difference', 'set'),
  ('leaves',           '|A| = |A∖B| + |A⋉B|',        'composition/leaves',               'difference', 'bag: dedup would be a defect'),
  ('jagged_layers',    '|A| = |A∖B| + |A⋉B|',        'queries/observations/14-jagged-layers','difference','bag: one row per doubled layer'),
  ('composed_demand',  '|A| = |A∖B| + |A⋉B|',        'queries/matrices/3b-composed-demand','difference','set'),
  ('integrity',        '|A| = |A∖B| + |A⋉B|',        'reports/integrity',                'difference', 'bag: dedup intended'),
  ('carried',          '|A| = |A∖B| + |A⋉B|',        'composition/carried',              'difference', 'bag: anti-join preserves it'),
  ('owed_remainder',   '|A| = |A∖B| + |A⋉B|',        'composition/owed_remainder',       'difference', 'set'),
  ('settled_remainders','|A| = |A∖B| + |A⋉B|',       'composition/settled_remainders',   'difference', 'bag: one row per path'),
  ('borne',            'Σall = Σkept + Σremoved',    'entries/borne',                    'additive',   'bag: γ over holders'),
  ('arithmetic_class', 'each candidate in exactly one class', 'arithmetic/all',          'partition',  'set'),
  ('remainder_standing','each remainder in exactly one standing','layers/remainder_scope','partition',  'set'),
  ('exposure_standing', 'each exposed layer in exactly one standing','layers/exposure_scope','partition','set'),
  ('searches',         '|A ⊎ B| = |A| + |B|',        'epistemics/searches',              'union',      'bag: UNION ALL'),
  ('part_regimes',     '|A| = |A∖B| + |A⋉B|',        'checks/part_regime_disagrees',     'difference', 'set: pm.part''s key')
) AS a(slug, law, governs, form, multiplicity)
