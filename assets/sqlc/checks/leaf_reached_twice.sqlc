# EVERY (ROOT, LEAF) PAIR IN EVERY DESCENT, BESIDE HOW MANY ROUTES REACH IT. One row per
# examined pair, `violates` where more than one route arrives.
#
# ⭐⭐⭐ THE ONE NO VALIDATOR CAN SEE. At one level "no part is used twice" is an ordinary key,
#    checkable inside a single document. At two levels it becomes "no leaf is reachable by two
#    paths", and the second path runs through a document the first does not contain. A holding
#    composes a group; the group composes its members; if the holding ALSO names a member
#    directly, that member's supply enters the total twice and every figure above it is
#    inflated by exactly one supply nobody can see.
#
# ⛔ ONLY A NESTED COMPOSITION CAN DO THIS, so a single-level fusion is not examined however
#   many parts it names -- see composition/used_as_a_part.sqlc for why two levels is where the
#   question starts existing.
-- the transitive closure of pm:Fusion/pm:Part, grouped by the layer it lands on.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT l.root_filing AS filing, l.root_layer AS layer,
           count(*) > 1 AS violates,
           format('%s/%s reached %s times', l.filing, l.layer, count(*)) AS detail
    FROM (
        :compose(composition/leaves.sqlc)
    ) l
    JOIN (
        :compose(composition/used_as_a_part.sqlc)
    ) n ON n.filing = l.root_filing
    GROUP BY l.root_filing, l.root_layer, l.filing, l.layer
) p ON true
WHERE r.slug = 'leaf_reached_twice'
