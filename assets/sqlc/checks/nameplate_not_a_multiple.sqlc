# Every lumpy layer whose quantum can divide, beside whether it does. One row per examined
# layer, `violates` where any point of the nameplate is not a whole number of quanta.
#
# Supply arrives in whole units
#   The rule: supply arrives in whole units, so the nameplate is a whole multiple of the quantum.
#   Half a truck and half a licence do not exist, and a nameplate that is 2.5 quanta is either a
#   quantum filed at the wrong size or a nameplate that includes something the quantum does not
#   describe.
#
# Every point, not the mode
#   A lumpy supply can only take whole multiples, so a nameplate's low or high that is not one
#   names a value the supply cannot have, whatever its mode says. The quantum is read at its mode:
#   examples/matrices/main.rs asserts every filed quantum is a point.
#   Proof: `src/proofs/README.md`, entry `congruence`.
#
# A zero quantum is not examined
#   A quantum of zero divides nothing; see layers/divisible.sqlc.
-- pm:Nameplate/amount against pm:LumpyQuantum/size.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT d.filing, d.layer,
           abs(d.n_low  - d.quantum_mode * round(d.n_low  / d.quantum_mode)) > 1e-9
           OR abs(d.n_mode - d.quantum_mode * round(d.n_mode / d.quantum_mode)) > 1e-9
           OR abs(d.n_high - d.quantum_mode * round(d.n_high / d.quantum_mode)) > 1e-9 AS violates,
           format('a quantum of %s against a nameplate of [%s, %s, %s]',
                  d.quantum_mode, d.n_low, d.n_mode, d.n_high) AS detail
    FROM (
        :compose(layers/divisible.sqlc)
    ) d
) p ON true
WHERE r.slug = 'nameplate_not_a_multiple'
