# Every fusion part whose unit differs from the layer it is composed into, beside whether it
# files a conversion. One row per crossing, `violates` where no factor is filed at all.
#
# Crossing a unit boundary needs a conversion
#   The rule: cross a unit boundary and you must say what converts. `asrt:factor` is
#   `minOccurs="0"` and stays that way, because a part already quoted in the composed layer's
#   unit has nothing to convert and a factor of one there would be boilerplate with no author.
#   The moment the units differ that stops being true: somebody is asserting the two are
#   interchangeable, and an assertion needs a filer.
#
# Without this rule the query makes the assertion
#   `composition/converted.sqlc` reads a missing factor as one. A part crossing from `pessoas` to
#   `people`, or from `turnos por semana` to `shifts per week`, with no factor at all, makes the
#   SQL assert that a Portuguese person and an English person are one unit, on nobody's
#   authority. That is a judgement this repository has twice refused to make in a query,
#   arriving through the back door as a `coalesce`.
#
# Not an idle judgement
#   If one member counts heads and the other counts full-time equivalents, the factor is not one
#   and every composed figure above it is wrong by the difference. Filing [1, 1, 1] with a
#   `boundOrigin` and a provenance says a person checked.
#
# A typed-absent factor satisfies this rule
#   It suspends the sum instead, via `composition/unsized_conversions.sqlc`. "Somebody looked at
#   the crossing and cannot size it" is an answer; saying nothing is not.
-- asrt:Part against its composed pm:Layer's unit, per quantity they both file.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT DISTINCT x.filing, x.layer, x.violates, x.detail
    FROM (
        SELECT p.composition AS filing, p.composed_layer AS layer,
               p.factor_state = 'omitted' AS violates,
               format('the part %s/%s is quoted in %s and this layer in %s, and the conversion '
                      'is %s', p.part_filing, p.part_layer, p.part_unit, p.composed_unit,
                      CASE p.factor_state
                           WHEN 'stated'     THEN 'filed'
                           WHEN 'absent'     THEN format('filed as `%s`', p.factor_absent)
                           WHEN 'derivation' THEN format('filed as the output of `%s`', p.factor_derivation)
                           WHEN 'omitted'    THEN 'NOT FILED, so a reader supplies one' END) AS detail
        FROM (
            :compose(composition/part_quantities.sqlc)
        ) p
        WHERE p.part_unit IS DISTINCT FROM p.composed_unit
    ) x
) p ON true
WHERE r.slug = 'unit_crossing_without_a_factor'
