# EVERY HOLDER FILED AGAINST A LAYER WHOSE FIT IS CLEARANCE, BESIDE WHETHER THAT HOLDER IS
# ONE OF THE TWO THAT CANNOT BE THERE. One row per examined holder, `violates` on a
# `customer` or `unrealised`.
#
# ⭐⭐ THE RULE: a clearance fit rules out customer and unrealised. Clearance means the
#    nameplate is above demand ACROSS THE WHOLE RANGE -- so there is no unmet demand anywhere
#    in it for somebody to have gone without. Naming one of those holders is a document
#    contradicting its own classification.
#
# ⛔ A CLEARANCE LAYER WITH NO HOLDERS AT ALL IS NOT EXAMINED. The rule needs a holder row to
#   look at, so counting those layers would inflate the denominator with rows the join never
#   reaches.
-- pm:Remainder/sign = clearance against pm:HolderKind customer/unrealised.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT r.filing, r.layer,
           u.kind IS NOT NULL AS violates,
           format('%s holder under a clearance fit', h.kind) AS detail
    FROM      (
        :compose(layers/remainder.sqlc)
    ) r
    JOIN      (
        :compose(entries/holders.sqlc)
    ) h USING (filing, layer)
    LEFT JOIN (
        :compose(entries/unserved_holders.sqlc)
    ) u USING (filing, layer, kind)
    WHERE r.sign = 'clearance'
) p ON true
WHERE r.slug = 'clearance_with_unserved'
