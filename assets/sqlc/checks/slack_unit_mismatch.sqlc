# Every slack/share pair that states both units, beside whether they match. One row per examined
# pair, `violates` where they differ.
#
# A slack is in the unit of the shares it bounds
#   The rule: a slack is expressed in the unit of the shares it bounds. An inequality between two
#   numbers in different units is not a failing comparison, it is a meaningless one, so this is
#   the precondition that makes checks/share_exceeds_slack.sqlc mean anything at all.
-- the slack claims and pm:Remainder/pm:holder claims, each carrying its own unit.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT c.filing, c.layer,
           c.slack_unit <> c.share_unit AS violates,
           format('slack in %s, shares in %s', c.slack_unit, c.share_unit) AS detail
    FROM (
        :compose(entries/comparable_slack_shares.sqlc)
    ) c
) p ON true
WHERE r.slug = 'slack_unit_mismatch'
