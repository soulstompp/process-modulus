# EVERY SUPPLY WITH NOWHERE TO PUT ITS EXCESS AND DEMAND NOBODY COULD SERVE, BESIDE WHETHER
# ANYBODY IS NAMED AS HAVING GONE WITHOUT. One row per examined layer, `violates` where no unserved
# holder appears.
#
# ⭐⭐⭐ THE RULE, AND THE ARGUMENT IS ENTIRELY IN THE WORD "EVERY". If every buffer was
#    accounted for and none of them had room, the excess above the nameplate CANNOT have been
#    absorbed by running hot, by drawing on stock or by making the demand wait. There was
#    nowhere to go, so it went unserved and somebody has to be named as having gone without.
#    ONE UNMEASURED BUFFER LICENSES NONE OF THIS, whatever the other two say, because nobody
#    knows what that route could have taken. layers/exposure_scope.sqlc classifies all three
#    standings; this rule reads the one that concludes anything.
#
# ⛔ THE VIOLATION IS AN ANTI-JOIN AGAINST entries/unserved_holders.sqlc, which the clearance
#   check semi-joins and the exposure check sums. One relation, three readings.
-- every slack on the layer accounted for and empty, against pm:HolderKind customer/unrealised.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT c.filing, c.layer,
           u.filing IS NULL AS violates,
           format('%s could not be served and no holder says so', c.exposure) AS detail
    FROM (
        SELECT e.filing, e.layer, e.exposure
        FROM (
            :compose(layers/unabsorbed_exposure.sqlc)
        ) e
        WHERE e.exposure > 1e-9
    ) c
    LEFT JOIN ( SELECT DISTINCT filing, layer
                FROM (
                    :compose(entries/unserved_holders.sqlc)
                ) h ) u USING (filing, layer)
) p ON true
WHERE r.slug = 'nobody_named_as_unserved'
