# Every part a filing draws from its own stack, beside whether that layer is actually there. One
# row per local part, `violates` where it names a layer this document does not have.
#
# A local part names a layer in its own stack
#   A foreign part pointing at nothing is unresolvable and forgivable: the other document may
#   simply not be in this corpus. A local one pointing at nothing is a document contradicting
#   itself inside a single file, with everything it needs to notice sitting right there.
#
# Why this is a query
#   XSD 1.0 cannot make a keyref conditional on another field's value. `composedLayerName` cannot
#   be pointed at "the local stack, but only when the notation matches mine".
-- asrt:Part whose pm:ForeignId/notation is its own composition's, against pm.layer.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT p.composition AS filing, p.composed_layer AS layer,
           l.layer IS NULL AS violates,
           format('local part `%s` is not a layer of this filing', p.part_layer) AS detail
    FROM      (
        :compose(composition/local_parts.sqlc)
    ) p
    LEFT JOIN (
        :compose(layers/every_layer.sqlc)
    ) l ON l.filing = p.composition AND l.layer = p.part_layer
) p ON true
WHERE r.slug = 'local_part_dangles'
