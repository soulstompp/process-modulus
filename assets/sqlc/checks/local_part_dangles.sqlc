# EVERY PART A FILING DRAWS FROM ITS OWN STACK, BESIDE WHETHER THAT LAYER IS ACTUALLY THERE.
# One row per local part, `violates` where it names a layer this document does not have.
#
# ⭐⭐ THE RULE: a local part names a layer in its own stack. A FOREIGN part pointing at
#    nothing is unresolvable and forgivable -- the other document may simply not be in this
#    corpus. A LOCAL one pointing at nothing is a document contradicting itself inside a single
#    file, with everything it needs to notice sitting right there.
#
# ⛔ XSD 1.0 CANNOT MAKE A KEYREF CONDITIONAL ON ANOTHER FIELD'S VALUE, which is why this is a
#   query. `composedLayerName` cannot be pointed at "the local stack, but only when the
#   notation matches mine".
-- pm:Part whose pm:ForeignId/notation is its own composition's, against pm.layer.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT p.composition AS filing, p.composed_layer AS layer,
           l.layer IS NULL AS violates,
           format('local part `%s` is not a layer of this filing', p.part_layer) AS detail
    FROM      (
        :compose(composition/local_parts.sqlc)
    ) p
    LEFT JOIN pm.layer l ON l.filing = p.composition AND l.layer = p.part_layer
) p ON true
WHERE r.slug = 'local_part_dangles'
