# EVERY PART A FILING DRAWS FROM ITS OWN STACK, BESIDE WHETHER IT SITS ON A LOOP. One row per
# local part, `violates` where following local parts from that layer returns to it.
#
# ⭐⭐⭐ THE RULE: local parts do not cycle. Layer A composed from B while B is composed from A
#    is a document with no arithmetic in it -- every figure depends on itself, and a reader
#    that tries to evaluate it does not stop. XSD 1.0 cannot see this at all: it cannot make a
#    keyref conditional on another field's value, let alone follow one transitively.
#
# ⭐ THE DETAIL CARRIES THE ROUTE THAT CLOSED THE LOOP, so a filer is told which edge to break.
#   See composition/local_cycles.sqlc for how the walk terminates.
-- pm:Part with a local pm:ForeignId; conformance rule "local parts do not cycle".
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT p.composition AS filing, p.composed_layer AS layer,
           c.filing IS NOT NULL AS violates,
           coalesce(format('`%s` closes a loop through local parts: %s', c.root, c.route),
                    format('`%s` reaches only downward', p.composed_layer)) AS detail
    FROM      (
        :compose(composition/local_parts.sqlc)
    ) p
    LEFT JOIN (
        :compose(composition/local_cycles.sqlc)
    ) c
           ON c.filing = p.composition AND c.root = p.composed_layer
) p ON true
WHERE r.slug = 'local_cycle'
