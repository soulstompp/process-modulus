# Every part reference as filed, beside whether it lands on anything. One row per part,
# `violates` where the notation or the layer resolves to nothing.
#
# A part reference resolves
#   The rule: a part reference resolves to a filing that is here, and to a layer in it. This is a
#   foreign key across documents, which is why no grammar can enforce it: XSD 1.0 cannot follow
#   a cross-document reference, so it never had to resolve one.
#
# Checkable only because a reader asserted the mapping
#   It is only checkable because a reader asserted the notation-to-document mapping. Without a
#   filing declaring its own notation, a part reference cannot be resolved from the corpus even
#   in principle, and this conformance rule would presuppose a lookup the model does not
#   provide. Writing the query is what makes that visible.
#
# A difference between two named relations
#   The violation is every part, minus the parts that resolve. An anti-join, not a NOT EXISTS,
#   because "the parts that resolve" is the object with a life of its own and this rule is what
#   falls out of it.
-- asrt:Part/pm:ForeignId against pm.filing_identity and pm.layer.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT a.composition AS filing, a.composed_layer AS layer,
           r.composition IS NULL AS violates,
           format('%s / %s resolves to nothing', a.part_filing, a.part_layer) AS detail
    FROM      (
        :compose(composition/part_references.sqlc)
    ) a
    LEFT JOIN (
        :compose(composition/parts.sqlc)
    ) r
           ON r.composition    = a.composition
          AND r.composed_layer = a.composed_layer
          AND r.part_notation  = a.part_filing
          AND r.part_layer     = a.part_layer
) p ON true
WHERE r.slug = 'unresolved_part'
