# Every time slack filed as a `clearance` derivation, beside whether its window licenses it. One row
# per examined slack, `violates` where nothing licenses it.
#
# A derived slack needs a licensing window
#   The rule: a derived time slack needs a window that permits the derivation. The slack is the
#   clearance, and reading it as a wait, `q / clearance`, spreads the spare evenly across the
#   denominator; a stated window says it is concentrated instead, and `unmeasured` says nobody
#   knows: an assumption wearing a computation's clothes. Proof: `src/proofs/README.md`, entry
#   `duty_cycle`.
#
# An anti-join against the positive statement
#   The check is an anti-join against layers/derivation_licensed.sqlc, which is the positive
#   statement of the same thing and the one worth reading: exactly two reasons license it, "it
#   runs the whole period" and "the question has no denominator". Two answers, not two
#   documents; most layers in this corpus file one of them.
-- pm:Layer/pm:timeSlack filed as a clearance derivation, against pm:Divisibility/pm:window.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT d.filing, d.layer,
           lic.filing IS NULL AS violates,
           format('timeSlack is the `clearance` and the window is %s',
                  coalesce(d.window_absent::text,
                           format('%s %s', d.window_low, d.window_unit))) AS detail
    FROM      (
        :compose(entries/derived_time_slacks.sqlc)
    ) d
    LEFT JOIN (
        :compose(layers/derivation_licensed.sqlc)
    ) lic USING (filing, layer)
) p ON true
WHERE r.slug = 'derived_slack_over_a_window'
