# Every lumpy layer, beside whether its quantum is in the same unit as the nameplate it divides.
# One row per lumpy layer that states its nameplate and its quantum's size, `violates` where they
# differ.
#
# A size filed absent is outside the question
#   A supply may come in lumps of a size nobody measured, and `LumpyQuantum/size` files that as a
#   typed absence. There is then no unit to compare, so the layer is not in the population; read
#   as `IS DISTINCT FROM` against a NULL unit, it would be accused of a mismatch it cannot have.
#
# A quantum is in the nameplate's unit
#   The rule: a quantum is expressed in the unit of the nameplate it divides. "Is the nameplate a
#   whole multiple of the quantum?" is a division, and a division across units is not a wrong
#   answer, it is not an answer.
-- pm:LumpyQuantum/size unit against pm:Nameplate/amount unit.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT l.filing, l.layer,
           l.quantum_unit IS DISTINCT FROM l.amount_unit AS violates,
           format('quantum in %s, nameplate in %s', l.quantum_unit, l.amount_unit) AS detail
    FROM (
        :compose(layers/lumpy.sqlc)
    ) l
    WHERE l.quantum_low IS NOT NULL
) p ON true
WHERE r.slug = 'quantum_unit_mismatch'
