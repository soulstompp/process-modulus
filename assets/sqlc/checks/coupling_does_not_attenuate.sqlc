# Every coupling that survives a fusion, beside the ceiling its part's share puts on it. One row
# per examined coupling, `violates` where the upper filing claims more movement than the lower
# one can support.
#
# A coupling attenuates through a fusion
#   The rule: a coupling attenuates through a fusion, bounded by the part's share. The dependence
#   survives composition but weakens, because the composed layer is only partly the coupled part:
#   at most that part's share of it can move. The ceiling is arithmetic over three documents,
#   which is what makes it uncheckable anywhere but here. The share is the part's nameplate over
#   the composed layer's, read at its largest; composition/attenuated.sqlc says why.
#
# Read the row count, not the verdict
#   Run this alone and read the row count. It is tiny on this corpus, because few filings state
#   any coupling at all, one of those has no parts, and no fixture states one. That is a fact
#   about who wrote what, not about the world, and it is exactly what a coverage table is for.
-- pm:Coupling at two levels related through asrt:Fusion/asrt:Part; see composition/attenuated.sqlc.
SELECT r.rule, p.filing, p.layer, p.violates, p.detail
FROM      (
    :compose(checks/roster.sqlc)
) r
LEFT JOIN (
    SELECT a.upper_filing AS filing, a.from_layer AS layer,
           coalesce(a.low  > a.ceil_low  + 1e-9, false)
        OR coalesce(a.mode > a.ceil_mode + 1e-9, false)
        OR coalesce(a.high > a.ceil_high + 1e-9, false) AS violates,
           format('%s->%s files [%s, %s, %s]; %s''s coupling at a share of at most %s caps it at [%s, %s, %s]',
                  a.from_layer, a.to_layer, a.low, a.mode, a.high, a.lower_filing,
                  round(a.share, 3), round(a.ceil_low, 3), round(a.ceil_mode, 3),
                  round(a.ceil_high, 3)) AS detail
    FROM (
        :compose(composition/attenuated.sqlc)
    ) a
) p ON true
WHERE r.slug = 'coupling_does_not_attenuate'
