-- Load assets/corpus/*.xml into the relations declared by assets/ddl/schema.ddl.
#
# Run this from the repository root
#     psql -f assets/sql/ingest.sql
#   The `\set` lines below run `cat` on the client, so the paths are relative to wherever you
#   invoked psql. Nothing here needs superuser and nothing reads a file from the server, which is
#   the point: no Rust, no extensions, no setup.
#
# Every document lands in one `source` table first
#   Every extraction below reads from there. So exactly one place in this file touches the
#   filesystem, and the rest is ordinary SQL you can run again without re-reading anything.

SET search_path TO pm, public;

BEGIN;

TRUNCATE source, elimination, elimination_search, part, coupling, coupling_search,
         induction, draw, operation, holder, slack, nameplate, layer, regime,
         narrowing, bound_origin, claim, absence, stack_scope, fusion, filing CASCADE;

# The one load not about a subject
#   `public.compose_edge` is the one thing loaded here that is not about a subject: this
#   repository's own compose DAG, generated by `examples/compositions/main.rs` from the source tree
#   and tracked, so a fresh clone has it and this line needs nothing to have been run first. It is
#   outside schema `pm` for the reason its own DDL comment gives: everything in `pm` descends from a
#   filed document, and the DAG is a fact about these queries rather than about anybody's business.
#
# It can go stale
#   That is what loading a generated artifact costs. `examples/soundness/main.rs` holds the
#   staleness law: what loaded here must equal what the source tree has. It shares the scanner,
#   so it catches the artifact drifting and not the scanner.
-- assets/dag/edges.sql, generated by examples/compositions/main.rs; the compose DAG as a relation.
\i assets/dag/edges.sql

\set d `cat assets/corpus/enterprise-contract.xml`
INSERT INTO source VALUES ('enterprise-contract', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/corpus/contrato-empresarial.xml`
INSERT INTO source VALUES ('contrato-empresarial', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/corpus/refutation.xml`
INSERT INTO source VALUES ('refutation', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/corpus/unstated.xml`
INSERT INTO source VALUES ('unstated', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/corpus/merge-us-member.xml`
INSERT INTO source VALUES ('merge-us-member', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/corpus/merge-pt-member.xml`
INSERT INTO source VALUES ('merge-pt-member', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/corpus/merge-group-composition.xml`
INSERT INTO source VALUES ('merge-group-composition', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/corpus/merge-holding-composition.xml`
INSERT INTO source VALUES ('merge-holding-composition', XMLPARSE(DOCUMENT :'d'));

# The stipulations
#   Loaded because the rules must run on them, which is what a fixture is for, and marked so the
#   reports can exclude them. `every-local-part` is the only document in either directory that
#   exercises a local part, so without it the recursive descent below never walks one.
-- The stipulations.
\set d `cat assets/fixtures/every-absence.xml`
INSERT INTO source VALUES ('every-absence', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-unserved-excess.xml`
INSERT INTO source VALUES ('every-unserved-excess', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-elimination.xml`
INSERT INTO source VALUES ('every-elimination', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-local-part.xml`
INSERT INTO source VALUES ('every-local-part', XMLPARSE(DOCUMENT :'d'));

\set d `cat assets/fixtures/every-partial-elimination.xml`
INSERT INTO source VALUES ('every-partial-elimination', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-inverting-elimination.xml`
INSERT INTO source VALUES ('every-inverting-elimination', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-derived-elimination.xml`
INSERT INTO source VALUES ('every-derived-elimination', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-unsized-conversion.xml`
INSERT INTO source VALUES ('every-unsized-conversion', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-unit-cycle.xml`
INSERT INTO source VALUES ('every-unit-cycle', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-nested-conversion.xml`
INSERT INTO source VALUES ('every-nested-conversion', XMLPARSE(DOCUMENT :'d'));
\set d `cat assets/fixtures/every-derived-quantity.xml`
INSERT INTO source VALUES ('every-derived-quantity', XMLPARSE(DOCUMENT :'d'));

-- ---------------------------------------------------------------------------
-- Filings.
-- ---------------------------------------------------------------------------
# `kind` is the document's own root element
#   Not a substring match on a namespace prefix. A prefix is the sender's lexical choice (`asrt:`
#   is a habit, not a fact), so a composition that bound the assertion namespace to any other
#   letter would land here as a plain filing, silently, if this read a prefix. `local-name()`
#   reads what the document declares. Five roots are declared across the two schemas;
#   epistemics/documents.sqlc lists them.
#
# `evidence` reads an element, not a `LIKE`
#   There is no second `LIKE`. Matching `A STIPULATION, NOT A FILING` as a substring over the whole
#   serialised body is what you write when no element carries the fact, and it is wrong twice over:
#   English-only in a repository with a Portuguese edition, and true of any corpus document that
#   merely quoted the phrase. `pm:StatedEvidence` is the element, and this reads it on the
#   descendant axis for the same reason `notation` is read that way: a composition declares it on
#   the filing it embeds, one level down.
#
# An assertion's own provenance
#   Read from the root and nowhere else: `asrt:provenance` is a child of the composition itself,
#   and the `pm:provenance` of a claim inside it is the claim's, which `claim` reads.
INSERT INTO filing (name, kind, evidence, evidence_absent,
                    prov_party, prov_entered_by, prov_approved_by,
                    prov_standing_taxonomy, prov_standing_value, prov_standing_absent, prov_note)
SELECT s.name,
       x.root,
       x.attests,
       x.absent::absence_reason,
       x.prov_party, x.prov_entered, x.prov_approved,
       x.prov_st_tax, x.prov_st_val, x.prov_st_absent::absence_reason, x.prov_note
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm,
                            'https://example.invalid/assertion/1.0' AS asrt),
       '/*' PASSING s.body
       COLUMNS root    text PATH 'local-name(.)',
               attests text PATH '//pm:attests',
               absent  text PATH '(//pm:evidence|//asrt:evidence)/pm:absent/pm:reason',
               prov_party     text PATH 'asrt:provenance/pm:party',
               prov_entered   text PATH 'asrt:provenance/pm:enteredBy',
               prov_approved  text PATH 'asrt:provenance/pm:approvedBy',
               prov_st_tax    text PATH 'asrt:provenance/pm:standing/pm:term/pm:taxonomy',
               prov_st_val    text PATH 'asrt:provenance/pm:standing/pm:term/pm:value',
               prov_st_absent text PATH 'asrt:provenance/pm:standing/pm:absent/pm:reason',
               prov_note      text PATH 'asrt:provenance/pm:note') x;

# `FOR ORDINALITY` keeps two regimes two rows
#   It is what makes the two regimes in `refutation` two rows rather than a collision. Document
#   order is the only thing distinguishing them.
#
# Both halves of each borrowed term
#   And both branches of each `StatedBorrowedTerm`. The value alone is the ambiguous half, `S` is
#   not a framework, and reading only `pm:term` once turned `unmeasured` and `none` into the same
#   NULL on the fixture named `unstated`.
-- pm:Regime, in document order.
INSERT INTO regime
SELECT s.name, x.seq, x.id, x.jurisdiction,
       x.f_taxonomy, x.f_value, x.f_absent::absence_reason,
       x.c_taxonomy, x.c_value, x.c_absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:regime' PASSING s.body
       COLUMNS seq          FOR ORDINALITY,
               id           text PATH 'pm:id',
               jurisdiction text PATH 'pm:jurisdiction',
               f_taxonomy   text PATH 'pm:framework/pm:term/pm:taxonomy',
               f_value      text PATH 'pm:framework/pm:term/pm:value',
               f_absent     text PATH 'pm:framework/pm:absent/pm:reason',
               c_taxonomy   text PATH 'pm:chart/pm:term/pm:taxonomy',
               c_value      text PATH 'pm:chart/pm:term/pm:value',
               c_absent     text PATH 'pm:chart/pm:absent/pm:reason') x;

# The composer's own declarations about its parts' regimes
#   `asrt:regime` at the root of a composition, the same `pm:Regime` shape as above and a
#   different fact with a different author. Part handles point into these, which is why they are
#   loaded.
-- asrt:regime at the root of a composition.
INSERT INTO composition_regime
SELECT s.name, x.seq, x.id, x.jurisdiction,
       x.f_taxonomy, x.f_value, x.f_absent::absence_reason,
       x.c_taxonomy, x.c_value, x.c_absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0'      AS pm,
                            'https://example.invalid/assertion/1.0' AS asrt),
       '/asrt:composition/asrt:regime' PASSING s.body
       COLUMNS seq          FOR ORDINALITY,
               id           text PATH 'pm:id',
               jurisdiction text PATH 'pm:jurisdiction',
               f_taxonomy   text PATH 'pm:framework/pm:term/pm:taxonomy',
               f_value      text PATH 'pm:framework/pm:term/pm:value',
               f_absent     text PATH 'pm:framework/pm:absent/pm:reason',
               c_taxonomy   text PATH 'pm:chart/pm:term/pm:taxonomy',
               c_value      text PATH 'pm:chart/pm:term/pm:value',
               c_absent     text PATH 'pm:chart/pm:absent/pm:reason') x;

# Read out of the document, never guessed
#   Each filing's identity is read out of the document, like every other fact in this file, and
#   never as `'the reader, from the filename'`. A filing says which filing it is; nothing here
#   guesses. Without these rows every part reference dangles, and they are the reason the
#   composition queries resolve at all.
#
# Both arms, one row per filing
#   A filing that declines to name itself files the notation absent, and that row is kept: the
#   reason is the answer, and a filter on the stated arm once dropped it before it arrived.
-- pm:processModulus/pm:notation: the filing, about itself.
INSERT INTO filing_identity
SELECT s.name, x.uri, 'the filing, about itself', x.absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:processModulus/pm:notation' PASSING s.body
       COLUMNS uri    text PATH 'pm:uri',
               absent text PATH 'pm:absent/pm:reason') x;

-- How much of the system each stack holds.
INSERT INTO stack_scope
SELECT s.name, x.extent, x.basis, x.absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:scope' PASSING s.body
       COLUMNS extent text PATH 'pm:scope/pm:extent',
               basis  text PATH 'pm:scope/pm:basis',
               absent text PATH 'pm:absent/pm:reason') x
WHERE s.name IN (SELECT name FROM filing);

-- ---------------------------------------------------------------------------
-- Layers.
-- ---------------------------------------------------------------------------
# The descendant axis, on purpose
#   `//pm:stack/pm:layer` uses the descendant axis: a plain filing has the stack at the root and a
#   composition has it one level down, and the descendant axis reads both without a branch.
#
# The demand mirror, `p_*`
#   `pm:Divisibility` files the time axis as half and names `Layer/timeSlack` as where the other
#   half goes "if demand ever gains structure". It has. A patience is a duration and a slack is
#   quoted in the layer's unit, so these are two columns and not one: they coincide numerically
#   only where the layer's unit is service time.
#
# The second branch of `StatedRemainder`, `r_absent` and `r_note`
#   Every layer must carry the wrapper; a layer that denies having a remainder files
#   `pm:remainder/pm:absent` instead of `pm:remainder/pm:remainder`, and that denial is a filed
#   counter-example to the model's own claim. Reading only the first branch erases it: without
#   these two paths it arrives as five NULLs and reads as a document that said nothing. The note
#   is taken as well because it carries the argument.
#
# Both branches of the absorber, `absorber_absent`
#   The absorber is a `StatedBorrowedTerm` too, so a filed remainder may name a buffer or say
#   that none took it. Reading only `pm:term` turned that answer into the two NULLs of a
#   remainder that never mentioned its absorber.
INSERT INTO layer
SELECT s.name, x.name,
       x.d_low, x.d_mode, x.d_high, x.d_unit, x.d_absent::absence_reason, x.d_derivation::identity,
       x.p_low, x.p_mode, x.p_high, x.p_unit, x.p_absent::absence_reason,
       x.r_absent::absence_reason, x.r_note,
       x.sign::fit, x.sign_absent::absence_reason, x.sign_derivation::identity,
       x.absorber_taxonomy, x.absorber_value, x.absorber_absent::absence_reason,
       x.q_low, x.q_mode, x.q_high, x.q_unit, x.q_absent::absence_reason, x.q_derivation::identity
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:layer' PASSING s.body
       COLUMNS
         name     text    PATH 'pm:name',
         d_low    numeric PATH 'pm:demand/pm:amount/pm:claim/pm:low',
         d_mode   numeric PATH 'pm:demand/pm:amount/pm:claim/pm:mostLikely',
         d_high   numeric PATH 'pm:demand/pm:amount/pm:claim/pm:high',
         d_unit   text    PATH 'pm:demand/pm:amount/pm:claim/pm:unit',
         d_absent text    PATH 'pm:demand/pm:amount/pm:absent/pm:reason',
         d_derivation text PATH 'pm:demand/pm:amount/pm:derivation/pm:identity',
         p_low    numeric PATH 'pm:demand/pm:patience/pm:claim/pm:low',
         p_mode   numeric PATH 'pm:demand/pm:patience/pm:claim/pm:mostLikely',
         p_high   numeric PATH 'pm:demand/pm:patience/pm:claim/pm:high',
         p_unit   text    PATH 'pm:demand/pm:patience/pm:claim/pm:unit',
         p_absent text    PATH 'pm:demand/pm:patience/pm:absent/pm:reason',
         r_absent text PATH 'pm:remainder/pm:absent/pm:reason',
         r_note   text PATH 'pm:remainder/pm:absent/pm:note',
         sign        text PATH 'pm:remainder/pm:remainder/pm:sign/pm:fit',
         sign_absent text PATH 'pm:remainder/pm:remainder/pm:sign/pm:absent/pm:reason',
         sign_derivation text PATH 'pm:remainder/pm:remainder/pm:sign/pm:derivation/pm:identity',
         absorber_taxonomy text PATH 'pm:remainder/pm:remainder/pm:absorber/pm:term/pm:taxonomy',
         absorber_value    text PATH 'pm:remainder/pm:remainder/pm:absorber/pm:term/pm:value',
         absorber_absent   text PATH 'pm:remainder/pm:remainder/pm:absorber/pm:absent/pm:reason',
         q_low    numeric PATH 'pm:remainder/pm:remainder/pm:quantity/pm:claim/pm:low',
         q_mode   numeric PATH 'pm:remainder/pm:remainder/pm:quantity/pm:claim/pm:mostLikely',
         q_high   numeric PATH 'pm:remainder/pm:remainder/pm:quantity/pm:claim/pm:high',
         q_unit   text    PATH 'pm:remainder/pm:remainder/pm:quantity/pm:claim/pm:unit',
         q_absent text    PATH 'pm:remainder/pm:remainder/pm:quantity/pm:absent/pm:reason',
         q_derivation text PATH 'pm:remainder/pm:remainder/pm:quantity/pm:derivation/pm:identity') x;

-- ---------------------------------------------------------------------------
-- Nameplates. Wide: these are attributes of one supply, not matrix entries.
-- ---------------------------------------------------------------------------
# Divisibility by presence, not value
#   `continuous` carries a `premium` rather than a size, because a continuous supply has no
#   quantum and that is a different thing from a quantum of zero. So the test, `n_continuous`
#   against `n_divisibility`, is whether the element is there at all.
INSERT INTO nameplate
SELECT s.name, x.layer, x.label,
       x.a_low, x.a_mode, x.a_high, x.a_unit, x.a_absent::absence_reason, x.a_derivation::identity,
       x.a_origin::constraint_origin, x.a_origin_absent::absence_reason,
       CASE WHEN x.n_divisibility = 0 THEN NULL ELSE x.n_continuous = 0 END,
       x.div_absent::absence_reason,
       x.k_low, x.k_mode, x.k_high, x.k_unit, x.k_absent::absence_reason, x.k_origin::constraint_origin,
       x.w_low, x.w_mode, x.w_high, x.w_unit, x.w_size_absent::absence_reason,
       x.w_origin::constraint_origin,
       x.w_absent::absence_reason,
       x.dr_low, x.dr_mode, x.dr_high, x.dr_unit, x.dr_absent::absence_reason,
       x.dr_derivation::identity,
       x.mb_contributed, x.mb_taxonomy, x.mb_value, x.mb_absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:layer' PASSING s.body
       COLUMNS
         layer    text PATH 'pm:name',
         label    text PATH 'pm:supply/pm:label',
         a_low    numeric PATH 'pm:supply/pm:nameplate/pm:amount/pm:claim/pm:low',
         a_mode   numeric PATH 'pm:supply/pm:nameplate/pm:amount/pm:claim/pm:mostLikely',
         a_high   numeric PATH 'pm:supply/pm:nameplate/pm:amount/pm:claim/pm:high',
         a_unit   text    PATH 'pm:supply/pm:nameplate/pm:amount/pm:claim/pm:unit',
         a_absent text    PATH 'pm:supply/pm:nameplate/pm:amount/pm:absent/pm:reason',
         a_derivation text PATH 'pm:supply/pm:nameplate/pm:amount/pm:derivation/pm:identity',
         a_origin text    PATH 'pm:supply/pm:nameplate/pm:amountOrigin/pm:origin',
         a_origin_absent text PATH 'pm:supply/pm:nameplate/pm:amountOrigin/pm:absent/pm:reason',
         n_nameplate  numeric PATH 'count(pm:supply/pm:nameplate)',
         n_continuous numeric PATH 'count(pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:continuous)',
         n_divisibility numeric PATH 'count(pm:supply/pm:nameplate/pm:divisibility/pm:divisibility)',
         div_absent text PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:absent/pm:reason',
         k_low    numeric PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:lumpy/pm:size/pm:claim/pm:low',
         k_mode   numeric PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:lumpy/pm:size/pm:claim/pm:mostLikely',
         k_high   numeric PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:lumpy/pm:size/pm:claim/pm:high',
         k_unit   text    PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:lumpy/pm:size/pm:claim/pm:unit',
         k_absent text    PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:lumpy/pm:size/pm:absent/pm:reason',
         k_origin text    PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:lumpy/pm:origin',
         w_low    numeric PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:window/pm:quantum/pm:size/pm:claim/pm:low',
         w_mode   numeric PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:window/pm:quantum/pm:size/pm:claim/pm:mostLikely',
         w_high   numeric PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:window/pm:quantum/pm:size/pm:claim/pm:high',
         w_unit   text    PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:window/pm:quantum/pm:size/pm:claim/pm:unit',
         w_size_absent text PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:window/pm:quantum/pm:size/pm:absent/pm:reason',
         w_origin text    PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:window/pm:quantum/pm:origin',
         w_absent text    PATH 'pm:supply/pm:nameplate/pm:divisibility/pm:divisibility/pm:window/pm:absent/pm:reason',
         dr_low   numeric PATH 'pm:supply/pm:jagged/pm:draw/pm:claim/pm:low',
         dr_mode  numeric PATH 'pm:supply/pm:jagged/pm:draw/pm:claim/pm:mostLikely',
         dr_high  numeric PATH 'pm:supply/pm:jagged/pm:draw/pm:claim/pm:high',
         dr_unit  text    PATH 'pm:supply/pm:jagged/pm:draw/pm:claim/pm:unit',
         dr_absent text   PATH 'pm:supply/pm:jagged/pm:draw/pm:absent/pm:reason',
         dr_derivation text PATH 'pm:supply/pm:jagged/pm:draw/pm:derivation/pm:identity',
         mb_contributed text PATH 'pm:supply/pm:jagged/pm:measurementBasis/pm:basis/pm:contributed',
         mb_taxonomy text PATH 'pm:supply/pm:jagged/pm:measurementBasis/pm:basis/pm:borrowed/pm:taxonomy',
         mb_value    text PATH 'pm:supply/pm:jagged/pm:measurementBasis/pm:basis/pm:borrowed/pm:value',
         mb_absent   text PATH 'pm:supply/pm:jagged/pm:measurementBasis/pm:absent/pm:reason') x
WHERE x.layer IN (SELECT layer FROM layer WHERE filing = s.name)
  AND x.n_nameplate > 0;   -- `Facility` requires a nameplate; this keeps an invalid document from filing a row of NULLs

-- ---------------------------------------------------------------------------
-- S, tall. Three inserts, one per buffer, and the union is the L x 3 matrix.
-- ---------------------------------------------------------------------------
# Two on the supply, one on the layer
#   Two of the three buffers live on the supply and one lives on the layer, because a time buffer
#   is a fact about demand and demand is a bare claim with nowhere to hang it. The tall form hides
#   that asymmetry, which is a thing to know rather than a thing to like.
#
# Only the time slack reads a derivation
#   `pm:StatedTimeSlack` is the one slack wrapper with a derivation arm; the other two are
#   `pm:StatedClaim`, so their rows leave the column at its default.
#
# Who owns a slack's edge is not read here
#   `boundOrigin` is on the slack's claim, and `bound_origin` below takes it from every claim
#   alike. A copy here was a second spelling of those rows.
INSERT INTO slack
SELECT s.name, x.layer, 'time'::buffer, x.low, x.mode, x.high, x.unit,
       x.absent::absence_reason, x.derivation::identity
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:layer' PASSING s.body
       COLUMNS layer text PATH 'pm:name',
               low   numeric PATH 'pm:timeSlack/pm:claim/pm:low',
               mode  numeric PATH 'pm:timeSlack/pm:claim/pm:mostLikely',
               high  numeric PATH 'pm:timeSlack/pm:claim/pm:high',
               unit  text    PATH 'pm:timeSlack/pm:claim/pm:unit',
               absent text   PATH 'pm:timeSlack/pm:absent/pm:reason',
               derivation text PATH 'pm:timeSlack/pm:derivation/pm:identity') x
WHERE x.layer IN (SELECT layer FROM layer WHERE filing = s.name);

INSERT INTO slack
SELECT s.name, x.layer, x.buf::buffer, x.low, x.mode, x.high, x.unit,
       x.absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:layer' PASSING s.body
       COLUMNS layer text PATH 'pm:name',
               buf   text PATH '''capacity''',
               low   numeric PATH 'pm:supply/pm:nameplate/pm:capacitySlack/pm:claim/pm:low',
               mode  numeric PATH 'pm:supply/pm:nameplate/pm:capacitySlack/pm:claim/pm:mostLikely',
               high  numeric PATH 'pm:supply/pm:nameplate/pm:capacitySlack/pm:claim/pm:high',
               unit  text    PATH 'pm:supply/pm:nameplate/pm:capacitySlack/pm:claim/pm:unit',
               absent text   PATH 'pm:supply/pm:nameplate/pm:capacitySlack/pm:absent/pm:reason') x
WHERE x.layer IN (SELECT layer FROM layer WHERE filing = s.name);

INSERT INTO slack
SELECT s.name, x.layer, 'inventory'::buffer, x.low, x.mode, x.high, x.unit,
       x.absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:layer' PASSING s.body
       COLUMNS layer text PATH 'pm:name',
               low   numeric PATH 'pm:supply/pm:nameplate/pm:inventorySlack/pm:claim/pm:low',
               mode  numeric PATH 'pm:supply/pm:nameplate/pm:inventorySlack/pm:claim/pm:mostLikely',
               high  numeric PATH 'pm:supply/pm:nameplate/pm:inventorySlack/pm:claim/pm:high',
               unit  text    PATH 'pm:supply/pm:nameplate/pm:inventorySlack/pm:claim/pm:unit',
               absent text   PATH 'pm:supply/pm:nameplate/pm:inventorySlack/pm:absent/pm:reason') x
WHERE x.layer IN (SELECT layer FROM layer WHERE filing = s.name);

-- ---------------------------------------------------------------------------
-- H, tall. A row per bearer.
-- ---------------------------------------------------------------------------
# No row, no share
#   No row means that kind bears none of it, and `share_absent` means somebody said so without a
#   number.
INSERT INTO holder
SELECT s.name, x.layer, x.kind::holder_kind,
       x.low, x.mode, x.high, x.unit, x.absent::absence_reason, x.derivation::identity,
       x.party, x.as_of::date
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:layer/pm:remainder/pm:remainder/pm:holder/pm:holder' PASSING s.body
       COLUMNS layer text PATH '../../../../pm:name',
               kind  text PATH 'pm:kind',
               low   numeric PATH 'pm:share/pm:claim/pm:low',
               mode  numeric PATH 'pm:share/pm:claim/pm:mostLikely',
               high  numeric PATH 'pm:share/pm:claim/pm:high',
               unit  text    PATH 'pm:share/pm:claim/pm:unit',
               absent text   PATH 'pm:share/pm:absent/pm:reason',
               derivation text PATH 'pm:share/pm:derivation/pm:identity',
               party text    PATH 'pm:party',
               as_of text    PATH 'pm:asOf') x;

# Every claim, and the position it fills
#   Every claim in the document, and the position it is the value of. The parent axis is the whole
#   trick and it is ordinary XPath 1.0: from the `pm:claim` node, walk up, two steps and not one
#   (see `owns` below). Without it a claim's own width is unreachable from the narrowing that
#   describes it, and the two rules that compare the two could only run over `layer.demand_*`, a
#   minority of the claims and the only ones with no point value among them.
#
# The owner is stored as the element name
#   Prefix and all, rather than resolved to a kind. `asrt:quantity` and `pm:quantity` are
#   different questions in different schemas and the prefix is the only thing that says so. It is
#   also not an enum: the set grows whenever `Claim` is reused, and a restated value set here
#   would be a fork of the XSD.
#
# `owns` takes two segments
#   One was not enough. Reading `name(..)`, the parent's name, as the position merges positions,
#   because three names are filed at two positions each:
#     `pm:amount`    `Demand/amount` with `Nameplate/amount`
#     `pm:size`      `lumpy/size` with the window's `quantum/size`
#     `pm:quantity`  `draw/quantity` with `remainder/quantity`
#   A duty cycle is a fraction of the nameplate's period, and `units/with_a_period.sqlc` is the
#   one relation that filters on this column. Read `owns = 'pm:amount'` and it answers for the
#   demand too, returning two rows per layer. Nothing goes wrong while no layer in this corpus
#   disagrees with itself about carrying a period; the day one does, a window gets measured
#   against the wrong denominator. The grandparent settles all three, and `concat` is ordinary
#   XPath 1.0. A composite key would settle them too and would put the burden on every caller to
#   remember the second column, which is the trap rather than the repair.
#
# `layer` is read on the ancestor axis
#   Ordinary XPath 1.0 that Postgres XMLTABLE has had all along. A claim about a coupling or an
#   elimination has no layer ancestor and lands NULL, which is the right answer rather than a
#   miss.
#
# `period` and `each` are two facts
#   The two arms are read separately, and no `LIKE` reads either: a `period` makes the duty-cycle
#   question answerable, an `each` says there is a denominator and it is still not a cycle.
#
# `pm:Provenance` reaches the database
#   `standing`, the axis separating an auditor's observation from a controller's hunch, is filed
#   on claims, and without these paths it is readable by nothing.
-- pm:Claim, wherever one appears, across two schemas.
INSERT INTO claim
SELECT s.name, x.seq, x.owns, x.layer, x.low, x.mode, x.high, x.unit,
       coalesce(x.period, x.each),
       CASE WHEN x.period IS NOT NULL THEN 'period'
            WHEN x.each   IS NOT NULL THEN 'each' END,
       x.absent::absence_reason,
       x.prov_party, x.prov_entered, x.prov_approved,
       x.prov_st_tax, x.prov_st_val, x.prov_st_absent::absence_reason, x.prov_note,
       x.as_of::date
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:claim' PASSING s.body
       COLUMNS seq FOR ORDINALITY,
               owns text    PATH 'concat(name(../..),"/",name(..))',
               layer text   PATH 'ancestor::pm:layer/pm:name',
               low  numeric PATH 'pm:low',
               mode numeric PATH 'pm:mostLikely',
               high numeric PATH 'pm:high',
               unit text    PATH 'pm:unit',
               period text  PATH 'pm:denominator/pm:period',
               each   text  PATH 'pm:denominator/pm:each',
               absent text  PATH 'pm:denominator/pm:absent/pm:reason',
               prov_party   text PATH 'pm:provenance/pm:party',
               prov_entered text PATH 'pm:provenance/pm:enteredBy',
               prov_approved text PATH 'pm:provenance/pm:approvedBy',
               prov_st_tax  text PATH 'pm:provenance/pm:standing/pm:term/pm:taxonomy',
               prov_st_val  text PATH 'pm:provenance/pm:standing/pm:term/pm:value',
               prov_st_absent text PATH 'pm:provenance/pm:standing/pm:absent/pm:reason',
               prov_note    text PATH 'pm:provenance/pm:note',
               as_of        text PATH 'pm:asOf') x;

-- Every narrowing anywhere in the document, in document order.
INSERT INTO narrowing
SELECT s.name, x.seq, x.condition, x.kind::narrowing_kind, x.absent::absence_reason,
       x.derivation::identity
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:narrowsWhen' PASSING s.body
       COLUMNS seq FOR ORDINALITY,
               condition text PATH 'pm:narrowing/pm:condition',
               kind      text PATH 'pm:narrowing/pm:kind',
               absent    text PATH 'pm:absent/pm:reason',
               derivation text PATH 'pm:derivation/pm:identity') x;

# The same ordinal, as a foreign key
#   `Claim` requires exactly one `narrowsWhen` and exactly one `boundOrigin`, so the Nth of each
#   belongs to the Nth claim. A stream that desynchronised would attribute every edge to the
#   wrong claim in silence, so both tables reference `claim` and a desync fails the load instead.
-- pm:Claim/pm:boundOrigin, in the same document order as the claims above.
INSERT INTO bound_origin
SELECT s.name, x.seq, x.origin::constraint_origin, x.absent::absence_reason,
       x.derivation::identity
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:boundOrigin' PASSING s.body
       COLUMNS seq FOR ORDINALITY,
               origin text PATH 'pm:origin',
               absent text PATH 'pm:absent/pm:reason',
               derivation text PATH 'pm:derivation/pm:identity') x;

# Every absent element, wherever it sits
#   The descendant axis over both namespaces reads every arm of every wrapper in one pass, the way
#   `//pm:claim` reads every claim: a composition's `asrt:absent` on its eliminations as well as a
#   filing's `pm:absent`. `owns` is spelled as `claim.owns` is, so a claim and an absence at one
#   position join. What is not read here is the reason's second home, the column on the table of
#   the thing the absence is about, which the paths above fill.
-- pm:Absence and pm:ClaimAbsence, every one, in document order.
INSERT INTO absence
SELECT s.name, x.seq, x.owns, x.layer, x.reason::absence_reason, x.note, x.as_of::date,
       x.prov_party, x.prov_entered, x.prov_approved,
       x.prov_st_tax, x.prov_st_val, x.prov_st_absent::absence_reason, x.prov_note
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm,
                            'https://example.invalid/assertion/1.0' AS asrt),
       '//pm:absent | //asrt:absent' PASSING s.body
       COLUMNS seq FOR ORDINALITY,
               owns   text PATH 'concat(name(../..),"/",name(..))',
               layer  text PATH 'ancestor::pm:layer/pm:name',
               reason text PATH 'pm:reason',
               note   text PATH 'pm:note',
               as_of  text PATH 'pm:asOf',
               prov_party     text PATH 'pm:provenance/pm:party',
               prov_entered   text PATH 'pm:provenance/pm:enteredBy',
               prov_approved  text PATH 'pm:provenance/pm:approvedBy',
               prov_st_tax    text PATH 'pm:provenance/pm:standing/pm:term/pm:taxonomy',
               prov_st_val    text PATH 'pm:provenance/pm:standing/pm:term/pm:value',
               prov_st_absent text PATH 'pm:provenance/pm:standing/pm:absent/pm:reason',
               prov_note      text PATH 'pm:provenance/pm:note') x;

# Every derivation, the same way
#   The third arm of every wrapper that has one, read in one pass over both namespaces exactly as
#   the absences are. The identity's second home is the `*_derivation` column on the table of the
#   thing it computes, which the paths above fill.
#
# A claim's edge and narrowing name the claim they are about
#   Their `owns` is the claim's own element, which every claim shares. `claim_owns` reads the
#   position of the claim itself, two levels further up, and only where the grandparent is a
#   `pm:claim`: elsewhere both names are empty and the lone `/` is dropped. It is structure the
#   document states, not a classification made here.
-- pm:Derivation and its restrictions, every one, in document order.
INSERT INTO derivation
SELECT s.name, x.seq, x.owns, NULLIF(x.claim_owns, '/'), x.layer, x.identity::identity, x.note,
       x.as_of::date,
       x.prov_party, x.prov_entered, x.prov_approved,
       x.prov_st_tax, x.prov_st_val, x.prov_st_absent::absence_reason, x.prov_note
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm,
                            'https://example.invalid/assertion/1.0' AS asrt),
       '//pm:derivation' PASSING s.body
       COLUMNS seq FOR ORDINALITY,
               owns     text PATH 'concat(name(../..),"/",name(..))',
               claim_owns text PATH 'concat(name(../parent::pm:claim/../..),"/",name(../parent::pm:claim/..))',
               layer    text PATH 'ancestor::pm:layer/pm:name',
               identity text PATH 'pm:identity',
               note     text PATH 'pm:note',
               as_of    text PATH 'pm:asOf',
               prov_party     text PATH 'pm:provenance/pm:party',
               prov_entered   text PATH 'pm:provenance/pm:enteredBy',
               prov_approved  text PATH 'pm:provenance/pm:approvedBy',
               prov_st_tax    text PATH 'pm:provenance/pm:standing/pm:term/pm:taxonomy',
               prov_st_val    text PATH 'pm:provenance/pm:standing/pm:term/pm:value',
               prov_st_absent text PATH 'pm:provenance/pm:standing/pm:absent/pm:reason',
               prov_note      text PATH 'pm:provenance/pm:note') x;

-- ---------------------------------------------------------------------------
-- Operations, and the two matrices that hang off them.
-- ---------------------------------------------------------------------------
# The `notationPosition` is the interface
#   It is the only thing that crosses into a process notation, so a path that skips it discards
#   the whole interface. A corpus can file a BPMN node id, the database hold none, and every
#   relation that could show the crossing be derived from a table that threw it away, with
#   nothing failing. The write side is the only direction that finds that: ask what the XSD
#   permits, then grep this file for it.
#
# One row per operation, and no `DISTINCT`
#   `operationLabel` keys an operation's label in its filing, so two operations sharing one is a
#   document that did not validate, and `PRIMARY KEY (filing, label)` refuses it here too. A
#   `DISTINCT` once stood in for the missing key and merged two same-label operations whose
#   positions agreed into one row carrying both operations' draws, with nothing failing.
-- pm:Operation: the label, and the position in a process notation where the filer named one.
INSERT INTO operation
SELECT s.name, x.label, x.notation, x.foreign_id, x.absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:operation' PASSING s.body
       COLUMNS label      text PATH 'pm:label',
               notation   text PATH 'pm:notationPosition/pm:foreignId/pm:notation',
               foreign_id text PATH 'pm:notationPosition/pm:foreignId/pm:id',
               absent     text PATH 'pm:notationPosition/pm:absent/pm:reason') x;

-- D, tall. What an operation takes from a layer, now.
INSERT INTO draw
SELECT s.name, x.op, x.layer, x.low, x.mode, x.high, x.unit, x.absent::absence_reason
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:operation/pm:draw' PASSING s.body
       COLUMNS op    text PATH '../pm:label',
               layer text PATH 'pm:layer',
               low   numeric PATH 'pm:quantity/pm:claim/pm:low',
               mode  numeric PATH 'pm:quantity/pm:claim/pm:mostLikely',
               high  numeric PATH 'pm:quantity/pm:claim/pm:high',
               unit  text    PATH 'pm:quantity/pm:claim/pm:unit',
               absent text   PATH 'pm:quantity/pm:absent/pm:reason') x;

# A different table on purpose
#   Despite the identical shape. A draw is consumption that happened; an induction is a
#   commitment that creates a future draw on a different supply. Folding them into one table
#   with a discriminator column would put two kinds of fact in one slot, and `decider`, which
#   only an induction has, is the tell.
-- N, tall.
INSERT INTO induction
SELECT s.name, x.op, x.layer, x.low, x.mode, x.high, x.unit, x.absent::absence_reason, x.decider
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:operation/pm:induces' PASSING s.body
       COLUMNS op    text PATH '../pm:label',
               layer text PATH 'pm:layer',
               low   numeric PATH 'pm:commitment/pm:claim/pm:low',
               mode  numeric PATH 'pm:commitment/pm:claim/pm:mostLikely',
               high  numeric PATH 'pm:commitment/pm:claim/pm:high',
               unit  text    PATH 'pm:commitment/pm:claim/pm:unit',
               absent text   PATH 'pm:commitment/pm:absent/pm:reason',
               decider text  PATH 'pm:decidedBy') x;

# Tall and almost empty, which is the point
#   The stack is assumed to be a set of independent quantizations, so `C = 0` is the assumption
#   and every non-zero entry is an observation somebody made and is required to write down. A
#   filing with no rows here is one where nobody looked, not one where nothing was found, and in
#   a tall table those two look identical. assets/sql/rules.sql reports it.
#
# `s_absent`: a dependence nobody could size
#   The same third state on the other optional StatedClaim: a dependence somebody observed and
#   could not size is not a dependence with no strength.
-- C, tall.
INSERT INTO coupling
SELECT s.name, x.f, x.t, x.low, x.mode, x.high, x.unit,
       x.s_absent::absence_reason, x.observed
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:couplings/pm:coupling' PASSING s.body
       COLUMNS f text PATH 'pm:from',
               t text PATH 'pm:to',
               low  numeric PATH 'pm:strength/pm:claim/pm:low',
               mode numeric PATH 'pm:strength/pm:claim/pm:mostLikely',
               high numeric PATH 'pm:strength/pm:claim/pm:high',
               unit text    PATH 'pm:strength/pm:claim/pm:unit',
               s_absent text PATH 'pm:strength/pm:absent/pm:reason',
               observed text PATH 'pm:observed') x;

# The row that makes the emptiness above readable
#   One per filing that files no couplings, carrying the reason the filer gave. `Stack/couplings`
#   is a `StatedCouplings`, so the document says.
-- pm:Stack/pm:couplings, the search beside C.
INSERT INTO coupling_search
SELECT s.name, x.absent::absence_reason, x.note
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/process-flow/1.0' AS pm),
       '//pm:stack/pm:couplings' PASSING s.body
       COLUMNS absent text PATH 'pm:absent/pm:reason',
               note   text PATH 'pm:absent/pm:note') x
WHERE s.name IN (SELECT name FROM filing);

# A fusion before its parts
#   Every part, search and elimination belongs to one, and the fusion carries what the composer
#   saw, `asrt:observed`, which is required.
-- asrt:Fusion: the composed layer it names and what the composer observed.
INSERT INTO fusion
SELECT s.name, f.composed, f.observed
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt),
       '//asrt:fusion' PASSING s.body
       COLUMNS composed text PATH 'asrt:name',
               observed text PATH 'asrt:observed') f;

-- ---------------------------------------------------------------------------
-- F and Phi in one table.
-- ---------------------------------------------------------------------------
# A part is incidence and factor at once
#   A part is an incidence entry and its conversion factor at the same time. A NULL factor means
#   the units already agree, which is phi = 1 and is filed by omission rather than by writing 1
#   three times. Two nested XMLTABLEs: the outer one yields each fusion and captures its own
#   element as `frag`, the inner one reads the parts out of that fragment. XPath has no join, so
#   this is where relational algebra starts earning its keep.
#
# `p_regime` is the composer's handle
#   Which of the composer's own regimes this part comes under. `partRegime` keyrefs it inside the
#   document; loaded, it can be compared with the part filing's own declaration.
#
# `f_absent` is the third state
#   Without this path a conversion nobody measured arrives as three NULLs, indistinguishable from
#   a part already in the composed unit, and composition/converted.sqlc's coalesce(.., 1) then
#   asserts phi = 1 for a rate no composer filed. `asrt:Part/factor` is minOccurs="0" over
#   pm:StatedFactor, so it admits all three; this reads the one that was lost.
INSERT INTO part
SELECT s.name, f.composed, p.pf, p.pl, p.p_regime, p.f_low, p.f_mode, p.f_high,
       p.f_absent::absence_reason, p.f_derivation::identity,
       p.party, p.reg_taxonomy, p.reg_value, p.version
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt),
       '//asrt:fusion' PASSING s.body
       COLUMNS composed text PATH 'asrt:name', frag xml PATH '.') f,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt,
                            'https://example.invalid/process-flow/1.0' AS pm),
       '/asrt:fusion/asrt:part' PASSING f.frag
       COLUMNS pf text PATH 'asrt:layer/asrt:filing/pm:notation',
               pl text PATH 'asrt:layer/asrt:filing/pm:id',
               p_regime text PATH 'asrt:layer/asrt:regime',
               f_low  numeric PATH 'asrt:factor/pm:claim/pm:low',
               f_mode numeric PATH 'asrt:factor/pm:claim/pm:mostLikely',
               f_high numeric PATH 'asrt:factor/pm:claim/pm:high',
               f_absent text PATH 'asrt:factor/pm:absent/pm:reason',
               f_derivation text PATH 'asrt:factor/pm:derivation/pm:identity',
               party    text PATH 'asrt:layer/asrt:party',
               reg_taxonomy text PATH 'asrt:layer/asrt:registration/pm:taxonomy',
               reg_value    text PATH 'asrt:layer/asrt:registration/pm:value',
               version  text PATH 'asrt:layer/asrt:version') p;

# `absent/reason = none` is the common case
#   Somebody checked and nothing was double counted.
#
# One table over the document, not a fragment inside a fusion
#   ⛔ This read the fusions and then read each one's eliminations out of `frag xml PATH '.'`, a
#   detached fragment, which was enough while every column was a child of the elimination. It is not
#   enough for `claim_seq`: inside a fragment the `preceding::` axis sees only the fragment, so
#   counting claims there counts the ones in that fusion and produces an ordinal that is populated
#   and wrong. Flat against `s.body` the axis means the document, which is what `claim`'s own
#   ordinality means. The nesting only ever existed to reach the parent's name and
#   `ancestor::asrt:fusion` does that directly, exactly as the claim insert reads
#   `ancestor::pm:layer`.
#
#   The count is one-based to match `FOR ORDINALITY`, and it reads 1 for an elimination with no
#   claim at all, because an empty node-set has nothing preceding it. XPath 1.0 has no conditional,
#   so the SELECT is where that becomes NULL. A claim always carries a `low`, so `low IS NULL` is
#   exactly "this quantity is not a claim".
-- e_x. One row per quantity eliminated.
INSERT INTO elimination
SELECT s.name, e.composed, e.against::summed_quantity, e.low, e.mode, e.high, e.unit,
       e.absent::absence_reason, e.derivation::identity, e.observed,
       CASE WHEN e.low IS NOT NULL THEN e.claim_seq END
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt,
                            'https://example.invalid/process-flow/1.0' AS pm),
       '//asrt:fusion/asrt:eliminations/asrt:elimination' PASSING s.body
       COLUMNS composed text PATH 'ancestor::asrt:fusion/asrt:name',
               against text PATH 'asrt:against',
               low  numeric PATH 'asrt:quantity/pm:claim/pm:low',
               mode numeric PATH 'asrt:quantity/pm:claim/pm:mostLikely',
               high numeric PATH 'asrt:quantity/pm:claim/pm:high',
               unit text    PATH 'asrt:quantity/pm:claim/pm:unit',
               absent text  PATH 'asrt:quantity/pm:absent/pm:reason',
               derivation text PATH 'asrt:quantity/pm:derivation/pm:identity',
               observed text PATH 'asrt:observed',
               claim_seq int PATH 'count(asrt:quantity/pm:claim/preceding::pm:claim) + 1') e;

# The same row one document up
#   Which fusions looked for double counting, and what they found. Some fusions file no
#   elimination, and without this row that is indistinguishable from composers who never
#   checked.
-- asrt:Fusion/asrt:eliminations/pm:absent, the search beside e.
INSERT INTO elimination_search
SELECT s.name, f.composed, e.absent::absence_reason, e.note
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt),
       '//asrt:fusion' PASSING s.body
       COLUMNS composed text PATH 'asrt:name', frag xml PATH '.') f,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt,
                            'https://example.invalid/process-flow/1.0' AS pm),
       '/asrt:fusion/asrt:eliminations' PASSING f.frag
       COLUMNS absent text PATH 'asrt:absent/pm:reason',
               note   text PATH 'asrt:absent/pm:note') e;

# The layers the double count runs between
#   That is the evidence for the elimination. `asrt:Elimination/between` is
#   `maxOccurs="unbounded"`, and without a home in this database every `between` is read from the
#   XML and dropped on the floor. Nothing notices, because no rule reads them: a rule reads only
#   what it needs, and a field no rule reads is under no pressure to exist. Only asking "can this
#   document be written back out" finds it.
#
# `FOR ORDINALITY` keeps two `between` elements two rows
#   Rather than one, the same reason `regime` uses it above.
-- asrt:Elimination/between.
INSERT INTO elimination_between
SELECT s.name, f.composed, e.against::summed_quantity, b.seq, b.party, b.notation, b.layer, b.version, b.regime,
       b.reg_taxonomy, b.reg_value
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt),
       '//asrt:fusion' PASSING s.body
       COLUMNS composed text PATH 'asrt:name', frag xml PATH '.') f,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt),
       '/asrt:fusion/asrt:eliminations/asrt:elimination' PASSING f.frag
       COLUMNS against text PATH 'asrt:against', efrag xml PATH '.') e,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt,
                            'https://example.invalid/process-flow/1.0' AS pm),
       '/asrt:elimination/asrt:between' PASSING e.efrag
       COLUMNS seq      FOR ORDINALITY,
               party    text PATH 'asrt:party',
               notation text PATH 'asrt:filing/pm:notation',
               layer    text PATH 'asrt:filing/pm:id',
               version  text PATH 'asrt:version',
               regime   text PATH 'asrt:regime',
               reg_taxonomy text PATH 'asrt:registration/pm:taxonomy',
               reg_value    text PATH 'asrt:registration/pm:value') b;

# The standards the composition works under
#   `asrt:Composition/citation` sits at the document root rather than inside a fusion.
#
# `instrument` is a pm:BorrowedTerm
#   So it is a taxonomy and a value, never the element's text. Reading the element whole returns
#   the whitespace between the two children, which looks like a value and is not one.
-- asrt:Composition/citation.
INSERT INTO composition_citation
SELECT s.name, c.seq, c.taxonomy, c.instrument, c.clause, c.version
FROM source s,
     XMLTABLE(XMLNAMESPACES('https://example.invalid/assertion/1.0' AS asrt,
                            'https://example.invalid/process-flow/1.0' AS pm),
       '//asrt:composition/asrt:citation' PASSING s.body
       COLUMNS seq        FOR ORDINALITY,
               taxonomy   text PATH 'asrt:instrument/pm:taxonomy',
               instrument text PATH 'asrt:instrument/pm:value',
               clause     text PATH 'asrt:clause',
               version    text PATH 'asrt:version') c;

# Every deferred constraint, checked before the load ends
#   A claim owes one row in `narrowing` and one in `bound_origin`, and those keys are deferred
#   because the claim is inserted first. Checking them here, rather than at `COMMIT`, holds a load
#   that is rolled back instead of committed to the same rule.
SET CONSTRAINTS ALL IMMEDIATE;

COMMIT;

# Statistics for the planner
#   The composed queries nest aggregates and set differences deep enough that the planner's row
#   estimates decide whether a subquery runs once or thousands of times. Freshly loaded tables have
#   no statistics until autovacuum reaches them, so the same query could take milliseconds or many
#   seconds depending on how soon after a load it ran. Analyzing here makes the plan a property of
#   the data rather than of the clock. It is outside the transaction above, and a caller that
#   drops the COMMIT to roll a load back runs it inside its own, which ANALYZE allows.
-- every table the load just filled.
ANALYZE;
