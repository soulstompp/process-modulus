# Every supply that served something, and whether its draw can be set beside its rating. One row
# per layer stating both a draw and a nameplate amount.
#
# Three units meet here
#   The bound reads a draw, a rating and a capacity slack, and adding and comparing them means
#   something only when all three are in one unit. This site calls a row `not comparable` where any
#   of them differs, and checks/draw_exceeds_the_supply.sqlc compares only rows in one unit, so the
#   rule never adds numbers of different things.
#
# An unmeasured capacity slack suspends the bound
#   It does not make it zero. A nameplate is not a ceiling until somebody says the buffer is empty.
#   layers/drawn.sqlc leaves the column NULL for that reason, and this relation reports the layers
#   where it does.
-- pm:Jagged/pm:draw against pm:Nameplate/pm:amount and pm:Nameplate/pm:capacitySlack.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT d.filing, d.layer,
           CASE WHEN d.capacity_slack IS NULL                       THEN 'suspended'::public.arithmetic_verdict
                WHEN d.draw_unit IS DISTINCT FROM d.n_unit
                  OR d.capacity_unit IS DISTINCT FROM d.n_unit       THEN 'not comparable'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           CASE WHEN d.capacity_slack IS NULL
                     THEN format('the capacity buffer is %s', d.capacity_absent)
                WHEN d.draw_unit IS DISTINCT FROM d.n_unit
                  OR d.capacity_unit IS DISTINCT FROM d.n_unit
                     THEN format('a draw in %s against a rating in %s and a slack in %s',
                                 d.draw_unit, d.n_unit, d.capacity_unit)
                ELSE format('draw, rating and slack all in %s', d.n_unit) END AS detail
    FROM (
        :compose(layers/drawn.sqlc)
    ) d
) p ON true
WHERE a.slug = 'draw_bounded'
