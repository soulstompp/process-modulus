# Every fusion, and in which quantities its parts owe it an equality. One row per composed layer
# that at least one part reaches: `computable` where at least one quantity's sum is owed, with a
# detail saying which are owed and why the rest are suspended.
#
# The units are not checked here, and must not be
#   conformance/README.md: "The units of a fusion's parts are not compared, because parts
#   legitimately spell one unit two ways, `people` and `pessoas`, and saying they name one unit is
#   exactly what a fusion says." A filer who fuses two layers has declared them to be in one unit,
#   and a check that tested it would overrule a judgement no document owes it. This is the one site
#   on the roster whose missing guard is correct, which is why `(forbidden)` is a value and not a
#   NULL.
#
# Suspended is a third outcome
#   It stands beside passed and failed. A composer who never searched for double counting, or who
#   found it and could not size it, owes no equality, so the fusions
#   composition/suspended_fusions.sqlc names are suspended here rather than passed. The
#   `StatedEliminations` annotation in assertion.xsd sets out the verdicts this follows.
#
# Verdict and reason come from named relations
#   The verdict comes from composition/owed_equality.sqlc and composition/derived_quantities.sqlc,
#   and the reason from composition/suspension_grounds.sqlc, so a change to any of them reaches
#   here.
#
# A derived composed figure is computed, not suspended
#   Where the composing document files a quantity `derived`, the sum is the figure rather than a
#   check on it, so the detail gives the computed figure from composition/derived_quantities.sqlc,
#   or the reason it cannot be computed. A fusion is `computable` where one quantity owes its
#   equality or one derived figure computes, so a fusion filing every quantity `derived` is not
#   suspended for having nothing to compare.
#
# One row per layer, every quantity in it
#   Each site gives one verdict per (site, filing, layer), and algebra/arithmetic_class holds it to
#   exactly one. So the quantities are gathered here: the owed ones from
#   composition/owed_equality.sqlc, and the suspended ones with their grounds from
#   composition/suspension_grounds.sqlc, gathered to one line per quantity and ground before the
#   join, so a fusion suspended on two grounds still gives one row.
#
# At most one ground per quantity from the eliminations
#   assertion.xsd makes `StatedEliminations` a choice: a fusion files `absent` or one or more
#   `elimination`, never both. The tables do not carry that guarantee, so the query gathers the
#   grounds rather than assume there is one.
-- asrt:Fusion/asrt:Part against asrt:eliminations, via composition/owed_equality.sqlc and
-- composition/derived_quantities.sqlc.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT f.filing, f.layer,
           CASE WHEN o.owed IS NULL AND d.computed IS NOT TRUE
                THEN 'suspended'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           concat_ws('; ',
                     CASE WHEN o.owed IS NOT NULL THEN format('owed exactly for %s', o.owed) END,
                     d.derived,
                     s.suspended) AS detail
    FROM      (
        :compose(composition/fusions.sqlc)
    ) f
    LEFT JOIN (
        SELECT o.filing, o.layer, string_agg(o.quantity::text, ', ' ORDER BY o.quantity) AS owed
        FROM (
            :compose(composition/owed_equality.sqlc)
        ) o
        GROUP BY o.filing, o.layer
    ) o USING (filing, layer)
    LEFT JOIN (
        SELECT g.composition, g.composed_layer,
               string_agg(DISTINCT format('suspended for %s: %s',
                                          coalesce(g.quantity::text, 'every quantity'),
                                          g.suspended_because), '; ') AS suspended
        FROM (
            :compose(composition/suspension_grounds.sqlc)
        ) g
        GROUP BY g.composition, g.composed_layer
    ) s ON s.composition = f.filing AND s.composed_layer = f.layer
    LEFT JOIN (
        SELECT d.filing, d.layer, bool_or(q.low IS NOT NULL) AS computed,
               string_agg(CASE WHEN q.low IS NOT NULL
                               THEN format('derived for %s: computed [%s, %s, %s]', d.quantity,
                                           q.low, q.mode, q.high)
                               ELSE format('derived for %s, not computable: %s', d.quantity,
                                           q.blocked_because) END,
                          '; ' ORDER BY d.quantity) AS derived
        FROM      (
            :compose(composition/derived_fusions.sqlc)
        ) d
        JOIN      (
            :compose(composition/derived_quantities.sqlc)
        ) q ON q.filing = d.filing AND q.layer = d.layer AND q.quantity = d.quantity
        GROUP BY d.filing, d.layer
    ) d ON d.filing = f.filing AND d.layer = f.layer
) p ON true
WHERE a.slug = 'fusion_sum'
