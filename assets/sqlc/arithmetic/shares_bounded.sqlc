# Every layer whose served shares are bounded by a slack, and whether that bound is available. One
# row per interference layer that names an absorber a reader has mapped and a holder that says the
# excess was served: the population entries/borne.sqlc adds up.
#
# A guarded site
#   checks/slack_unit_mismatch is its guard. Comparing two numbers in different units does not
#   fail, it means nothing, so the unit rule is what makes share_exceeds_slack mean anything.
#   Every other comparison in this model needs the same rule, and arithmetic/roster.sqlc carries a
#   NULL in `guarded_by` wherever it is missing.
#
# `fusion_sum` is not an unguarded site
#   It reads `(forbidden)` rather than NULL, because a fusion declares its parts to be in one unit,
#   and counting it with the unguarded sites overstates them by one. examples/readiness prints the
#   tally from the roster on every run.
#
# The served holders, under interference
#   A buffer bounds what it absorbed: the served shares together stay within its slack. The two
#   holders who went without were absorbed by nothing. So the site reads the served holders,
#   gathered per layer by folds/served_totals.sqlc from entries/served_holders.sqlc, and only where
#   the filed fit is interference, which is where entries/borne.sqlc and
#   checks/share_exceeds_slack.sqlc look. A site wider than its rule would report arithmetic as
#   computable that the rule never does.
#
# An unsized slack suspends the bound
#   entries/borne.sqlc drops those rows and this site names them. Where every row is suspended,
#   that is why `share_exceeds_slack` examines nothing.
-- the slack named by pm:Remainder/pm:absorber, against the served pm:Remainder/pm:holder under
-- interference.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT s.filing, s.layer,
           CASE WHEN s.mode IS NULL                  THEN 'suspended'::public.arithmetic_verdict
                WHEN h.unstated > 0                  THEN 'suspended'::public.arithmetic_verdict
                WHEN h.share_units <> ARRAY[s.unit]  THEN 'not comparable'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           CASE WHEN s.mode IS NULL
                     THEN format('the %s buffer is %s', s.buffer, s.absent)
                WHEN h.unstated > 0
                     THEN format('%s of %s shares unstated%s, against a %s slack of %s',
                                 h.unstated, h.holders,
                                 CASE WHEN h.derived > 0
                                      THEN format(' (%s of them filed as `sharesSum`''s output, which nothing here computes)', h.derived)
                                      ELSE '' END,
                                 s.buffer, s.mode)
                ELSE format('%s shares bounded by a %s slack of %s',
                            h.holders, s.buffer, s.mode)
           END AS detail
    FROM      (
        :compose(entries/absorbing_slack.sqlc)
    ) s
    JOIN      (
        :compose(folds/served_totals.sqlc)
    ) h USING (filing, layer)
    JOIN      (
        SELECT DISTINCT r.filing, r.layer
        FROM (
            :compose(layers/pressed.sqlc)
        ) r
        WHERE r.sign = 'interference'
    ) x USING (filing, layer)
) p ON true
WHERE a.slug = 'shares_bounded'
