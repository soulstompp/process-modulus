# Every layer that derived its time slack rather than measuring it, and whether the clearance it
# stands for can be computed. One row per time slack filed `absent/reason = derived`.
#
# The slack is the clearance, a quantity
#   `pm:Layer/timeSlack` holds a quantity in the layer's unit, because it is compared against
#   holder shares. Filed as `derived`, it is the clearance the layer's own figures give,
#   `max(n - d, 0)`: on a line making 2160 muffins a day against a demand of 2000, the slack is 160
#   muffins a day. The twelve minutes a late muffin waits, `q / clearance`, is a duration, a
#   different dimension describing the same line, and the bridge between the two,
#   `quantity = duration x rate`, is the filer's to cross before filing. Proof:
#   `src/proofs/README.md`, entries `clearance_is_not_a_duration` and `slack_from_duration`.
#
# One unit
#   The clearance is a subtraction, so it is computable where demand and nameplate share a unit,
#   and `not comparable` where they do not.
#
# A different question of the same rows
#   checks/derived_slack_over_a_window asks whether the window licenses reading that quantity as
#   demand that survives being held, which needs the spare spread evenly across the period.
#   Whether the subtraction itself can be done is this site's question.
-- pm:Layer/pm:timeSlack with pm:absent/reason = derived, against the clearance it stands for.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT t.filing, t.layer,
           CASE WHEN r.filing IS NULL                            THEN 'suspended'::public.arithmetic_verdict
                WHEN r.unit IS DISTINCT FROM r.amount_unit        THEN 'not comparable'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           CASE WHEN r.filing IS NULL THEN 'no demand and nameplate to take a clearance from'
                WHEN r.unit IS DISTINCT FROM r.amount_unit
                     THEN format('a demand in %s against a nameplate in %s', r.unit, r.amount_unit)
                ELSE format('the clearance [%s, %s, %s] %s is the slack',
                            greatest(r.r_low, 0), greatest(r.r_mode, 0), greatest(r.r_high, 0),
                            r.unit) END AS detail
    FROM      (
        :compose(entries/derived_time_slacks.sqlc)
    ) t
    LEFT JOIN (
        :compose(layers/remainder.sqlc)
    ) r USING (filing, layer)
) p ON true
WHERE a.slug = 'time_slack_derived'
