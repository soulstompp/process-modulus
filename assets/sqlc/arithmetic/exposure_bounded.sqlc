# Every supply with nowhere to put its excess, and whether its exposure can be set against who
# went without. One row per layer whose every buffer is accounted for and empty.
#
# The one figure with no instrument behind it
#   `exposure` is the only figure in this model with no instrument behind it: the ceiling the
#   filer's own demand and nameplate imply. The shares it is compared against are measured, by
#   somebody else, possibly in another unit. Nothing compares the two.
#
# An unstated unserved share suspends the inequality
#   checks/exposure_unaccounted drops those layers with a WHERE; this relation reports them as
#   suspended instead of as absent, and names `sharesSum` where a share is filed as its output.
-- every slack on the layer accounted for and empty, against pm:Remainder/pm:holder of kind customer and unrealised.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT x.filing, x.layer,
           CASE WHEN u.unstated > 0                        THEN 'suspended'::public.arithmetic_verdict
                WHEN u.share_units <> ARRAY[x.unit]        THEN 'not comparable'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           format('exposure %s in %s against %s unserved holder(s)%s',
                  round(x.exposure, 3), x.unit, u.holders,
                  CASE WHEN u.derived > 0
                       THEN format(', %s of them filed as `sharesSum`''s output, which nothing here computes', u.derived)
                       ELSE '' END) AS detail
    FROM      (
        :compose(layers/unabsorbed_exposure.sqlc)
    ) x
    JOIN      (
        :compose(entries/unserved_totals.sqlc)
    ) u USING (filing, layer)
) p ON true
WHERE a.slug = 'exposure_bounded'
