# Every supply with nowhere to put its excess, and whether its exposure can be set against who went
# without. One row per layer whose every buffer is accounted for and empty.
#
# The one figure nobody measured
#   `exposure` is the only figure in this model with no measurement behind it: it is the most the
#   filer's own demand and nameplate allow. The shares it is compared with are measured, by
#   somebody else, possibly in another unit. No unit rule compares the two, and this site reports
#   `not comparable` where they differ.
#
# An unstated unserved share suspends the comparison
#   checks/exposure_unaccounted drops those layers with a WHERE. This relation reports them as
#   suspended instead of leaving them out, and says when a share is filed as `sharesSum`'s output.
-- every slack on the layer accounted for and empty, against pm:Remainder/pm:holder of kind customer
-- and unrealised.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT x.filing, x.layer,
           CASE WHEN u.unstated > 0                        THEN 'suspended'::public.arithmetic_verdict
                WHEN u.share_units <> ARRAY[x.unit]        THEN 'not comparable'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           format('exposure %s in %s against %s unserved holder(s)%s',
                  round(x.exposure, 3), x.unit, u.holders,
                  CASE WHEN u.derived > 0
                       THEN format(', %s of them filed as `sharesSum`''s output, which nothing here computes', u.derived)
                       ELSE '' END) AS detail
    FROM      (
        :compose(layers/unabsorbed_exposure.sqlc)
    ) x
    JOIN      (
        :compose(entries/unserved_totals.sqlc)
    ) u USING (filing, layer)
) p ON true
WHERE a.slug = 'exposure_bounded'
