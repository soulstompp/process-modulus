# Every layer where a remainder could be worked out, and whether it can be. One row per layer
# holding a nameplate row, with a verdict on whether the nameplate less the demand can be worked
# out there at all.
#
# Every candidate, not only the ones that pass
#   layers/remainder.sqlc joins demand to nameplate, so a layer missing either is simply not there,
#   which is right for the arithmetic. But a relation that drops a row cannot say why, so the layers
#   this model declines to subtract on would be invisible to everything that reads it. Here they
#   are rows.
#
# The unit comparison nothing else makes
#   layers/differenced_remainder.sqlc carries the demand's unit and the nameplate's as two separate
#   columns, `unit` and `amount_unit`, and subtracts across them with no unit condition. A unit
#   rule here would apply to every computable layer, so it is a rule worth having, not a guard with
#   nothing to guard. This relation's own `computable` verdict is that population, and
#   examples/readiness prints its size.
#
# A layer whose totals do not give its remainder
#   Where a conversion factor that is a range scales both a composed layer's totals, its remainder
#   is the one worked out from its parts, and layers/remainder.sqlc drops the layer where that
#   figure is suspended rather than fall back to the totals; composition/figureless_remainders.sqlc
#   names those layers. Such a layer is `suspended` here, with that reason, so the row
#   layers/remainder.sqlc drops still says why.
#
# Both operands from the relation that keeps an absent figure
#   composition/resolved_quantities.sqlc keeps a row for every layer's demand and every
#   nameplate's amount: stated, computed where filed as a derivation, or typed absent. The value
#   relations keep only the figures, and would drop exactly the rows whose verdict is `suspended`.
#   A derivation that cannot be computed says why.
-- composition/resolved_quantities.sqlc's demand against its nameplate, before layers/remainder.sqlc
-- drops either, with composition/figureless_remainders.sqlc for a layer whose totals do not give
-- its remainder.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT d.filing, d.layer,
           CASE WHEN d.low IS NULL OR n.low IS NULL   THEN 'suspended'::public.arithmetic_verdict
                WHEN d.unit IS DISTINCT FROM n.unit   THEN 'not comparable'::public.arithmetic_verdict
                WHEN g.filing IS NOT NULL             THEN 'suspended'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           CASE WHEN d.low IS NULL AND n.low IS NULL
                     THEN format('demand %s and nameplate %s', d.why, n.why)
                WHEN d.low IS NULL THEN format('demand %s', d.why)
                WHEN n.low IS NULL THEN format('nameplate %s', n.why)
                WHEN d.unit IS DISTINCT FROM n.unit
                     THEN format('%s against %s', d.unit, n.unit)
                WHEN g.filing IS NOT NULL
                     THEN 'a conversion with width scales both totals, and the composed remainder is lifted'
                ELSE format('both in %s', d.unit) END AS detail
    FROM      (
        SELECT q.*, CASE WHEN q.derivation IS NOT NULL
                         THEN format('`%s` and not computable: %s', q.derivation, q.blocked_because)
                         ELSE q.absent::text END AS why
        FROM ( :compose(composition/resolved_quantities.sqlc) ) q
    ) d
    JOIN      (
        SELECT q.*, CASE WHEN q.derivation IS NOT NULL
                         THEN format('`%s` and not computable: %s', q.derivation, q.blocked_because)
                         ELSE q.absent::text END AS why
        FROM ( :compose(composition/resolved_quantities.sqlc) ) q
    ) n ON n.filing = d.filing AND n.layer = d.layer AND n.quantity = 'nameplate'
    LEFT JOIN (
        :compose(composition/figureless_remainders.sqlc)
    ) g ON g.filing = d.filing AND g.layer = d.layer
    WHERE d.quantity = 'demand'
) p ON true
WHERE a.slug = 'remainder'
