# Every layer whose remainder has to be accounted for by its holders, and whether the sum can be
# taken. One row per layer with a computable remainder and at least one holder.
#
# One unstated share suspends the sum
#   It does not break it, and checks/shares_do_not_sum already knows that: it examines only the
#   layers with no unstated share. This relation says which layers it leaves out and why, which
#   the check cannot. A share filed as `sharesSum`'s output is unstated too, and the detail names
#   the identity, because nothing here computes a share from the others.
#
# The unit pair is `share_unit` against the layer's own
#   H is a distribution over the magnitude of `r`, so a share quoted in another unit is not a
#   smaller share, it is not a share of this. No unit rule compares them.
-- pm:Remainder/pm:holder against the layer the magnitude belongs to.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT r.filing, r.layer,
           CASE WHEN h.unstated > 0                  THEN 'suspended'::public.arithmetic_verdict
                WHEN h.share_units <> ARRAY[r.unit]  THEN 'not comparable'::public.arithmetic_verdict
                ELSE 'computable'::public.arithmetic_verdict END AS verdict,
           format('%s holders, %s unstated%s', h.holders, h.unstated,
                  CASE WHEN h.derived > 0
                       THEN format(', %s of them filed as `sharesSum`''s output, which nothing here computes', h.derived)
                       ELSE '' END) AS detail
    FROM      (
        :compose(layers/remainder.sqlc)
    ) r
    JOIN      (
        :compose(entries/holder_totals.sqlc)
    ) h USING (filing, layer)
) p ON true
WHERE a.slug = 'shares_sum'
