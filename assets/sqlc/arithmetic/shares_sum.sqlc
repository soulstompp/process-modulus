# EVERY LAYER WHOSE REMAINDER HAS TO BE ACCOUNTED FOR BY ITS HOLDERS, AND WHETHER THE SUM CAN
# BE TAKEN. One row per layer with a computable remainder and at least one holder.
#
# ⭐⭐ ONE UNSTATED SHARE SUSPENDS THE SUM RATHER THAN BREAKING IT, and checks/shares_do_not_sum
#    already knows that -- its HAVING clause drops the layer. This relation says which layers
#    it dropped and why, which the check cannot: sixteen of thirty-six, every one of them for
#    a share somebody declined to measure.
#
# ⛔ THE UNIT PAIR HERE IS `share_unit` AGAINST THE LAYER'S OWN. H is a distribution over the
#   magnitude of `r`, so a share quoted in another unit is not a smaller share, it is not a
#   share of this. Nothing compares them today.
-- pm:Remainder/pm:holder against the layer the magnitude belongs to.
SELECT a.site, p.filing, p.layer, p.verdict, p.detail
FROM      (
    :compose(arithmetic/roster.sqlc)
) a
LEFT JOIN (
    SELECT r.filing, r.layer,
           CASE WHEN h.unstated > 0                  THEN 'suspended'
                WHEN h.share_units <> ARRAY[r.unit]  THEN 'not comparable'
                ELSE 'computable' END AS verdict,
           format('%s holders, %s unstated', h.holders, h.unstated) AS detail
    FROM      (
        :compose(layers/remainder.sqlc)
    ) r
    JOIN      (
        :compose(entries/holder_totals.sqlc)
    ) h USING (filing, layer)
) p ON true
WHERE a.slug = 'shares_sum'
