# Every layer's supply as filed, both faces of it. One row per `pm:Facility`: its label, the
# nameplate face (amount, who committed it, how it divides, its window) and the jagged face (the
# draw and what it was measured against), each stated or typed absent.
#
# The whole table, where layers/nameplate.sqlc is the vector
#   layers/nameplate.sqlc is `n`, the stated amounts, and a layer whose amount is typed absent has
#   no row there. That is the right reading for arithmetic and the wrong one for asking what a
#   supply says about itself: a nameplate stating no amount still says how it divides, who could
#   commit it and what its draw was measured against. This relation keeps every facility.
-- pm:Layer/pm:supply, pm:Facility with its pm:Nameplate and pm:Jagged, one row per layer.
SELECT n.filing, n.layer, n.facility_label,
       n.amount_low, n.amount_mode, n.amount_high, n.amount_unit, n.amount_absent,
       n.amount_origin, n.amount_origin_absent,
       n.lumpy, n.divisibility_absent,
       n.quantum_low, n.quantum_mode, n.quantum_high, n.quantum_unit, n.quantum_absent,
       n.quantum_origin,
       n.window_low, n.window_mode, n.window_high, n.window_unit, n.window_size_absent,
       n.window_origin, n.window_absent,
       n.draw_low, n.draw_mode, n.draw_high, n.draw_unit, n.draw_absent,
       n.measurement_basis_contributed, n.measurement_basis_taxonomy, n.measurement_basis_value,
       n.measurement_basis_absent
FROM pm.nameplate n
