# HAS ANYBODY TESTED THE MODEL'S CENTRAL ASSUMPTION? One row per answer, with how many stacks
# gave it.
#
# ⭐⭐⭐ THE SINGLE MOST IMPORTANT NUMBER IN THIS REPOSITORY, AND IT WAS UNASKABLE UNTIL THE
#    COUPLING LIST STOPPED BEING ABLE TO WRITE ONLY THE AMBIGUOUS THING. This model ASSUMES
#    layers hold their remainders independently -- C = 0. The schema's own annotation says a
#    document with no couplings "is not evidence of independence; it is a document where nobody
#    looked", and for two revisions there was no column anywhere that could say which.
#    Across this corpus: some stacks file couplings, some say nobody looked, one is a single
#    layer with no pair to couple, and NOT ONE says somebody looked and found independence.
#    The central assumption has never been confirmed and has once been contradicted.
#
# ⛔⛔ CORPUS ONLY, AND THE FIXTURE IS THE REASON THE RULE EXISTS. `every-absence.xml` asserts
#    independence ON PURPOSE, to prove the branch works. Counting a stipulation here would
#    answer "has anybody tested this?" with a yes that nobody earned -- which would turn the
#    finding into a lie.
-- pm:Stack/pm:Couplings/pm:Absent, over the corpus.
SELECT CASE
         WHEN s.answer IS NULL              THEN 'somebody looked and the layers MOVE TOGETHER'
         WHEN s.answer = 'none'             THEN 'somebody looked and found independence'
         WHEN s.answer = 'notApplicable'    THEN 'one layer; no pair to couple'
         ELSE 'NOBODY LOOKED'
       END AS the_independence_assumption,
       count(*) AS stacks
FROM (
    :compose(epistemics/searches.sqlc)
) s
JOIN (
    :compose(scope/corpus.sqlc)
) c USING (filing)
WHERE s.looked_for = 'couplings between layers'
GROUP BY 1 ORDER BY 2 DESC
