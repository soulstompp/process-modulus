    <!-- the United States has no national chart of accounts, so the entity is its own
         authority -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:group:us-member:chart-of-accounts</pm:taxonomy>
        <pm:value>us-member-2026</pm:value>
      </pm:term>
    </pm:chart>
  </pm:regime>

  <pm:stack>
