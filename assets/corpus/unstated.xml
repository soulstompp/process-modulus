<?xml version="1.0" encoding="UTF-8"?>
<!--
  What a sender may decline, and how, with illustrative figures.

  The other examples state what they know. This one shows the other half of the bargain:
  the schema requires elements because a typed absence is a legitimate answer, and a
  required element with no way to decline it forces a sender to invent a fact. Each
  declination below takes the place of a workaround that would assert something the
  sender does not believe:

    * A framework nobody has named yet. `r1` reports under something, and which one is
      unassigned. Without the absence, the only moves would be to invent a value or to
      leave the regime out, and leaving it out reads the same as reporting under none.

    * A chart that follows an unnamed framework. `r1` declines its chart too, for a
      reason `none` would get wrong: the size tier picks the framework and the framework
      picks the chart, so there will be one, and nobody has said which.

    * Reporting under no framework, on purpose. `r2` is the other half of that pair:
      somebody looked, and there is no framework. It also writes its own chart: with no
      publishing authority to borrow from, the entity is the authority for its own
      account list, and naming itself fills `BorrowedTerm` honestly rather than evading
      it. A US filing needs the same move, since the United States has no national chart
      of accounts.

    * Questions that do not apply. A margin ratio is not a supply: nothing queues for
      it, it commits no amount, it is bought neither in whole units nor continuously, it
      produces nothing to build ahead, and it has no nameplate for a demand to come off.
      Each of those is filed `notApplicable`. Without that, the only way to file the
      divisibility would be to assert `continuous` and deny it inside its `premium`,
      where no query would meet the denial.

    * A fact not yet established. Whether a resource can be driven past its rating is
      often the one thing a new sender has not determined, so it is filed `unmeasured`.

  The remainder is where the difference matters most: it is `notApplicable`, not `none`,
  because `none` would claim the remainder is zero.
-->
<pm:processModulus xmlns:pm="https://example.invalid/process-flow/1.0">

  <!-- Which filing this is: the URN a part or a dependence cites to point at this
       document. -->
  <pm:notation>
    <pm:uri>urn:example:filing:acme-platform:2026-08-30-margin</pm:uri>
  </pm:notation>
  <pm:evidence>
    <pm:attests>observation</pm:attests>
  </pm:evidence>

  <!-- reports under something not yet named -->
  <pm:regime>
    <pm:id>r1</pm:id>
    <pm:jurisdiction>PT</pm:jurisdiction>
    <pm:framework>
      <pm:absent>
        <pm:reason>unmeasured</pm:reason>
        <pm:note>the entity's size tier is unassigned, so the framework it selects is not yet known</pm:note>
        <pm:provenance><pm:party>registrar</pm:party>
          <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
        </pm:provenance>
      </pm:absent>
    </pm:framework>
    <!-- The chart follows the framework. The size tier picks the framework and the
         framework picks the chart, so a tier nobody has assigned leaves both unnamed.
         Not `none`: there will be a chart, and nobody has said which. -->
    <pm:chart>
      <pm:absent>
        <pm:reason>unmeasured</pm:reason>
        <pm:note>the chart follows from the tier, which is unassigned</pm:note>
      </pm:absent>
    </pm:chart>
  </pm:regime>

  <!-- somebody looked: it reports under no framework, and writes its own chart -->
  <pm:regime>
    <pm:id>r2</pm:id>
    <pm:framework>
      <pm:absent>
        <pm:reason>none</pm:reason>
        <pm:note>an internal management view, answerable to no external framework</pm:note>
      </pm:absent>
    </pm:framework>
    <!-- A chart the entity writes itself names the entity as its own authority. `value`
         is the chart's edition, never a position; the position belongs to the answer. -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:entity-own-chart:2026</pm:taxonomy>
        <pm:value>internal-management-2026</pm:value>
      </pm:term>
    </pm:chart>
  </pm:regime>

  <pm:stack>
    <pm:scope>
      <pm:scope>
        <pm:extent>scoped</pm:extent>
        <pm:basis>one layer, on purpose: this filing exists to show a subject that is not a supply, and the entity plainly has others</pm:basis>
      </pm:scope>
    </pm:scope>
    <pm:layer>
      <pm:name>margin-ratio</pm:name>

      <pm:demand>
        <pm:amount>
          <pm:claim>
            <pm:low>18</pm:low>
            <pm:mostLikely>22</pm:mostLikely>
            <pm:high>25</pm:high>
            <pm:unit>percent</pm:unit>
            <pm:denominator>
              <pm:absent>
                <pm:reason>notApplicable</pm:reason>
              </pm:absent>
            </pm:denominator>
            <pm:narrowsWhen>
              <pm:narrowing>
                <pm:condition>the quarter closes and actual cost lands</pm:condition>
                <pm:kind>instrument</pm:kind>
              </pm:narrowing>
            </pm:narrowsWhen>
            <!-- what bounds the range, which is a different question from what would
                 narrow it -->
            <pm:boundOrigin>
              <pm:origin>policy</pm:origin>
            </pm:boundOrigin>
            <pm:provenance>
              <pm:party>finance</pm:party>
              <pm:enteredBy>analyst-04</pm:enteredBy>
              <pm:approvedBy>controller-01</pm:approvedBy>
              <pm:standing>
                <pm:term>
                  <pm:taxonomy>urn:example:assertion-standing:2026</pm:taxonomy>
                  <pm:value>reviewed-not-verified</pm:value>
                </pm:term>
              </pm:standing>
            </pm:provenance>
            <pm:asOf>2026-08-30</pm:asOf>
          </pm:claim>
        </pm:amount>
        <pm:patience>
          <pm:absent>
            <pm:reason>unmeasured</pm:reason>
          </pm:absent>
        </pm:patience>
      </pm:demand>

      <!-- the question does not apply: a ratio has no demand that queues, so asking
           whether it would wait has no answer -->
      <pm:timeSlack>
        <pm:absent>
          <pm:reason>notApplicable</pm:reason>
          <pm:note>a ratio is not served to anybody, so nobody waits for it</pm:note>
        </pm:absent>
      </pm:timeSlack>

      <pm:supply>
        <pm:label>a ratio, which is not a supply</pm:label>
        <pm:nameplate>
          <pm:amount>
            <pm:absent><pm:reason>notApplicable</pm:reason></pm:absent>
          </pm:amount>

          <!-- the question does not apply, rather than going unanswered: there is no
               committed amount here, so there is nobody to ask about changing it -->
          <pm:amountOrigin>
            <pm:absent>
              <pm:reason>notApplicable</pm:reason>
              <pm:note>a ratio commits no amount, so no authority sets how much of it is held</pm:note>
            </pm:absent>
          </pm:amountOrigin>

          <!-- the axis does not apply -->
          <pm:divisibility>
            <pm:absent>
              <pm:reason>notApplicable</pm:reason>
              <pm:note>a ratio is bought in neither units nor continuously; there is no premium for leaving the type</pm:note>
            </pm:absent>
          </pm:divisibility>

          <!-- not yet established, and saying so beats guessing -->
          <pm:capacitySlack>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>nobody has determined whether this can be driven past its rating</pm:note>
            </pm:absent>
          </pm:capacitySlack>

          <!-- the inventory slack, declined for the same reason as the others: there is
               no output here to hold ahead of anything -->
          <pm:inventorySlack>
            <pm:absent>
              <pm:reason>notApplicable</pm:reason>
              <pm:note>a ratio produces nothing that could be built in advance</pm:note>
            </pm:absent>
          </pm:inventorySlack>
        </pm:nameplate>

        <pm:jagged>
          <pm:draw>
            <pm:absent><pm:reason>notApplicable</pm:reason></pm:absent>
          </pm:draw>
          <pm:measurementBasis>
            <pm:absent><pm:reason>notApplicable</pm:reason></pm:absent>
          </pm:measurementBasis>
        </pm:jagged>
      </pm:supply>

      <!-- the question does not apply, for the same reason as the others above, and this
           one is easy to get wrong. There is no nameplate here for demand to come off, so
           the remainder has no answer, rather than an answer of nothing. Not `none`: that
           would say the remainder is zero, and a zero remainder is filed as a remainder
           with a `clearance` sign and a quantity of zero, which is a filing, not an
           absence. -->
      <pm:remainder>
        <pm:absent>
          <pm:reason>notApplicable</pm:reason>
          <pm:note>a ratio commits no nameplate, so there is nothing for a demand to be subtracted from</pm:note>
        </pm:absent>
      </pm:remainder>
    </pm:layer>
    <pm:couplings>
      <pm:absent>
        <pm:reason>notApplicable</pm:reason>
        <pm:note>a one-layer stack. There is no pair to couple, so the question has no population here</pm:note>
      </pm:absent>
    </pm:couplings>
  </pm:stack>
</pm:processModulus>
