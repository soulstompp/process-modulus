<?xml version="1.0" encoding="UTF-8"?>
<!--
  One witness's claim about a corpus of questions, with illustrative keys and codes.

  The chart in `holds` is the entity's own: the United States has no national chart of
  accounts. Spain (PGC) and Sweden (BAS) have national ones, and Portugal has the SNC
  chart; coverage-pt-ncrf-pe.xml answers four of these questions against it. That
  difference is why a position code cannot travel without the chart that codes it.

  Taxonomy URIs other than the FASB one are placeholders.
-->
<asrt:coverage xmlns:asrt="https://example.invalid/assertion/1.0"
               xmlns:pm="https://example.invalid/process-flow/1.0">

  <asrt:witness>gaap-us</asrt:witness>
  <asrt:evidence>
    <pm:attests>observation</pm:attests>
  </asrt:evidence>

  <asrt:regime>
    <pm:id>us-gaap</pm:id>
    <pm:jurisdiction>US</pm:jurisdiction>
    <pm:framework>
      <pm:term>
        <pm:taxonomy>http://fasb.org/us-gaap</pm:taxonomy>
        <pm:value>us-gaap</pm:value>
      </pm:term>
    </pm:framework>
    <!-- The chart every `holds` below cites, declared and not only used. -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:acme-inc:chart-of-accounts</pm:taxonomy>
        <pm:value>acme-2026</pm:value>
      </pm:term>
    </pm:chart>
  </asrt:regime>

  <!-- Work people absorb, put to a standards model. It refuses, and the refusal is the
       answer, not a failure. -->
  <asrt:entry>
    <asrt:key>labor.absorbed-evening</asrt:key>
    <asrt:claimed>full</asrt:claimed>
    <asrt:answer>
      <asrt:refuses>
        <pm:taxonomy>urn:example:coding-pack:refusals</pm:taxonomy>
        <pm:value>not-a-financial-fact</pm:value>
      </asrt:refuses>
    </asrt:answer>
  </asrt:entry>

  <!-- Idle reserved capacity is transacted, so it has a position. -->
  <asrt:entry>
    <asrt:key>compute.reserved-block-idle</asrt:key>
    <asrt:claimed>full</asrt:claimed>
    <asrt:answer>
      <asrt:holds>
        <pm:taxonomy>urn:example:acme-inc:chart-of-accounts</pm:taxonomy>
        <pm:value>6250</pm:value>
      </asrt:holds>
    </asrt:answer>
  </asrt:entry>

  <!-- An obligation created at signature, cited. -->
  <asrt:entry>
    <asrt:key>offering.enterprise-obligation</asrt:key>
    <asrt:claimed>full</asrt:claimed>
    <asrt:answer>
      <asrt:refuses>
        <pm:taxonomy>urn:example:coding-pack:refusals</pm:taxonomy>
        <pm:value>needs-a-condition</pm:value>
      </asrt:refuses>
    </asrt:answer>
    <asrt:citation>
      <asrt:instrument>
        <pm:taxonomy>http://fasb.org/us-gaap</pm:taxonomy>
        <pm:value>ASC 606</pm:value>
      </asrt:instrument>
      <asrt:clause>606-10-25</asrt:clause>
      <asrt:version>2026</asrt:version>
    </asrt:citation>
  </asrt:entry>

  <!-- Not a failure. A standards model has no opinion about how many launches a quarter
       holds, and saying so is the correct answer. -->
  <asrt:entry>
    <asrt:key>capability.backlog</asrt:key>
    <asrt:claimed>none</asrt:claimed>
    <asrt:answer>
      <asrt:cannotAsk/>
    </asrt:answer>
  </asrt:entry>

  <!-- A declared divergence: this witness answers differently on purpose, and the reason
       travels with it. Without `exception`, it would read as a defect somebody stopped
       chasing. -->
  <asrt:entry>
    <asrt:key>labor.contractor-overtime</asrt:key>
    <asrt:claimed>full</asrt:claimed>
    <asrt:answer>
      <asrt:holds>
        <pm:taxonomy>urn:example:acme-inc:chart-of-accounts</pm:taxonomy>
        <pm:value>6110</pm:value>
      </asrt:holds>
    </asrt:answer>
    <asrt:exception>The corpus expects a refusal because absorbed work has no
                    counterparty. A contractor invoices, so the same physical excess
                    is a transacted position here: whether there is a counterparty
                    depends on the relationship, not on the work.</asrt:exception>
  </asrt:entry>

</asrt:coverage>
