      </pm:demand>
      <pm:timeSlack>
        <pm:claim>
          <pm:low>0</pm:low><pm:mostLikely>0</pm:mostLikely><pm:high>0</pm:high>
          <pm:unit>GPU</pm:unit>
          <pm:denominator>
            <pm:absent><pm:reason>notApplicable</pm:reason></pm:absent>
          </pm:denominator>
          <!-- One value has no range to tighten, so `notApplicable`. -->
          <pm:narrowsWhen><pm:absent><pm:reason>notApplicable</pm:reason></pm:absent></pm:narrowsWhen>
          <pm:boundOrigin><pm:origin>intrinsic</pm:origin></pm:boundOrigin>
          <pm:provenance>
            <pm:party>platform</pm:party>
            <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason></pm:absent></pm:standing>
            <pm:note>an inference request that waits until tomorrow was not served. At this layer’s granularity the demand does not survive being held at all</pm:note>
          </pm:provenance>
        </pm:claim>
      </pm:timeSlack>
      <pm:supply>
        <pm:label>reserved inference capacity</pm:label>
        <pm:nameplate>
          <pm:amount>
            <pm:claim>
              <pm:low>16</pm:low><pm:mostLikely>16</pm:mostLikely><pm:high>16</pm:high>
              <pm:unit>GPU</pm:unit>
              <pm:denominator>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                </pm:absent>
              </pm:denominator>
              <pm:narrowsWhen>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>there is no range here to tighten</pm:note>
                </pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
                <pm:derivation>
                  <pm:identity>amountOrigin</pm:identity>
                  <pm:note>`Nameplate/amountOrigin` says who could have held a different number of these, one element over. Reading the same fact twice is how the two come to disagree</pm:note>
                </pm:derivation>
              </pm:boundOrigin>
            </pm:claim>
          </pm:amount>
          <!-- raising this from 8 to 16 is the intervention the coupling below was
