              <pm:narrowsWhen><pm:absent><pm:reason>notApplicable</pm:reason></pm:absent></pm:narrowsWhen>
              <pm:boundOrigin><pm:origin>intrinsic</pm:origin></pm:boundOrigin>
              <pm:provenance>
                <pm:party>platform</pm:party>
                <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason></pm:absent></pm:standing>
                <pm:note>a reserved card-hour not drawn is gone; there is nothing to build ahead</pm:note>
