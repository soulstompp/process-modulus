        </pm:nameplate>
        <pm:jagged>
          <pm:draw>
            <pm:claim>
              <pm:low>47</pm:low>
              <pm:mostLikely>47</pm:mostLikely>
              <pm:high>47</pm:high>
              <pm:unit>TB</pm:unit>
              <pm:denominator>
