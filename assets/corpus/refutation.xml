                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>a count of what was actually served. Nothing sets its edge and there is nobody to negotiate one</pm:note>
                </pm:absent>
              </pm:boundOrigin>
            </pm:claim>
          </pm:draw>
          <pm:measurementBasis>
            <pm:absent><pm:reason>notApplicable</pm:reason></pm:absent>
          </pm:measurementBasis>
        </pm:jagged>
      </pm:supply>
      <pm:remainder>
        <pm:remainder>
          <!-- A `transition` fit, which is why the value exists. Demand of 11.0, 13.2 and
               16.4 GPU against a nameplate of 16 overlaps it: 5.0 GPU spare at the bottom
               of the range and 0.4 GPU short at the top, both true of one layer.
               The remainder's quantity cannot carry the second half. It is 0.0, 2.8 and
               5.0 GPU, the spare side, because that side is the larger, and the 0.4 short
               sits inside it looking exactly like 0.4 spare. The shortfall comes from the
               demand and the nameplate instead: the highest demand less the nameplate,
               0.4 GPU. -->
          <pm:sign><pm:fit>transition</pm:fit></pm:sign>
          <pm:absorber>
            <pm:term>
              <pm:taxonomy>urn:example:factory-physics:buffers</pm:taxonomy>
              <pm:value>capacity</pm:value>
            </pm:term>
          </pm:absorber>
          <pm:holder>
            <pm:holder>
              <pm:kind>booked</pm:kind>
              <pm:share>
                <pm:claim>
                  <pm:low>0.0</pm:low><pm:mostLikely>2.8</pm:mostLikely><pm:high>5.0</pm:high>
                  <pm:unit>GPU</pm:unit>
                  <pm:denominator>
                    <pm:absent>
                      <pm:reason>notApplicable</pm:reason>
                    </pm:absent>
                  </pm:denominator>
