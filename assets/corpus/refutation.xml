        </pm:nameplate>
        <pm:jagged>
          <pm:draw>
            <pm:claim>
              <pm:low>13.2</pm:low><pm:mostLikely>13.2</pm:mostLikely><pm:high>13.2</pm:high>
              <pm:unit>GPU</pm:unit>
              <pm:denominator>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                </pm:absent>
              </pm:denominator>
              <pm:narrowsWhen>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>there is no range here to tighten</pm:note>
                </pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
