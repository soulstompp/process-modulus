        <pm:value>NCRF-PE</pm:value>
      </pm:term>
    </pm:framework>
    <!-- There is a national chart here, so the entity borrows its chart instead of being
         its own authority, unlike the sibling, which names itself. -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:pt:snc:chart</pm:taxonomy>
        <pm:value>SNC-2026</pm:value>
