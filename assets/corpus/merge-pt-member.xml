<!--
  THE SIBLING MEMBER, FILED IN PORTUGAL. Read with merge-us-member.xml, where the
  three cases this pair arranges are listed. Illustrative figures.

  What to read closely here:

    * ⭐ `pessoal` IS THE SIBLING'S `labour`, and the contributed facts agree
      exactly: the same `interference`, the same `capacity` absorber cited from the
      same URI, the same `people` among its holders. Every one of those compares
      with no negotiation at all. THE NAMES DO NOT, AND NEITHER DO THE UNITS.

    * ⭐⭐ AND ITS REMAINDER IS PARTLY VISIBLE, where the sibling's is not. This
      entity operates an hours bank, so part of the excess absorbed by its people
      becomes an obligation it must carry — a `booked` holder with a number in it,
      beside the `people` holder that has no instrument. Same layer, same fit, same
      absorber, DIFFERENT HOLDERS, and the difference is jurisdictional rather than
      managerial. Neither filing is more honest than the other.

    * ⛔ `compute` SHARES ONLY A WORD with the sibling's. A different vendor sells a
      monthly reservation metered in GPU-hours. Nothing in either document says
      these are two layers; nothing says they are one either.

    * ⚠️ THE ABSORBER ON `capacidade-instalada` CITES A TRANSLATED EDITION of the
      buffer vocabulary, which is what its internal reporting is written against.
      `capacidade` and `capacity` are the same buffer. A bare code would have made
      them look like a disagreement; the taxonomy makes them a FORK, visible and
      resolvable by whoever owns the two editions.

  ⚠️ Illustrative. Taxonomy URIs and figures are placeholders, and the hours-bank
  arrangement is sketched only as far as this model needs it.
-->
<pm:processModulus xmlns:pm="https://example.invalid/process-flow/1.0">

  <!-- ⭐ WHICH FILING THIS IS. A part elsewhere cites exactly this URN;
       before S-28 was repaired no document could say it. -->
  <pm:notation>
    <pm:uri>urn:example:filing:pt-member:2026-08-31</pm:uri>
  </pm:notation>

  <pm:regime>
    <pm:id>ies-anexo-asnc</pm:id>
    <pm:jurisdiction>PT</pm:jurisdiction>
    <pm:framework>
      <pm:term>
        <pm:taxonomy>urn:example:pt:ies:anexo-asnc</pm:taxonomy>
        <pm:value>NCRF-PE</pm:value>
      </pm:term>
    </pm:framework>
    <!-- ⭐ THERE IS A NATIONAL CHART HERE, so the entity borrows rather than
         authors. Contrast the sibling, which had to name itself. -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:pt:snc:chart</pm:taxonomy>
        <pm:value>SNC-2026</pm:value>
      </pm:term>
    </pm:chart>
  </pm:regime>

  <pm:stack>
    <pm:scope>
      <pm:scope>
        <pm:extent>unbounded</pm:extent>
        <pm:basis>o que este membro reporta ao abrigo da instrução do grupo, e ninguém perguntou o que fica fora disso</pm:basis>
      </pm:scope>
    </pm:scope>

    <!-- ============================================================
         PESSOAL. The sibling's `labour`, under another flag.
         ============================================================ -->
    <pm:layer>
      <pm:name>pessoal</pm:name>

      <pm:demand>
        <pm:claim>
          <pm:low>6.4</pm:low>
          <pm:mostLikely>7.1</pm:mostLikely>
          <pm:high>8.2</pm:high>
          <pm:unit>pessoas</pm:unit>
          <pm:narrowsWhen>
            <pm:narrowing>
              <pm:condition>as horas de apoio passam a ser registadas em vez de estimadas</pm:condition>
              <pm:kind>instrument</pm:kind>
            </pm:narrowing>
          </pm:narrowsWhen>
          <pm:boundOrigin>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>nada fixa este limite. O intervalo é onde as observações caíram e não onde uma regra as pôs, portanto não há aqui alavanca nenhuma a procurar</pm:note>
            </pm:absent>
          </pm:boundOrigin>
          <pm:provenance><pm:party>pt-member</pm:party>
            <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>não há vocabulário de legitimidade publicado para esta afirmação</pm:note></pm:absent></pm:standing>
          </pm:provenance>
          <pm:asOf>2026-08-31</pm:asOf>
        </pm:claim>
      </pm:demand>
      <pm:timeSlack>
        <pm:absent>
          <pm:reason>unmeasured</pm:reason>
          <pm:note>o trabalho em fila sobrevive de facto à espera, e quanto tempo até se perder em silêncio nunca foi medido. O trabalho que se perde pertence a `unrealised` e não a `people` — o que diz ONDE tal trabalho seria declarado, e não que parte deste resto lá esteja: as parcelas abaixo já o esgotam</pm:note>
        </pm:absent>
      </pm:timeSlack>

      <pm:supply>
        <pm:label>a equipa de entrega</pm:label>
        <pm:nameplate>
          <pm:amount>
            <pm:claim>
              <pm:low>6</pm:low>
              <pm:mostLikely>6</pm:mostLikely>
              <pm:high>6</pm:high>
              <pm:unit>pessoas</pm:unit>
              <pm:narrowsWhen>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>não há aqui intervalo para estreitar</pm:note>
                </pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
                <pm:absent>
                  <pm:reason>derived</pm:reason>
                  <pm:note>o `Nameplate/amountOrigin` diz quem poderia ter detido um número diferente destas, um elemento ao lado. Registar o mesmo facto duas vezes é como os dois acabam por divergir</pm:note>
                </pm:absent>
              </pm:boundOrigin>
            </pm:claim>
          </pm:amount>
          <pm:amountOrigin><pm:origin>policy</pm:origin></pm:amountOrigin>
          <pm:divisibility>
            <pm:divisibility>
              <pm:lumpy>
                <pm:size>
                  <pm:claim>
                    <pm:low>1</pm:low>
                    <pm:mostLikely>1</pm:mostLikely>
                    <pm:high>1</pm:high>
                    <pm:unit>pessoas</pm:unit>
                    <pm:narrowsWhen>
                      <pm:absent>
                        <pm:reason>notApplicable</pm:reason>
                        <pm:note>não há aqui intervalo para estreitar</pm:note>
                      </pm:absent>
                    </pm:narrowsWhen>
                    <pm:boundOrigin>
                      <pm:absent>
                        <pm:reason>derived</pm:reason>
                        <pm:note>o `LumpyQuantum/origin` diz quem fixa o tamanho de uma unidade, neste mesmo elemento</pm:note>
                      </pm:absent>
                    </pm:boundOrigin>
                  </pm:claim>
                </pm:size>
                <pm:origin>intrinsic</pm:origin>
              </pm:lumpy>
              <pm:window>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>`pessoas` é uma existência sem período</pm:note>
                </pm:absent>
              </pm:window>
            </pm:divisibility>
          </pm:divisibility>
          <pm:capacitySlack>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>uma pessoa pode trabalhar acima da sua capacidade nominal e na maioria das pilhas é a única oferta que o consegue. ATÉ QUE PONTO ACIMA, e durante quanto tempo, ninguém aqui mediu — que é todo o assunto deste modelo e a razão de isto não ser um valor booleano</pm:note>
            </pm:absent>
          </pm:capacitySlack>
          <!-- ⛔ STILL FALSE, AND THE HOURS BANK DOES NOT CHANGE IT. Banking an
               hour creates an OBLIGATION to give it back; it does not put a
               person-hour on a shelf to serve next week's demand. The instrument
               makes part of the excess countable, not storable. -->
          <pm:inventorySlack>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>a capacidade não usada hoje está PERDIDA. As horas não usadas da semana passada não podem ser armazenadas para servir esta semana, e é por isso que `absorber = inventory` nesta camada é lisamente falso</pm:note>
            </pm:absent>
          </pm:inventorySlack>
        </pm:nameplate>
        <pm:jagged>
          <pm:draw>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>as horas absorvidas acima do quadro não são integralmente registadas</pm:note>
              <pm:provenance><pm:party>pt-member</pm:party>
                <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>não há vocabulário de legitimidade publicado para esta afirmação</pm:note></pm:absent></pm:standing>
              </pm:provenance>
              <pm:asOf>2026-08-31</pm:asOf>
            </pm:absent>
          </pm:draw>
          <pm:measurementBasis>
            <pm:absent>
              <pm:reason>notApplicable</pm:reason>
              <pm:note>não há aqui uma valorização que possa ter uma base</pm:note>
            </pm:absent>
          </pm:measurementBasis>
        </pm:jagged>
      </pm:supply>

      <pm:remainder>
        <pm:remainder>
          <pm:sign><pm:fit>interference</pm:fit></pm:sign>
          <!-- ⭐ THE SAME URI THE SIBLING CITES. This is the comparison working. -->
          <pm:absorber>
            <pm:term>
              <pm:taxonomy>urn:example:factory-physics:buffers</pm:taxonomy>
              <pm:value>capacity</pm:value>
            </pm:term>
          </pm:absorber>
          <!-- ⭐⭐⭐ TWO HOLDERS WHERE THE SIBLING HAS ONE, AND THE EXTRA ONE IS AN
               INSTRUMENT RATHER THAN A CHOICE. Hours banked are owed back and
               accrue, so that part of the absorption has a counterparty, a number
               and a date. The rest is absorbed exactly as it is in the sibling
               filing, and is exactly as invisible.

               The shares sum to the derived magnitude:
                 [0.3, 0.7, 1.4] + [0.1, 0.4, 0.8] = [0.4, 1.1, 2.2] -->
          <pm:holder>
            <pm:holder>
              <pm:kind>booked</pm:kind>
              <pm:share>
                <pm:claim>
                  <pm:low>0.3</pm:low>
                  <pm:mostLikely>0.7</pm:mostLikely>
                  <pm:high>1.4</pm:high>
                  <pm:unit>pessoas</pm:unit>
                  <pm:narrowsWhen>
                    <pm:narrowing>
                      <pm:condition>o saldo do banco de horas é fechado no final do período de referência</pm:condition>
                      <pm:kind>intervention</pm:kind>
                    </pm:narrowing>
                  </pm:narrowsWhen>
                  <pm:boundOrigin>
                    <pm:absent>
                      <pm:reason>none</pm:reason>
                      <pm:note>nada fixa este limite. É quanto do resto se observou este detentor a assumir</pm:note>
                    </pm:absent>
                  </pm:boundOrigin>
                  <pm:provenance><pm:party>pt-member</pm:party>
                    <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>não há vocabulário de legitimidade publicado para esta afirmação</pm:note></pm:absent></pm:standing>
                  </pm:provenance>
                  <pm:asOf>2026-08-31</pm:asOf>
                </pm:claim>
              </pm:share>
            </pm:holder>
          </pm:holder>
          <pm:holder>
            <pm:holder>
              <pm:kind>people</pm:kind>
              <pm:share>
                <pm:claim>
                  <pm:low>0.1</pm:low>
                  <pm:mostLikely>0.4</pm:mostLikely>
                  <pm:high>0.8</pm:high>
                  <pm:unit>pessoas</pm:unit>
                  <pm:narrowsWhen>
                    <pm:absent>
                      <pm:reason>unmeasured</pm:reason>
                      <pm:note>ninguém disse o que estreitaria este intervalo</pm:note>
                    </pm:absent>
                  </pm:narrowsWhen>
                  <pm:boundOrigin>
                    <pm:absent>
                      <pm:reason>none</pm:reason>
                      <pm:note>nada fixa este limite. É quanto do resto se observou este detentor a assumir</pm:note>
                    </pm:absent>
                  </pm:boundOrigin>
                  <pm:provenance><pm:party>pt-member</pm:party>
                    <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>não há vocabulário de legitimidade publicado para esta afirmação</pm:note></pm:absent></pm:standing>
                  </pm:provenance>
                  <pm:asOf>2026-08-31</pm:asOf>
                </pm:claim>
              </pm:share>
            </pm:holder>
          </pm:holder>
          <!-- derived: |6 - [6.4, 7.1, 8.2]| = [0.4, 1.1, 2.2] pessoas -->
