<?xml version="1.0" encoding="UTF-8"?>
<!--
  THE SIBLING MEMBER, FILED IN PORTUGAL. Read with merge-us-member.xml, where the
  three cases this pair arranges are listed. Illustrative figures.

  What to read closely here:

    * ⭐ `pessoal` IS THE SIBLING'S `labour`, and the contributed facts agree
      exactly: the same `interference`, the same `capacity` absorber cited from the
      same URI, the same `people` among its holders. Every one of those compares
      with no negotiation at all. THE NAMES DO NOT, AND NEITHER DO THE UNITS.

    * ⭐⭐ AND ITS REMAINDER IS PARTLY VISIBLE, where the sibling's is not. This
      entity operates an hours bank, so part of the excess absorbed by its people
      becomes an obligation it must carry — a `booked` holder with a number in it,
      beside the `people` holder that has no instrument. Same layer, same fit, same
      absorber, DIFFERENT HOLDERS, and the difference is jurisdictional rather than
      managerial. Neither filing is more honest than the other.

    * ⛔ `compute` SHARES ONLY A WORD with the sibling's. A different vendor sells a
      monthly reservation metered in GPU-hours. Nothing in either document says
      these are two layers; nothing says they are one either.

    * ⚠️ THE ABSORBER ON `capacidade-instalada` CITES A TRANSLATED EDITION of the
      buffer vocabulary, which is what its internal reporting is written against.
      `capacidade` and `capacity` are the same buffer. A bare code would have made
      them look like a disagreement; the taxonomy makes them a FORK, visible and
      resolvable by whoever owns the two editions.

  ⚠️ Illustrative. Taxonomy URIs and figures are placeholders, and the hours-bank
  arrangement is sketched only as far as this model needs it.
-->
<pm:processModulus xmlns:pm="https://example.invalid/process-flow/1.0">

  <!-- ⭐ WHICH FILING THIS IS. A part elsewhere cites exactly this URN;
       before S-28 was repaired no document could say it. -->
  <pm:notation>
    <pm:uri>urn:example:filing:pt-member:2026-08-31</pm:uri>
  </pm:notation>

  <pm:regime>
    <pm:id>ies-anexo-asnc</pm:id>
    <pm:jurisdiction>PT</pm:jurisdiction>
    <pm:framework>
      <pm:term>
        <pm:taxonomy>urn:example:pt:ies:anexo-asnc</pm:taxonomy>
        <pm:value>NCRF-PE</pm:value>
      </pm:term>
    </pm:framework>
    <!-- ⭐ THERE IS A NATIONAL CHART HERE, so the entity borrows rather than
         authors. Contrast the sibling, which had to name itself. -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:pt:snc:chart</pm:taxonomy>
        <pm:value>SNC-2026</pm:value>
      </pm:term>
    </pm:chart>
  </pm:regime>

  <pm:stack>
    <pm:scope>
      <pm:scope>
        <pm:extent>unbounded</pm:extent>
        <pm:basis>o que este membro reporta; what this member files under the group instruction, and nobody has asked what lies outside it</pm:basis>
      </pm:scope>
    </pm:scope>

    <!-- ============================================================
         PESSOAL. The sibling's `labour`, under another flag.
         ============================================================ -->
    <pm:layer>
      <pm:name>pessoal</pm:name>

      <pm:demand>
        <pm:claim>
          <pm:low>6.4</pm:low>
          <pm:mostLikely>7.1</pm:mostLikely>
          <pm:high>8.2</pm:high>
          <pm:unit>pessoas</pm:unit>
          <pm:narrowsWhen>
            <pm:narrowing>
              <pm:condition>as horas de apoio passam a ser registadas em vez de estimadas</pm:condition>
              <pm:kind>instrument</pm:kind>
            </pm:narrowing>
          </pm:narrowsWhen>
          <pm:boundOrigin>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>nothing sets this bound. The range is where the observations fell, not where a rule put them, so there is no lever here to look for</pm:note>
            </pm:absent>
          </pm:boundOrigin>
          <pm:provenance><pm:party>pt-member</pm:party>
            <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
          </pm:provenance>
          <pm:asOf>2026-08-31</pm:asOf>
        </pm:claim>
      </pm:demand>
      <pm:timeSlack>
        <pm:absent>
          <pm:reason>unmeasured</pm:reason>
          <pm:note>queued work does survive sitting, and how long before it quietly ages out has never been measured. Work that ages out belongs to `unrealised` and not `people` — which says WHERE such work would be filed, not that any of this remainder is there: the shares below already account for all of it</pm:note>
        </pm:absent>
      </pm:timeSlack>

      <pm:supply>
        <pm:label>a equipa de entrega</pm:label>
        <pm:nameplate>
          <pm:amount>
            <pm:claim>
              <pm:low>6</pm:low>
              <pm:mostLikely>6</pm:mostLikely>
              <pm:high>6</pm:high>
              <pm:unit>pessoas</pm:unit>
              <pm:narrowsWhen>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>there is no range here to tighten</pm:note>
                </pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
                <pm:absent>
                  <pm:reason>derived</pm:reason>
                  <pm:note>`Nameplate/amountOrigin` says who could have held a different number of these, one element over. Reading the same fact twice is how the two come to disagree</pm:note>
                </pm:absent>
              </pm:boundOrigin>
            </pm:claim>
          </pm:amount>
          <pm:amountOrigin><pm:origin>policy</pm:origin></pm:amountOrigin>
          <pm:divisibility>
            <pm:divisibility>
              <pm:lumpy>
                <pm:size>
                  <pm:claim>
                    <pm:low>1</pm:low>
                    <pm:mostLikely>1</pm:mostLikely>
                    <pm:high>1</pm:high>
                    <pm:unit>pessoas</pm:unit>
                    <pm:narrowsWhen>
                      <pm:absent>
                        <pm:reason>notApplicable</pm:reason>
                        <pm:note>there is no range here to tighten</pm:note>
                      </pm:absent>
                    </pm:narrowsWhen>
                    <pm:boundOrigin>
                      <pm:absent>
                        <pm:reason>derived</pm:reason>
                        <pm:note>`LumpyQuantum/origin` says who sets the size of one unit, in this same element</pm:note>
                      </pm:absent>
                    </pm:boundOrigin>
                  </pm:claim>
                </pm:size>
                <pm:origin>intrinsic</pm:origin>
              </pm:lumpy>
              <pm:window>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>`pessoas` is a stock with no period</pm:note>
                </pm:absent>
              </pm:window>
            </pm:divisibility>
          </pm:divisibility>
          <pm:capacitySlack>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>a person can work above their rating and in most stacks is the only supply that can. HOW FAR ABOVE, and for how long, nobody here has measured — which is the whole of this model’s subject and the reason this is not a boolean</pm:note>
            </pm:absent>
          </pm:capacitySlack>
          <!-- ⛔ STILL FALSE, AND THE HOURS BANK DOES NOT CHANGE IT. Banking an
               hour creates an OBLIGATION to give it back; it does not put a
               person-hour on a shelf to serve next week's demand. The instrument
               makes part of the excess countable, not storable. -->
          <pm:inventorySlack>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>capacity not used today is GONE. Last week’s unused hours cannot be stockpiled to serve this week, which is why `absorber = inventory` on this layer is flatly false</pm:note>
            </pm:absent>
          </pm:inventorySlack>
        </pm:nameplate>
        <pm:jagged>
          <pm:draw>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>as horas absorvidas acima do quadro não são integralmente registadas</pm:note>
              <pm:provenance><pm:party>pt-member</pm:party>
                <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
              </pm:provenance>
              <pm:asOf>2026-08-31</pm:asOf>
            </pm:absent>
          </pm:draw>
          <pm:measurementBasis>
            <pm:absent>
              <pm:reason>notApplicable</pm:reason>
              <pm:note>não há aqui uma valorização que possa ter uma base</pm:note>
            </pm:absent>
          </pm:measurementBasis>
        </pm:jagged>
      </pm:supply>

      <pm:remainder>
        <pm:remainder>
          <pm:sign><pm:fit>interference</pm:fit></pm:sign>
          <!-- ⭐ THE SAME URI THE SIBLING CITES. This is the comparison working. -->
          <pm:absorber>
            <pm:term>
              <pm:taxonomy>urn:example:factory-physics:buffers</pm:taxonomy>
              <pm:value>capacity</pm:value>
            </pm:term>
          </pm:absorber>
          <!-- ⭐⭐⭐ TWO HOLDERS WHERE THE SIBLING HAS ONE, AND THE EXTRA ONE IS AN
               INSTRUMENT RATHER THAN A CHOICE. Hours banked are owed back and
               accrue, so that part of the absorption has a counterparty, a number
               and a date. The rest is absorbed exactly as it is in the sibling
               filing, and is exactly as invisible.

               The shares sum to the derived magnitude:
                 [0.3, 0.7, 1.4] + [0.1, 0.4, 0.8] = [0.4, 1.1, 2.2] -->
          <pm:holder>
            <pm:holder>
              <pm:kind>booked</pm:kind>
              <pm:share>
                <pm:claim>
                  <pm:low>0.3</pm:low>
                  <pm:mostLikely>0.7</pm:mostLikely>
                  <pm:high>1.4</pm:high>
                  <pm:unit>pessoas</pm:unit>
                  <pm:narrowsWhen>
                    <pm:narrowing>
                      <pm:condition>o saldo do banco de horas é fechado no final do período de referência</pm:condition>
                      <pm:kind>intervention</pm:kind>
                    </pm:narrowing>
                  </pm:narrowsWhen>
                  <pm:boundOrigin>
                    <pm:absent>
                      <pm:reason>none</pm:reason>
                      <pm:note>nothing sets this bound. It is how much of the remainder this holder was observed to take</pm:note>
                    </pm:absent>
                  </pm:boundOrigin>
                  <pm:provenance><pm:party>pt-member</pm:party>
                    <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
                  </pm:provenance>
                  <pm:asOf>2026-08-31</pm:asOf>
                </pm:claim>
              </pm:share>
            </pm:holder>
          </pm:holder>
          <pm:holder>
            <pm:holder>
              <pm:kind>people</pm:kind>
              <pm:share>
                <pm:claim>
                  <pm:low>0.1</pm:low>
                  <pm:mostLikely>0.4</pm:mostLikely>
                  <pm:high>0.8</pm:high>
                  <pm:unit>pessoas</pm:unit>
                  <pm:narrowsWhen>
                    <pm:absent>
                      <pm:reason>unmeasured</pm:reason>
                      <pm:note>nobody has said what would tighten this range</pm:note>
                    </pm:absent>
                  </pm:narrowsWhen>
                  <pm:boundOrigin>
                    <pm:absent>
                      <pm:reason>none</pm:reason>
                      <pm:note>nothing sets this bound. It is how much of the remainder this holder was observed to take</pm:note>
                    </pm:absent>
                  </pm:boundOrigin>
                  <pm:provenance><pm:party>pt-member</pm:party>
                    <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
                  </pm:provenance>
                  <pm:asOf>2026-08-31</pm:asOf>
                </pm:claim>
              </pm:share>
            </pm:holder>
          </pm:holder>
          <!-- derived: |6 - [6.4, 7.1, 8.2]| = [0.4, 1.1, 2.2] pessoas -->
          <pm:quantity>
            <pm:absent>
              <pm:reason>derived</pm:reason>
              <pm:note>computable from this layer's demand and nameplate; the receiver computes it</pm:note>
            </pm:absent>
          </pm:quantity>
        </pm:remainder>
      </pm:remainder>
    </pm:layer>

    <!-- ============================================================
         COMPUTE. ⛔ SAME TOKEN AS THE SIBLING'S, DIFFERENT LAYER.
         ============================================================ -->
    <pm:layer>
      <pm:name>compute</pm:name>

      <pm:demand>
        <pm:claim>
          <pm:low>430</pm:low>
          <pm:mostLikely>545</pm:mostLikely>
          <pm:high>690</pm:high>
          <pm:unit>GPU-hour</pm:unit>
          <pm:narrowsWhen>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>nobody has said what would tighten this range</pm:note>
            </pm:absent>
          </pm:narrowsWhen>
          <pm:boundOrigin>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>nothing sets this bound. The range is where the observations fell, not where a rule put them, so there is no lever here to look for</pm:note>
            </pm:absent>
          </pm:boundOrigin>
          <pm:provenance><pm:party>pt-member</pm:party>
            <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
          </pm:provenance>
          <pm:asOf>2026-08-31</pm:asOf>
        </pm:claim>
      </pm:demand>
      <pm:timeSlack>
        <pm:absent>
          <pm:reason>none</pm:reason>
          <pm:note>an inference request that waits until tomorrow was not served. At this layer’s granularity the demand does not survive being held at all</pm:note>
        </pm:absent>
      </pm:timeSlack>

      <pm:supply>
        <pm:label>reserva mensal junto de outro fornecedor, faturada à hora</pm:label>
        <pm:nameplate>
          <pm:amount>
            <pm:claim>
              <pm:low>720</pm:low>
              <pm:mostLikely>720</pm:mostLikely>
              <pm:high>720</pm:high>
              <pm:unit>GPU-hour</pm:unit>
              <pm:narrowsWhen>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>there is no range here to tighten</pm:note>
                </pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
                <pm:absent>
                  <pm:reason>derived</pm:reason>
                  <pm:note>`Nameplate/amountOrigin` says who could have held a different number of these, one element over. Reading the same fact twice is how the two come to disagree</pm:note>
                </pm:absent>
              </pm:boundOrigin>
            </pm:claim>
          </pm:amount>
          <pm:amountOrigin><pm:origin>policy</pm:origin></pm:amountOrigin>
          <pm:divisibility>
            <pm:divisibility>
              <pm:lumpy>
                <pm:size>
                  <pm:claim>
                    <pm:low>720</pm:low>
                    <pm:mostLikely>720</pm:mostLikely>
                    <pm:high>720</pm:high>
                    <pm:unit>GPU-hour</pm:unit>
                    <pm:narrowsWhen>
                      <pm:absent>
                        <pm:reason>notApplicable</pm:reason>
                        <pm:note>there is no range here to tighten</pm:note>
                      </pm:absent>
                    </pm:narrowsWhen>
                    <pm:boundOrigin>
                      <pm:absent>
                        <pm:reason>derived</pm:reason>
                        <pm:note>`LumpyQuantum/origin` says who sets the size of one unit, in this same element</pm:note>
                      </pm:absent>
                    </pm:boundOrigin>
                  </pm:claim>
                </pm:size>
                <pm:origin>contractual</pm:origin>
              </pm:lumpy>
              <pm:window>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>`GPU-hour` carries its hour in the numerator; it is a quantity of resource-time rather than a rate, so it has no period</pm:note>
                </pm:absent>
              </pm:window>
            </pm:divisibility>
          </pm:divisibility>
          <pm:capacitySlack>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>a reserved card cannot be run above its rating at any price</pm:note>
            </pm:absent>
          </pm:capacitySlack>
          <pm:inventorySlack>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>a reserved card-hour not drawn is gone; there is nothing to build ahead</pm:note>
            </pm:absent>
          </pm:inventorySlack>
        </pm:nameplate>
        <pm:jagged>
          <pm:draw>
            <pm:claim>
              <pm:low>545</pm:low>
              <pm:mostLikely>545</pm:mostLikely>
              <pm:high>545</pm:high>
              <pm:unit>GPU-hour</pm:unit>
              <pm:narrowsWhen>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>there is no range here to tighten</pm:note>
                </pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
                <pm:absent>
                  <pm:reason>none</pm:reason>
                  <pm:note>a count of what was actually served. Nothing sets its edge and there is nobody to negotiate one</pm:note>
                </pm:absent>
              </pm:boundOrigin>
              <pm:provenance><pm:party>pt-member</pm:party>
                <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
              </pm:provenance>
              <pm:asOf>2026-08-31</pm:asOf>
            </pm:claim>
          </pm:draw>
          <pm:measurementBasis>
            <pm:absent>
              <pm:reason>notApplicable</pm:reason>
              <pm:note>uma quantidade física medida não tem base de mensuração contabilística</pm:note>
            </pm:absent>
          </pm:measurementBasis>
        </pm:jagged>
      </pm:supply>

      <pm:remainder>
        <pm:remainder>
          <pm:sign><pm:fit>clearance</pm:fit></pm:sign>
          <pm:absorber>
            <pm:term>
              <pm:taxonomy>urn:example:factory-physics:buffers</pm:taxonomy>
              <pm:value>capacity</pm:value>
            </pm:term>
          </pm:absorber>
          <pm:holder>
            <pm:holder>
              <pm:kind>booked</pm:kind>
              <pm:share>
                <pm:claim>
                  <pm:low>30</pm:low>
                  <pm:mostLikely>175</pm:mostLikely>
                  <pm:high>290</pm:high>
                  <pm:unit>GPU-hour</pm:unit>
                  <pm:narrowsWhen>
                    <pm:absent>
                      <pm:reason>unmeasured</pm:reason>
                      <pm:note>nobody has said what would tighten this range</pm:note>
                    </pm:absent>
                  </pm:narrowsWhen>
                  <pm:boundOrigin>
                    <pm:absent>
                      <pm:reason>none</pm:reason>
                      <pm:note>nothing sets this bound. It is how much of the remainder this holder was observed to take</pm:note>
                    </pm:absent>
                  </pm:boundOrigin>
                </pm:claim>
              </pm:share>
            </pm:holder>
          </pm:holder>
          <!-- derived: |720 - [430, 545, 690]| = [30, 175, 290] GPU-hour -->
          <pm:quantity>
            <pm:absent>
              <pm:reason>derived</pm:reason>
              <pm:note>computable from this layer's demand and nameplate; the receiver computes it</pm:note>
            </pm:absent>
          </pm:quantity>
        </pm:remainder>
      </pm:remainder>
    </pm:layer>

    <!-- ============================================================
         CAPACIDADE INSTALADA. A layer the sibling does not hold at all,
         and the one whose absorber cites a translated edition.
         ============================================================ -->
    <pm:layer>
      <pm:name>capacidade-instalada</pm:name>

      <pm:demand>
        <pm:claim>
          <pm:low>11</pm:low>
          <pm:mostLikely>12.5</pm:mostLikely>
          <pm:high>14</pm:high>
          <pm:unit>turnos por semana</pm:unit>
          <pm:narrowsWhen>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>nobody has said what would tighten this range</pm:note>
            </pm:absent>
          </pm:narrowsWhen>
          <pm:boundOrigin>
            <pm:absent>
              <pm:reason>none</pm:reason>
              <pm:note>nothing sets this bound. The range is where the observations fell, not where a rule put them, so there is no lever here to look for</pm:note>
            </pm:absent>
          </pm:boundOrigin>
          <pm:provenance><pm:party>pt-member</pm:party>
            <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason><pm:note>no standing vocabulary is published for this assertion</pm:note></pm:absent></pm:standing>
          </pm:provenance>
          <pm:asOf>2026-08-31</pm:asOf>
        </pm:claim>
      </pm:demand>
      <pm:timeSlack>
        <pm:absent>
          <pm:reason>unmeasured</pm:reason>
          <pm:note>a shift deferred is a shift run later; how far it can slip before the order is lost is unmeasured</pm:note>
        </pm:absent>
      </pm:timeSlack>

      <pm:supply>
        <pm:label>a linha de embalamento</pm:label>
        <pm:nameplate>
          <pm:amount>
            <pm:claim>
              <pm:low>10</pm:low>
              <pm:mostLikely>10</pm:mostLikely>
              <pm:high>10</pm:high>
              <pm:unit>turnos por semana</pm:unit>
              <pm:narrowsWhen>
                <pm:absent>
                  <pm:reason>notApplicable</pm:reason>
                  <pm:note>there is no range here to tighten</pm:note>
                </pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
                <pm:absent>
                  <pm:reason>derived</pm:reason>
                  <pm:note>`Nameplate/amountOrigin` says who could have held a different number of these, one element over. Reading the same fact twice is how the two come to disagree</pm:note>
                </pm:absent>
              </pm:boundOrigin>
            </pm:claim>
          </pm:amount>
          <pm:amountOrigin><pm:origin>policy</pm:origin></pm:amountOrigin>
          <pm:divisibility>
            <pm:divisibility>
              <pm:lumpy>
                <pm:size>
                  <pm:claim>
                    <pm:low>1</pm:low>
                    <pm:mostLikely>1</pm:mostLikely>
                    <pm:high>1</pm:high>
                    <pm:unit>turnos por semana</pm:unit>
                    <pm:narrowsWhen>
                      <pm:absent>
                        <pm:reason>notApplicable</pm:reason>
                        <pm:note>there is no range here to tighten</pm:note>
                      </pm:absent>
                    </pm:narrowsWhen>
                    <pm:boundOrigin>
                      <pm:absent>
                        <pm:reason>derived</pm:reason>
                        <pm:note>`LumpyQuantum/origin` says who sets the size of one unit, in this same element</pm:note>
                      </pm:absent>
                    </pm:boundOrigin>
                  </pm:claim>
                </pm:size>
                <pm:origin>intrinsic</pm:origin>
              </pm:lumpy>
              <pm:window>
                <pm:absent>
                  <pm:reason>unmeasured</pm:reason>
                  <pm:note>`turnos por semana` has a period and nobody has said which days of it the packing line runs</pm:note>
                </pm:absent>
              </pm:window>
            </pm:divisibility>
          </pm:divisibility>
          <pm:capacitySlack>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>the line can be run above its rated shifts; nobody has measured how far before it breaks</pm:note>
            </pm:absent>
          </pm:capacitySlack>
          <pm:inventorySlack>
            <pm:absent>
              <pm:reason>unmeasured</pm:reason>
              <pm:note>output can be run ahead into stock; nobody has counted how much the floor holds</pm:note>
            </pm:absent>
          </pm:inventorySlack>
        </pm:nameplate>
        <pm:jagged>
          <pm:draw>
            <pm:claim>
              <pm:low>10</pm:low>
              <pm:mostLikely>10</pm:mostLikely>
              <pm:high>10</pm:high>
              <pm:unit>turnos por semana</pm:unit>
              <pm:narrowsWhen>
