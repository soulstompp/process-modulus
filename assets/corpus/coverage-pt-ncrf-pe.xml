<?xml version="1.0" encoding="UTF-8"?>
<!--
  ⭐⭐ THE SAME QUESTIONS, ANSWERED UNDER A SECOND REGIME, and this file is the whole
  argument for the format. It answers the identical keys as coverage-us-gaap.xml, so
  the two are comparable ROW BY ROW, and where they differ the difference is a
  finding rather than an incompatibility.

  Two things to read closely:

    * ⭐ THE REFUSAL CODES ARE THE SAME PACK. A coding pack of reasons ("there is no
      position", "this needs a measurement basis") is not owned by a country, and
      two witnesses citing the SAME taxonomy are directly comparable. That is what
      the base schema's BorrowedTerm buys: it does not force a fork, it makes one
      VISIBLE when it happens.

    * ⛔ THE CHART POSITIONS ARE NOT AND CANNOT BE. Portugal has a national chart
      under SNC; the United States has none, so its witness cites the entity's own.
      `6250` in one and `62xx` in the other are unrelated strings. A model that
      stored a position as a bare code would have silently compared them.

  ⛔ AND IT DECLARES TWO REGIMES, because the same small entity is `NCRF-PE` to IES's
  AnexoASNC and `S` to the SAF-T referencial, and `S` also covers full `NCRF`, so
  the SAF-T code cannot be mapped back. Neither declaration says what the pair says.

  ⚠️ Illustrative. Taxonomy URIs and account codes are placeholders.
-->
<asrt:coverage xmlns:asrt="https://example.invalid/assertion/1.0"
               xmlns:pm="https://example.invalid/process-flow/1.0">

  <asrt:witness>snc-port</asrt:witness>

  <asrt:regime>
    <pm:id>ies-anexo-asnc</pm:id>
    <pm:jurisdiction>PT</pm:jurisdiction>
    <pm:framework>
      <pm:term>
        <pm:taxonomy>urn:example:pt:ies:anexo-asnc</pm:taxonomy>
        <pm:value>NCRF-PE</pm:value>
      </pm:term>
    </pm:framework>
    <!-- ⭐ The national SNC chart, which both codings below share. -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:pt:snc:chart</pm:taxonomy>
        <pm:value>SNC</pm:value>
      </pm:term>
    </pm:chart>
  </asrt:regime>

  <asrt:regime>
    <pm:id>saft-referencial</pm:id>
    <pm:jurisdiction>PT</pm:jurisdiction>
    <pm:framework>
      <pm:term>
        <pm:taxonomy>urn:example:pt:saft:referencial</pm:taxonomy>
        <pm:value>S</pm:value>
      </pm:term>
    </pm:framework>
    <!-- ⭐ Same chart, different framework coding. Two axes, not one. -->
    <pm:chart>
      <pm:term>
        <pm:taxonomy>urn:example:pt:snc:chart</pm:taxonomy>
        <pm:value>SNC</pm:value>
      </pm:term>
    </pm:chart>
    <pm:note>The coarser coding: S covers both NCRF and NCRF-PE, so this code cannot
             be mapped back to a single AnexoASNC value.</pm:note>
  </asrt:regime>

  <!-- ⭐ AGREES WITH THE US WITNESS, IN THE SAME WORDS, FROM THE SAME PACK. Two
       accounting regimes reaching one refusal is the strongest thing the corpus can
       produce, and it is only legible because both cite the pack. -->
  <asrt:entry>
    <asrt:key>labor.absorbed-evening</asrt:key>
    <asrt:complete>true</asrt:complete>
    <asrt:answer>
      <asrt:refuses>
        <pm:taxonomy>urn:example:coding-pack:refusals</pm:taxonomy>
        <pm:value>not-a-financial-fact</pm:value>
      </asrt:refuses>
    </asrt:answer>
  </asrt:entry>

  <!-- ⛔ SAME ANSWER KIND, INCOMPARABLE VALUE. Both witnesses say "it has a
       position"; the positions are from different charts and nothing maps them. -->
  <asrt:entry>
    <asrt:key>compute.reserved-block-idle</asrt:key>
    <asrt:complete>true</asrt:complete>
    <asrt:answer>
      <asrt:holds>
        <pm:taxonomy>urn:example:pt:snc:chart</pm:taxonomy>
        <pm:value>6226</pm:value>
      </asrt:holds>
    </asrt:answer>
  </asrt:entry>

  <!-- ⭐⭐ AND HERE THE TWO REGIMES DIVERGE, WHICH IS THE FINDING THE CORPUS EXISTS
       TO PRODUCE. The reason is declared, so it is a position rather than a bug. -->
  <asrt:entry>
    <asrt:key>offering.enterprise-obligation</asrt:key>
    <asrt:complete>true</asrt:complete>
    <asrt:answer>
      <asrt:refuses>
        <pm:taxonomy>urn:example:coding-pack:refusals</pm:taxonomy>
        <pm:value>needs-a-measurement-basis</pm:value>
      </asrt:refuses>
    </asrt:answer>
    <asrt:exception>The US witness refuses this for a missing CONDITION; a small
                    entity under NCRF-PE reaches the same refusal one step earlier,
                    for a missing measurement basis, because the reduced framework
                    has fewer bases available to it. Same question, same pack, two
                    codes, and the pair says more than either.</asrt:exception>
    <asrt:citation>
      <asrt:instrument>
        <pm:taxonomy>urn:example:pt:ies:anexo-asnc</pm:taxonomy>
        <pm:value>NCRF-PE</pm:value>
      </asrt:instrument>
      <asrt:clause>§4</asrt:clause>
    </asrt:citation>
  </asrt:entry>

  <asrt:entry>
    <asrt:key>capability.backlog</asrt:key>
    <asrt:complete>false</asrt:complete>
    <asrt:answer>
      <asrt:cannotAsk/>
    </asrt:answer>
  </asrt:entry>

</asrt:coverage>
