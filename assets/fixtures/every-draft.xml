<?xml version="1.0" encoding="UTF-8"?>
<!--
  ⛔⛔⛔ A STIPULATION, NOT A FILING. See assets/fixtures/README.md.

  ⭐⭐⭐ THE DOCUMENT A FIRST-TIME ADOPTER ACTUALLY HAS, and the two states every other document
  in this repository skips because every other one was written to be cited by another.

    notation  absent unmeasured   nobody has assigned this filing a URN yet
    scope     absent unmeasured   the question of how much of the system it holds was never put

  ⚠️ NEITHER IS A DEFECT AND BOTH WOULD BE A BLANK WITHOUT THEIR WRAPPERS. Somebody sat down,
  wrote one layer of their process, and stopped. They have not published it, so nothing can
  compose it — and that is the honest consequence rather than a gap: a composition asserting a
  relationship to a filing nobody can identify is asserting a relationship to nothing.

  ⭐ AND THE SCOPE ABSENCE IS THE ONE WORTH READING TWICE. `unbounded` says the filer thought
  about what lies outside these layers and did not look. `absent reason="unmeasured"` says the
  question was never put at all. A first draft is the second, and rendering them identically is
  what made `pm:Stack` read as though it enumerated a system.
-->
<pm:processModulus xmlns:pm="https://example.invalid/process-flow/1.0">

  <pm:notation>
    <pm:absent>
      <pm:reason>unmeasured</pm:reason>
      <pm:note>stipulated: a working document. It will be published under an identifier and
               nobody has assigned one, so nothing can compose it yet</pm:note>
    </pm:absent>
  </pm:notation>
  <pm:evidence>
    <pm:absent>
      <pm:reason>unmeasured</pm:reason>
      <pm:note>this document does not say whether anything in it was observed. That is the state every document written before pm:evidence existed is in, and a receiver must put it in neither set</pm:note>
    </pm:absent>
  </pm:evidence>

  <pm:stack>
    <pm:scope>
      <pm:absent>
        <pm:reason>unmeasured</pm:reason>
        <pm:note>stipulated: one layer was written down and nobody has asked what else of this
                 system would be a layer. Not `unbounded` — that would say the filer looked
                 outside and stopped, and this filer never put the question</pm:note>
      </pm:absent>
    </pm:scope>

    <pm:layer>
      <pm:name>press</pm:name>
      <pm:demand>
        <pm:amount>
          <pm:claim>
            <pm:low>110</pm:low><pm:mostLikely>140</pm:mostLikely><pm:high>190</pm:high>
            <pm:unit>reams per shift</pm:unit>
            <pm:denominator>
              <pm:absent>
                <pm:reason>unmeasured</pm:reason>
                <pm:note>the unit came across from the old format and nobody has said what sits under its line. A first-time adopter is in this state, and a receiver must not read the token to get out of it</pm:note>
              </pm:absent>
            </pm:denominator>
            <pm:narrowsWhen>
              <pm:absent><pm:reason>unmeasured</pm:reason>
                <pm:note>stipulated: nobody has said what would tighten this</pm:note></pm:absent>
            </pm:narrowsWhen>
            <pm:boundOrigin>
              <pm:absent><pm:reason>none</pm:reason>
                <pm:note>stipulated: nothing sets this bound</pm:note></pm:absent>
            </pm:boundOrigin>
          </pm:claim>
        </pm:amount>
        <pm:patience>
          <pm:absent>
            <pm:reason>unmeasured</pm:reason>
          </pm:absent>
        </pm:patience>
      </pm:demand>
      <pm:timeSlack>
        <pm:absent><pm:reason>unmeasured</pm:reason><pm:note>stipulated</pm:note></pm:absent>
      </pm:timeSlack>
      <pm:supply>
        <pm:label>the guillotine</pm:label>
        <pm:nameplate>
          <pm:amount>
            <pm:claim>
              <pm:low>150</pm:low><pm:mostLikely>150</pm:mostLikely><pm:high>150</pm:high>
              <pm:unit>reams per shift</pm:unit>
              <pm:denominator>
                <pm:period>shift</pm:period>
              </pm:denominator>
              <pm:narrowsWhen>
                <pm:absent><pm:reason>notApplicable</pm:reason>
                  <pm:note>there is no range here to tighten</pm:note></pm:absent>
              </pm:narrowsWhen>
              <pm:boundOrigin>
                <pm:derivation><pm:identity>amountOrigin</pm:identity>
                  <pm:note>amountOrigin below states it</pm:note></pm:derivation>
              </pm:boundOrigin>
            </pm:claim>
          </pm:amount>
          <pm:amountOrigin><pm:origin>policy</pm:origin></pm:amountOrigin>
          <pm:divisibility>
            <pm:divisibility>
              <pm:lumpy>
                <pm:size>
                  <pm:claim>
                    <pm:low>5</pm:low><pm:mostLikely>5</pm:mostLikely><pm:high>5</pm:high>
                    <pm:unit>reams per shift</pm:unit>
                    <pm:denominator>
                      <pm:period>shift</pm:period>
                    </pm:denominator>
                    <pm:narrowsWhen>
                      <pm:absent><pm:reason>notApplicable</pm:reason>
                        <pm:note>there is no range here to tighten</pm:note></pm:absent>
                    </pm:narrowsWhen>
                    <pm:boundOrigin>
                      <pm:derivation><pm:identity>quantumOrigin</pm:identity>
                        <pm:note>the origin below states it</pm:note></pm:derivation>
                    </pm:boundOrigin>
                  </pm:claim>
                </pm:size>
                <pm:origin>intrinsic</pm:origin>
              </pm:lumpy>
              <pm:window>
                <pm:quantum>
                  <pm:size>
                    <pm:claim>
                      <pm:low>1</pm:low><pm:mostLikely>1</pm:mostLikely><pm:high>1</pm:high>
                      <pm:unit>shift</pm:unit>
                      <pm:denominator>
                        <pm:absent><pm:reason>notApplicable</pm:reason></pm:absent>
                      </pm:denominator>
                      <pm:narrowsWhen>
                        <pm:absent><pm:reason>notApplicable</pm:reason><pm:note>there is no range here to tighten</pm:note></pm:absent>
                      </pm:narrowsWhen>
                      <pm:boundOrigin>
                        <pm:derivation><pm:identity>quantumOrigin</pm:identity><pm:note>`LumpyQuantum/origin` says who sets this window, in this same element</pm:note></pm:derivation>
                      </pm:boundOrigin>
                    </pm:claim>
                  </pm:size>
                  <!-- stipulated: the line runs every hour of the period, so the window is the whole of it -->
                  <pm:origin>policy</pm:origin>
                </pm:quantum>
              </pm:window>
            </pm:divisibility>
          </pm:divisibility>
          <pm:capacitySlack>
            <pm:absent><pm:reason>unmeasured</pm:reason><pm:note>stipulated</pm:note></pm:absent>
          </pm:capacitySlack>
          <pm:inventorySlack>
            <pm:claim>
              <pm:low>0</pm:low><pm:mostLikely>0</pm:mostLikely><pm:high>0</pm:high>
              <pm:unit>reams per shift</pm:unit>
              <pm:denominator>
                <pm:period>shift</pm:period>
              </pm:denominator>
              <!-- ⭐ A POINT HAS NO WIDTH TO TIGHTEN, AND notApplicable IS THE SETTLED ANSWER. -->
              <pm:narrowsWhen><pm:absent><pm:reason>notApplicable</pm:reason></pm:absent></pm:narrowsWhen>
              <pm:boundOrigin><pm:origin>intrinsic</pm:origin></pm:boundOrigin>
              <pm:provenance>
                <pm:standing><pm:absent><pm:reason>unmeasured</pm:reason></pm:absent></pm:standing>
                <pm:note>stipulated: nothing keeps until next week</pm:note>
              </pm:provenance>
            </pm:claim>
          </pm:inventorySlack>
        </pm:nameplate>
        <pm:jagged>
          <pm:draw>
            <pm:absent><pm:reason>unmeasured</pm:reason><pm:note>stipulated</pm:note></pm:absent>
          </pm:draw>
          <pm:measurementBasis>
            <pm:absent><pm:reason>notApplicable</pm:reason>
              <pm:note>there is no valuation here to have a basis</pm:note></pm:absent>
          </pm:measurementBasis>
        </pm:jagged>
      </pm:supply>
      <pm:remainder>
        <pm:remainder>
          <pm:sign><pm:fit>transition</pm:fit></pm:sign>
          <pm:absorber>
            <pm:term>
              <pm:taxonomy>urn:example:factory-physics:buffers</pm:taxonomy>
              <pm:value>capacity</pm:value>
            </pm:term>
          </pm:absorber>
          <pm:holder>
            <pm:holder>
              <pm:kind>customer</pm:kind>
              <pm:share>
                <pm:absent><pm:reason>unmeasured</pm:reason><pm:note>stipulated</pm:note></pm:absent>
              </pm:share>
            </pm:holder>
          </pm:holder>
          <pm:quantity>
            <pm:derivation><pm:identity>magnitude</pm:identity>
              <pm:note>computable from this layer's demand and nameplate</pm:note></pm:derivation>
          </pm:quantity>
        </pm:remainder>
      </pm:remainder>
    </pm:layer>

    <pm:couplings>
      <pm:absent>
        <pm:reason>notApplicable</pm:reason>
        <pm:note>stipulated: a one-layer stack has no pair to couple</pm:note>
      </pm:absent>
    </pm:couplings>
  </pm:stack>
</pm:processModulus>
