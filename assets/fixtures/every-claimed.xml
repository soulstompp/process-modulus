<?xml version="1.0" encoding="UTF-8"?>
<!--
  A stipulation, not a filing. See assets/fixtures/README.md. This is not a real witness: it
  answers for no framework, and its answers are never to be compared with the two real
  coverage documents in assets/corpus/.

  It exists for one value, `claimed` set to `partial`, which no honest witness in the corpus
  is in. Both real witnesses either code a position, return a typed refusal, which is a
  complete answer under a framework, or say the question is not theirs. None of those is
  partial.

  Why this cannot go in the corpus: a coverage entry is a witness's own claim about what its
  framework does. Writing `partial` into `coverage-us-gaap.xml` would put words in US GAAP's
  mouth to reach a branch, which is the failure `Verdict/diverged` exists to name: a corpus
  that agrees with the schema by construction measures nothing. Here the witness is openly
  invented and claims nothing about anybody.

  What a partial answer looks like, and why it is the most telling state a witness can be in
  for this corpus. Ask a framework where an evening of absorbed engineering time sits. It has
  a position for the half a contractor invoiced and no position for the half a salaried
  person absorbed: the same physical excess, one half coded and the other not. `full` would
  claim the question is answered; `none` would claim it is not the witness's subject. Both
  are false, and the gap between them is what this whole model is about.
-->
<asrt:coverage xmlns:asrt="https://example.invalid/assertion/1.0"
               xmlns:pm="https://example.invalid/process-flow/1.0">

  <asrt:witness>fixture-partial</asrt:witness>
  <asrt:evidence>
    <pm:attests>stipulation</pm:attests>
  </asrt:evidence>

  <!-- No regime. `Coverage/regime` is optional, and leaving it out is a real state: a witness
       that is not an accounting model reports under no framework and is not made to invent
       one. A fixture is exactly that witness. -->

  <!-- `partial`: half the quantity has a position and half does not, so the witness answers
       part of the question and says which part. -->
  <asrt:entry>
    <asrt:key>labor.absorbed-evening</asrt:key>
    <asrt:claimed>partial</asrt:claimed>
    <asrt:answer>
      <asrt:holds>
        <pm:taxonomy>urn:example:fixture:chart</pm:taxonomy>
        <pm:value>6110</pm:value>
      </asrt:holds>
    </asrt:answer>
    <asrt:exception>Stipulated. The contracted portion of the evening is invoiced and has a
                    position; the absorbed portion has no counterparty and therefore no
                    entry, and this witness has nothing to say about it. Coding the first
                    half and calling the question answered is the error `partial` exists to
                    make visible.</asrt:exception>
  </asrt:entry>

  <!-- A partial claim may also be answered by a refusal, and the two are different documents.
       Here the witness reaches a typed refusal for part of the question and holds no opinion
       about the rest, which is neither a complete refusal nor a complete answer. -->
  <asrt:entry>
    <asrt:key>offering.enterprise-obligation</asrt:key>
    <asrt:claimed>partial</asrt:claimed>
    <asrt:answer>
      <asrt:refuses>
        <pm:taxonomy>urn:example:coding-pack:refusals</pm:taxonomy>
        <pm:value>needs-a-condition</pm:value>
      </asrt:refuses>
    </asrt:answer>
    <asrt:exception>Stipulated. The revenue half of the obligation is refused for a missing
                    condition; the capacity the obligation commits is not a financial fact at
                    all and this witness has no verdict on it.</asrt:exception>
  </asrt:entry>

  <!-- The two states the corpus does reach, present so that a reader of this file sees all
       three side by side rather than having to hold two documents at once. -->
  <asrt:entry>
    <asrt:key>compute.reserved-block-idle</asrt:key>
    <asrt:claimed>full</asrt:claimed>
    <asrt:answer>
      <asrt:holds>
        <pm:taxonomy>urn:example:fixture:chart</pm:taxonomy>
        <pm:value>6250</pm:value>
      </asrt:holds>
    </asrt:answer>
  </asrt:entry>

  <asrt:entry>
    <asrt:key>capability.backlog</asrt:key>
    <asrt:claimed>none</asrt:claimed>
    <asrt:answer>
      <asrt:cannotAsk/>
    </asrt:answer>
  </asrt:entry>

</asrt:coverage>
